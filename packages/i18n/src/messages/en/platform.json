      "description": "Recalculate daily aggregates for a range of days — after a fix in the ingest or late events.",
      "title": "Rebuild analytics aggregates"
    },
    "analyticsUserForget": {
      "description": "Erase the person’s raw usage events, device links and personal aggregates. Anonymous totals stay.",
      "title": "Forget a person’s usage analytics"
    },
