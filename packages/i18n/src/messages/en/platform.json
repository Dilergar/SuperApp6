      "description": "Four-eyes: high-risk commands go through a second staff member’s approval",
      "title": "Change the console policy"
    },
    "platformStaffAdd": {
      "description": "Adds a person to the platform staff; without a role they see nothing",
      "title": "Add a staff member"
