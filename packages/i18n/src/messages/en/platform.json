    },
    "entitlementsGrantRevoke": {
      "title": "Revoke a grant"
    },
    "entitlementsOverrideClear": {
      "title": "Remove an individual term"
    },
    "entitlementsOverrideSet": {
      "description": "Overrides the final value of one key for the subject until the given date; reason is mandatory",
      "title": "Set an individual term"
    },
    "entitlementsPlanArchiveVersion": {
      "title": "Archive a plan version"
    },
    "entitlementsPlanCreateVersion": {
      "description": "Copies the latest version of the plan into an editable draft",
      "title": "New plan draft"
    },
    "entitlementsPlanPublishVersion": {
      "description": "The version becomes immutable; subscribers of the plan get its values on the next read",
      "title": "Publish a plan version"
    },
    "entitlementsPlanUpdateDraft": {
      "title": "Edit a plan draft"
    },
    "entitlementsSubscriptionSet": {
      "description": "Pins the subject to a published version of a plan; no version — the subject falls to the free plan",
      "title": "Set a subscription"
    },
    "entitlementsTrialExtend": {
      "title": "Extend a trial"
    },
