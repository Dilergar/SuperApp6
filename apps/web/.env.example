# Все три инлайнятся Next'ом на СБОРКЕ — смена значения = пересборка (docs/environment_variables.md, «Web»).

# База API С версией (канонический префикс /api/v1); пусто → http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# ТОЛЬКО сужение connect-src в CSP (next.config.ts); адрес LiveKit веб получает от API в рантайме. Пусто → "ws: wss:"
NEXT_PUBLIC_LIVEKIT_WS_URL=""
# ТОЛЬКО сужение frame-src/form-action в CSP; адрес редактора документов тоже приходит от API. Пусто → "http: https:"
NEXT_PUBLIC_DOCS_EDITOR_URL=""
