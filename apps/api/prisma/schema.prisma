generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Пул приложения — PgBouncer (режим транзакций); миграции — мимо него (docs/data_architecture.md)
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE: Users & Auth
// ============================================================

model User {
  id                   String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phone                String    @unique
  // ---- ПДн под движком ключей (core/keys, фаза D): envelope `_enc` (KEK человека, AAD)
  // + слепой индекс `_bi` там, где ищут по равенству. Открытые колонки живут до окна
  // dual-write (KEYS_PII_READ_MODE) и удаляются отдельной миграцией — docs/keys_pii.md.
  phoneEnc             String?   @map("phone_enc")
  // Слепой индекс живёт в ДВУХ колонках-слотах (`_bi` — слот 0, `_bi_alt` — слот 1): каждая версия
  // ключа `blind_index` пишет в свой слот, смена ключа переключает поиск на другой слот без окна
  // простоя и без потери уникальности (docs/keys_engine.md). Вне окна смены второй слот пуст.
  phoneBi              String?   @unique @map("phone_bi")
  phoneBiAlt           String?   @unique @map("phone_bi_alt")
  password             String // bcrypt hash
  firstName            String    @map("first_name")
  lastName             String?   @map("last_name")
  // Отчество — реквизит документов (приказы/договоры печатают полное ФИО);
  // в продуктовых карточках не показывается (там имя+фамилия)
  middleName           String?   @map("middle_name")
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  dateOfBirthEnc       String?   @map("date_of_birth_enc")
  avatar               String?
  bio                  String?
  city                 String?
  email                String?   @unique
  emailEnc             String?   @map("email_enc")
  emailBi              String?   @unique @map("email_bi")
  emailBiAlt           String?   @unique @map("email_bi_alt")
  maritalStatus        String?   @map("marital_status")
  socialLinks          Json?     @map("social_links")
  // Находимость по номеру (core/visibility, ось отдельная от видимости полей — решение грилла №9):
  // everybody | circle | nobody. Один страж на ВСЕ пути, принимающие номер
  // (`VisibilityDiscoverabilityService.assertDiscoverable`); «не найден» неотличим от «скрыт».
  discoverableBy       String    @default("everybody") @map("discoverable_by")
  // Момент подтверждения владения номером SMS-кодом (движок core/verify).
  // null = номер не подтверждён (в production такой аккаунт создать нельзя —
  // register требует verifyToken). Наружу в DTO уходит isVerified = !!phoneVerifiedAt.
  phoneVerifiedAt      DateTime? @map("phone_verified_at")
  // Поколение токенов: попадает в payload JWT и сверяется в JwtStrategy. Инкремент
  // = МГНОВЕННЫЙ отзыв всех выданных access-токенов. Без него «отозвали все сессии»
  // (сброс/смена пароля, смена номера, logout-all) удаляло только строки session, а
  // украденный access-токен продолжал работать до 15 минут — ровно те минуты, ради
  // которых сброс пароля и делают.
  tokenEpoch           Int       @default(0) @map("token_epoch")
  // Язык интерфейса (BCP-47, SUPPORTED_LOCALES из @superapp/shared). Дефолт колонки —
  // язык РЫНКА (казахский, RegionProfile.defaultLocale), а не DEFAULT_LOCALE (английский):
  // это страховка для строк, созданных не регистрацией, и продукт сделан для Казахстана.
  // Живое значение ставит регистрация из Accept-Language (negotiateLocale: kk и ru → kk,
  // прочее → en), дальше — тумблером в профиле.
  locale               String    @default("kk")
  // Пояс для текстов, которые уходят ВНЕ приложения (push, SMS, почта): на вебе
  // время показывается в поясе устройства, серверу же нужен явный.
  timezone             String    @default("Asia/Almaty")
  // Отказ от аналитики использования (core/analytics): применяется НА СЕРВЕРЕ при приёме —
  // product/telemetry-события не пишутся, business-факты сервера пишутся всегда.
  analyticsOptOut      Boolean   @default(false) @map("analytics_opt_out")
  // Эпоха согласий человека (core/consents): глобальная эпоха, ДО которой включительно у него
  // принято всё обязательное. Шлюз сравнивает её с глобальной без ввода-вывода: значение едет
  // в кэше «аккаунт жив» рядом с tokenEpoch. Отстаёт от глобальной → ленивая перепроверка.
  consentEpoch         Int       @default(0) @map("consent_epoch")
  // person | bot. Бот (core/keys) — теневая строка users: все FK, хроника, уведомления и
  // проекции core/access работают без переписывания; вход, SMS и роли системы боту закрыты.
  // Клиент рисует `kind: 'bot'` бот-чипом, а не PersonChip. Телефон бота — `bot:<id>`.
  kind                 String    @default("person")
  // ---- core/audit: защита входа и заморозка ----
  // Блокировка входа после серии неверных паролей (5 → 15 мин, удвоение до суток); счётчик
  // неудач — в Redis, колонка — правда для входа (Redis мог потерять ключ).
  loginLockedUntil     DateTime? @map("login_locked_until")
  // Экстренная заморозка (self — сам человек без входа /freeze; platform — команда Кабинета):
  // вход, сессии и ключи API закрыты; сброс пароля по SMS заморозку НЕ снимает (против угона
  // SIM), разморозка = старый пароль + SMS или команда Кабинета с проверкой личности.
  securityFrozenAt     DateTime? @map("security_frozen_at")
  securityFrozenReason String?   @map("security_frozen_reason")
  // Автозавершение неактивных сессий (дни): 7 | 30 | 90 | 180
  sessionMaxIdleDays   Int       @default(90) @map("session_max_idle_days")

  // ---- Реквизиты («Моя Анкета» → «Для договоров и трудоустройства») ----
  // Служебные поля организации: кто их видит — правила видимости (core/visibility,
  // `staff.member`; владельцу и админу — маска с раскрытием), сам человек — всегда.
  // В личном окружении (Группы) НЕ показываются вовсе.
  iin                   String? // 12 цифр, контрольная сумма проверяется схемой
  iinEnc                String?   @map("iin_enc")
  iinBi                 String?   @map("iin_bi")
  iinBiAlt              String?   @map("iin_bi_alt")
  residentialAddress    String?   @map("residential_address")
  residentialAddressEnc String?   @map("residential_address_enc")
  idDocNumber           String?   @map("id_doc_number") // удостоверение личности
  idDocNumberEnc        String?   @map("id_doc_number_enc")
  idDocIssuedBy         String?   @map("id_doc_issued_by")
  idDocIssuedByEnc      String?   @map("id_doc_issued_by_enc")
  idDocIssuedAt         DateTime? @map("id_doc_issued_at") @db.Date

  // Card skins (cosmetic): the equipped default skin instance. Plain id; ownership
  // validated in service. «Премиум» (скин на каждую Группу) — ключ `skins.perGroup`
  // движка core/entitlements (грант/подписка), а не поле здесь.
  defaultSkinInstanceId String? @map("default_skin_instance_id") @db.Uuid

  // Soft-deletion in two stages:
  //   deletionScheduledAt — user requested deletion; account is in a recoverable
  //     grace window (logging in restores it). Login via token is blocked.
  //   deletedAt — set by the cron once the grace window elapses; the account is
  //     permanently anonymized (PII scrubbed, phone freed) and login blocked forever.
  // The row is kept so collaborative content (tasks/comments/workspaces) survives.
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")
  deletedAt           DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sessions           Session[]
  devices            UserDevice[]
  roles              UserRole[]
  ownedCircles       Circle[]
  createdTasks       Task[]            @relation("TaskCreator")
  taskParticipations TaskParticipant[] @relation("TaskParticipantUser")
  calendarEvents     CalendarEvent[]
  resources          Resource[]
  googleConnection   GoogleConnection?
  workspaceMembers   WorkspaceMember[]
  ownedWorkspaces    Workspace[]
  staffAssignments   StaffAssignment[]
  staffDeputies      StaffDeputy[]     @relation("DeputyUser")
  paymentCards       UserPaymentCard[]

  // Workspace hiring invitations (separate from ContactInvitation — different semantics)
  workspaceInvitationsSent     WorkspaceInvitation[] @relation("WsInvitationInviter")
  workspaceInvitationsReceived WorkspaceInvitation[] @relation("WsInvitationRecipient")

  // Contacts / Circles / Invitations
  contactLinksA       ContactLink[]       @relation("ContactLinkUserA")
  contactLinksB       ContactLink[]       @relation("ContactLinkUserB")
  sentInvitations     ContactInvitation[] @relation("InvitationSender")
  receivedInvitations ContactInvitation[] @relation("InvitationRecipient")

  // Blocks (unidirectional — A blocking B does not imply B blocking A)
  blocksMade     ContactBlock[] @relation("ContactBlockBlocker")
  blocksReceived ContactBlock[] @relation("ContactBlockBlocked")

  // Notifications (core/notifications)
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  notificationSubscriptions NotificationSubscription[]
  notificationDevices       NotificationDevice[]
  notificationSettings      UserNotificationSettings?

  // Messenger
  chatMemberships  ChatMember[]
  authoredMessages Message[]

  scheduledMessages ScheduledMessage[]
  bot               Bot?

  @@index([iinBi])
  @@index([iinBiAlt])
  @@index([kind])
  @@map("users")
}

// ============================================================
// UNIVERSAL IDENTITY: Роли привязаны к контексту, не к пользователю
// Один user_id → много ролей в разных контекстах (system, workspace, circle)
// Пример: user A = ADMIN в system, STAFF в workspace X, GUEST в workspace Y
// ============================================================

model UserRole {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String // user, admin, moderator, owner, staff, manager, member, guest
  context   String // "system", "workspace", "circle"
  tenantId  String?  @map("tenant_id") @db.Uuid // null для system-ролей, workspace_id или circle_id для контекстных
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") // кто выдал роль (user_id)
  isActive  Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, context, tenantId]) // leading userId also serves plain userId lookups
  @@index([tenantId])
  @@index([userId, context])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  token        String    @unique // refresh token hash
  deviceInfo   String?   @map("device_info")
  // Последняя активность СЕМЕЙСТВА (core/audit): обновляется не чаще раза в 5 минут
  // (дедуп в Redis `sess:seen:<family>`), на всех строках семейства сразу — «активно 5 мин
  // назад» и автозавершение неактивных читают голову семейства.
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Семейство refresh-цепочки одного устройства (RFC 9700 §2.2.2): вход = новое
  // семейство, ротация наследует. Прокрученная строка НЕ удаляется — помечается
  // rotatedAt/replacedById; её повторное предъявление вне grace 10 с = утечка →
  // всё семейство отзывается (core/keys, docs/keys_engine.md).
  familyId     String    @default(uuid()) @map("family_id") @db.Uuid
  rotatedAt    DateTime? @map("rotated_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid

  // ---- core/audit: сессия как объект для человека ----
  // «Сессия» для человека = СЕМЕЙСТВО (строка ротируется на каждом refresh): все поля ниже
  // наследуются `mintSession` от прокрученной строки. Полного IP здесь нет (человеку он не
  // показывается; платформа найдёт его по `actor_family_id` события входа).
  /// Клиентский id устройства (`X-Device-Id`; веб — localStorage, mobile — secure store)
  deviceId        String?   @map("device_id") @db.Uuid
  /// «Chrome · Windows» — для клиента без `X-Device-Id` (старый клиент, curl)
  uaFamily        String?   @map("ua_family")
  /// Сеть /24 (/48) входа
  ipNet           String?   @map("ip_net")
  country         String?   @db.Char(2)
  /// web | mobile_web | mobile | api_key | console
  client          String?
  /// Начало семейства — это и есть «вход» для человека
  familyCreatedAt DateTime  @default(now()) @map("family_created_at")
  /// Мягкий отзыв: строки не удаляются (улика reuse и «кто отозвал» переживают выход).
  /// Помечаются ВСЕ строки семейства. Причина — `SESSION_REVOKE_REASONS`.
  revokedAt       DateTime? @map("revoked_at")
  revokedReason   String?   @map("revoked_reason")
  /// Cooling: новая сессия до подтверждения (step-up) либо до `familyCreatedAt + 24 ч` не
  /// гасит чужой доступ. У семейства регистрации и первого устройства аккаунта — сразу.
  confirmedAt     DateTime? @map("confirmed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  /// Список «Устройства и сессии» человека (свежие семейства сверху)
  @@index([userId, familyCreatedAt(sort: Desc)])
  // Партиальный индекс голов семейств `(last_seen_at) WHERE revoked_at IS NULL AND
  // rotated_at IS NULL` (автозавершение неактивных) — руками в миграции core_audit.
  // Раннер purge (core/lifecycle): отозванные старше 90 дней — индекс ведёт колонкой времени
  @@index([revokedAt])
  @@map("sessions")
}

// Подписки живут в core/entitlements (`SubjectSubscription` ниже): субъект —
// человек ИЛИ организация, значения — версиями плана, а не колонкой plan.

// ============================================================
// CONTACTS & CIRCLES: Bilateral confirmed social graph
// ============================================================
// Architecture:
//   ContactLink       — a confirmed bilateral connection between two registered users
//                       (canonical ordering: userAId < userBId to keep unique constraint symmetric)
//                       Deleting a link is bilateral — the row is removed for both sides.
//   ContactInvitation — a pending request from one user to another (or to an unregistered phone).
//                       On acceptance, a ContactLink row is created and this row is marked accepted.
//                       External invitations (toUserId=null) auto-activate when the phone registers.
//   ContactBlock      — unidirectional block. A blocking B prevents B from inviting A again.
//   Circle            — an owner-local grouping (folder) of their confirmed contacts ("Семья", "Работа").
//                       A Circle belongs to one owner and contains ContactLinks via CircleMembership.
//   CircleMembership  — M2M join row: a ContactLink placed into a Circle by its owner.
//                       The SAME ContactLink can live in Circles owned by BOTH sides independently.
//
// Labels (roles like "жена", "друг") live on ContactLink as labelAForB / labelBForA —
// asymmetric so each side names the other how they want.
// Что видит вторая сторона на карточке — ЛИЧНАЯ политика видимости владельца
// (core/visibility, `user.card`: аудитории + исключения), а не флаги в строке.
// ============================================================

model ContactLink {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Canonical ordering: service layer MUST ensure userAId < userBId (string compare)
  // so (userAId, userBId) uniquely identifies the pair regardless of who initiated.
  userAId     String   @map("user_a_id") @db.Uuid
  userBId     String   @map("user_b_id") @db.Uuid
  // Asymmetric role: how each side names the other on their card.
  // ONE role per side. DB columns kept (label_*) to preserve data.
  roleAForB   String?  @map("label_a_for_b") // role A gave B (e.g. "Жена")
  roleBForA   String?  @map("label_b_for_a") // role B gave A (e.g. "Муж")
  // Who originally sent the invitation that created this link (user_id, not necessarily A)
  initiatedBy String   @map("initiated_by")
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userA       User               @relation("ContactLinkUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User               @relation("ContactLinkUserB", fields: [userBId], references: [id], onDelete: Cascade)
  memberships CircleMembership[]

  @@unique([userAId, userBId])
  // Composite indexes also satisfy `ORDER BY confirmedAt DESC` on the hot
  // "list my environment" query (which ORs over userAId / userBId). The
  // @@unique above already covers userAId-leading lookups.
  @@index([userAId, confirmedAt])
  @@index([userBId, confirmedAt])
  @@map("contact_links")
}

model ContactInvitation {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fromUserId   String  @map("from_user_id") @db.Uuid
  // Null when recipient is NOT yet on the platform (invitation by phone only).
  // Filled in when the phone registers → then the invitation is surfaced to them.
  toUserId     String? @map("to_user_id") @db.Uuid
  toPhone      String  @map("to_phone") // normalized E.164
  // ПДн под движком ключей: envelope (KEK отправителя) + слепой индекс для поиска по номеру
  toPhoneEnc   String? @map("to_phone_enc")
  toPhoneBi    String? @map("to_phone_bi")
  toPhoneBiAlt String? @map("to_phone_bi_alt")

  // Roles each side proposes. Recipient can override at accept-time.
  // DB columns kept (proposed_label_*) to preserve data.
  proposedRoleForSender    String? @map("proposed_label_for_sender") // role recipient gives sender
  proposedRoleForRecipient String? @map("proposed_label_for_recipient") // role sender gives recipient
  message                  String? // optional greeting text

  // Группы ОТПРАВИТЕЛЯ, в которые он просит положить контакт при принятии.
  // Отложенное намерение: применяется в acceptInvitation (получатель кладёт в
  // свои группы тем же шагом, но своим списком из тела запроса).
  autoAddToCircleIds String[] @map("auto_add_circle_ids") @db.Uuid

  // pending, accepted, rejected, cancelled, expired
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at") // TTL — background job marks expired
  respondedAt DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromUser User  @relation("InvitationSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User? @relation("InvitationRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toPhone])
  @@index([toPhoneBi])
  @@index([toPhoneBiAlt])
  @@index([fromUserId, toPhoneBi, status])
  @@index([fromUserId, toPhoneBiAlt, status])
  // ⚠️ ПАРТИАЛЬНЫЙ UNIQUE-двойник по слепому индексу дописан РУКАМИ в миграции keys_pii:
  //   contact_invitations_one_pending_per_phone_bi (from_user_id, to_phone_bi) WHERE status = 'pending'
  //   contact_invitations_one_pending_per_phone_bi_alt (from_user_id, to_phone_bi_alt) — двойник второго слота (миграция keys_blind_index_slots)
  @@index([fromUserId, status]) // leading column also serves plain fromUserId lookups
  // Курсорные списки приглашений: (…, status, createdAt, id) обслуживают и фильтр,
  // и ORDER BY createdAt DESC, id DESC.
  @@index([toUserId, status, createdAt, id])
  @@index([fromUserId, status, createdAt, id])
  // Send-path: cooldown / existing-pending checks filter (fromUserId, toPhone, status).
  @@index([fromUserId, toPhone, status])
  // Cleanup cron: WHERE status='pending' AND expiresAt < now.
  @@index([status, expiresAt])
  // ⚠️ ПАРТИАЛЬНЫЙ UNIQUE дописан РУКАМИ в миграции circle_review_fixes:
  //   CREATE UNIQUE INDEX contact_invitations_one_pending_per_phone
  //     ON contact_invitations (from_user_id, to_phone) WHERE status = 'pending';
  // Prisma партиальные индексы не умеет, а без него все лимиты отправки
  // (кулдаун, 30/24ч, потолок pending) обходились параллельными запросами:
  // проверки — обычные count вне транзакции, и 10 одновременных POST проходили
  // их все. Сервис ловит нарушение как P2002 → 409.
  @@map("contact_invitations")
}

model ContactBlock {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("ContactBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ContactBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("contact_blocks")
}

model Circle {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId                String   @map("owner_id") @db.Uuid
  name                   String // "Семья", "Родственники", "Работа", custom
  icon                   String?
  color                  String?
  sortOrder              Int      @default(0) @map("sort_order")
  // Per-group calendar access for THIS group's members (Phase 2): none | busy | detailed.
  calendarVisibility     String   @default("none") @map("calendar_visibility")
  // Per-group equipped card skin instance (premium). null = use owner's default skin.
  equippedSkinInstanceId String?  @map("equipped_skin_instance_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   CircleMembership[]
  assignedTasks Task[]             @relation("TaskAssignedCircle")

  @@index([ownerId])
  @@map("circles")
}

model CircleMembership {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  circleId      String   @map("circle_id") @db.Uuid
  contactLinkId String   @map("contact_link_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at")

  circle      Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  contactLink ContactLink @relation(fields: [contactLinkId], references: [id], onDelete: Cascade)

  @@unique([circleId, contactLinkId])
  @@index([contactLinkId])
  @@map("circle_memberships")
}

// ============================================================
// NOTIFICATIONS — core/notifications (17-й платформенный движок)
// ============================================================
// Событие + строка на адресата + журнал доставки (Odoo mail.message/mail.notification,
// Knock). Payload не дублируется: лента = индексный JOIN строки к событию.
// Слова — в каталоге @superapp/i18n (render-at-read); реестр типов — packages/shared/src/notifications.

model NotificationEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type           String
  // Денормализация из реестра (фильтры ленты и настроек без похода в реестр из SQL)
  service        String
  priority       String
  // ICU-переменные + данные рич-рендера (только скаляры и id)
  payload        Json     @default("{}")
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id")
  actorId        String?  @map("actor_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  // Ключ схлопывания, если продюсер передал свой (иначе — по стратегии типа)
  collapseKey    String?  @map("collapse_key")
  // Идемпотентность у ИСТОЧНИКА: unique (type, idempotency_key) — партиальный, руками в миграции
  idempotencyKey String?  @map("idempotency_key")
  // Переопределение deep link (иначе href(ref) из реестра)
  actionUrl      String?  @map("action_url")
  // Отношение адресата к событию (GitHub reason): mention | assigned | requested | …
  reason         String?
  // Адресаты как переданы продюсером: [{userId}|{type,id}|{chatId}] — разворот в фанауте
  recipients     Json     @default("[]")
  // Опции продюсера: channels (override), includeActor, audienceCtx, budget
  options        Json?
  // Снимок текста в SOURCE_LOCALE — фолбэк для типов, ушедших из реестра (как у хроники)
  snapshot       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  notifications Notification[]
  deliveries    NotificationDelivery[]

  // Партиальный unique (руками в миграции): ("type", "idempotency_key") WHERE idempotency_key IS NOT NULL
  @@index([refType, refId])
  // Ретеншн: событие удаляется, когда не осталось строк адресатов
  @@index([createdAt])
  // Частичный индекс каскада организации (миграция lifecycle_purge_runner, руками):
  //   notification_events_workspace_id_idx (workspace_id) WHERE workspace_id IS NOT NULL
  // Частичный индекс псевдонимизации следа стёртого актора (миграция lifecycle_actor_indexes, руками):
  //   notification_events_actor_id_idx (actor_id) WHERE actor_id IS NOT NULL
  // GIN notification_events_person_ids_idx на notification_person_ids(payload) — id людей, чьи имена
  // лежат в payload; выражение — руками в миграции 20260927000200 (ключи — lifecycle/person-refs.ts)
  @@map("notification_events")
}

/// Строка ленты адресата. `eventId` — ПОСЛЕДНЕЕ схлопнутое событие.
model Notification {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  // Контекст строки: workspaceId события, ЕСЛИ адресат — член; иначе null («Личное»)
  workspaceId   String?   @map("workspace_id") @db.Uuid
  type          String
  service       String
  priority      String
  reason        String?
  // Всегда есть: по стратегии типа, иначе = eventId
  collapseKey   String    @map("collapse_key")
  collapseCount Int       @default(1) @map("collapse_count")
  actorIds      String[]  @default([]) @map("actor_ids") @db.Uuid
  // seen ≠ read ≠ archived: бейдж = unseen; «Готово» = archived; Saved — вне ретеншна
  seenAt        DateTime? @map("seen_at")
  readAt        DateTime? @map("read_at")
  archivedAt    DateTime? @map("archived_at")
  savedAt       DateTime? @map("saved_at")
  snoozedUntil  DateTime? @map("snoozed_until")
  // Порядок ленты: поднимается при схлопывании и пробуждении; createdAt — когда случилось
  sortAt        DateTime  @default(now()) @map("sort_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Keyset ленты (sortAt, id)
  @@index([userId, sortAt, id])
  @@index([userId, workspaceId])
  // FK на событие: без своего индекса каждый DELETE события (ретеншн, каскад) и
  // анти-джойн `notifications: none` шли бы по таблице целиком
  @@index([eventId])
  // Организация ушла (исключение/удаление) — архив её строк разом
  @@index([workspaceId])
  // Ретеншн по createdAt
  @@index([createdAt])
  // Партиальные индексы (руками в миграции):
  //   UNIQUE ("user_id", "collapse_key") WHERE read_at IS NULL AND archived_at IS NULL — одна живая строка на ключ
  //   ("user_id") WHERE seen_at IS NULL — бейдж
  //   ("snoozed_until") WHERE snoozed_until IS NOT NULL — пробуждение
  @@map("notifications")
}

/// Леджер идемпотентности фанаута + журнал доставки по каналам. `recipient` = `user:<id>` | `chat:<id>`.
model NotificationDelivery {
  id                BigInt    @default(autoincrement())
  eventId           String    @map("event_id") @db.Uuid
  recipient         String
  userId            String?   @map("user_id") @db.Uuid
  channel           String
  notificationId    String?   @map("notification_id") @db.Uuid
  // queued | sent | delivered | failed | skipped
  status            String    @default("queued")
  // pref_off | policy | muted | quiet | no_device | driver_not_configured | no_access | actor | throttled | seen | burst | …
  skipReason        String?   @map("skip_reason")
  providerMessageId String?   @map("provider_message_id")
  error             String?
  attempts          Int       @default(0)
  scheduledAt       DateTime? @map("scheduled_at")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // RANGE-партиции по месяцу created_at (core/lifecycle: lifecycle_ensure_partition), срок 30 дней — сброс партиции
  @@id([id, createdAt])
  // INSERT … ON CONFLICT DO NOTHING на канале inapp = «этого адресата для этого события уже обработали»
  // Уникум обязан включать ключ партиции: created_at доставки = момент СОБЫТИЯ (детерминирован),
  // поэтому (событие, получатель, канал) остаётся единственным и между месяцами
  @@unique([eventId, recipient, channel, createdAt])
  // Батчер push: queued-доставки человека, созревшие к runAt
  @@index([userId, channel, status, scheduledAt])
  @@index([userId, createdAt])
  // Ретеншн 30 дней
  @@index([createdAt], type: Brin)
  @@map("notification_deliveries")
}

/// Разреженные переопределения человека: нет строки = дефолт реестра/политики. `context` = 'personal' | workspaceId (строка, не NULL: NULL в unique не конфликтует).
model NotificationPreference {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  context     String
  // service | type
  subjectKind String   @map("subject_kind")
  subjectKey  String   @map("subject_key")
  // inapp | push | sms (sms = opt-in критичного типа)
  channel     String
  enabled     Boolean
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, context, subjectKind, subjectKey, channel])
  @@map("notification_preferences")
}

/// Политика организации: дефолты + замки по типу/сервису (Salesforce Delivery Settings + Courier REQUIRED).
model WorkspaceNotificationPolicy {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  subjectKind String   @map("subject_kind")
  subjectKey  String   @map("subject_key")
  // inapp | push (SMS запереть нельзя — деньги организации, номер человека)
  channel     String
  // default_on | default_off | locked_on
  mode        String
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subjectKind, subjectKey, channel])
  @@map("workspace_notification_policies")
}

/// Подписка человека на объект: mute (не глушит личное упоминание и critical) | follow (авто-адресат).
model NotificationSubscription {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  refType   String   @map("ref_type")
  refId     String   @map("ref_id")
  mode      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refType, refId])
  @@index([refType, refId, mode])
  @@map("notification_subscriptions")
}

/// Устройство push: web (endpoint + ключи подписки) | ios/android (токен Expo/FCM). Протухание: lastSeenAt старше 60 дней → disabled.
model NotificationDevice {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // web | ios | android
  platform     String
  // webpush | expo | fcm
  provider     String
  // endpoint подписки (web) либо токен устройства
  token        String
  subscription Json?
  userAgent    String?   @map("user_agent")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  failureCount Int       @default(0) @map("failure_count")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, token])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("notification_devices")
}

/// Личные сквозные настройки: расписание тишины (в User.timezone) и разовая пауза.
model UserNotificationSettings {
  userId        String    @id @map("user_id") @db.Uuid
  // [{days:[1..7], from:'22:00', to:'08:00'}]
  quietSchedule Json?     @map("quiet_schedule")
  pausedUntil   DateTime? @map("paused_until")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

// ============================================================
// TASKS: Task Manager
// ============================================================

// Roles model (Bitrix24-style):
//   Постановщик  = creator (Task.creatorId, always 1, sets the task and accepts the result)
//   Исполнитель  = the single responsible executor          → TaskParticipant role="executor"
//   Соисполнитель = helpers (N)                              → TaskParticipant role="co_executor"
//   Наблюдатель   = watchers (N, read + chat only)           → TaskParticipant role="observer"
// An individual task has exactly ONE executor participant. A GROUP task (assignedCircleId set)
// has the circle members as co_executor participants — one shared task / one chat, but each
// participant carries their OWN status (drives "3 of 10" progress and per-person acceptance).
model Task {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title        String
  description  String?
  status       String    @default("todo") // todo, in_progress, on_review, done, cancelled
  priority     String    @default("medium") // low, medium, high, urgent
  // Numeric mirror of priority for ORDER BY (the string column sorts lexicographically:
  // high < low < medium < urgent — the visible "high below low" bug). 1=low … 4=urgent.
  priorityRank Int       @default(2) @map("priority_rank")
  dueDate      DateTime? @map("due_date")
  startDate    DateTime? @map("start_date")
  allDay       Boolean   @default(false) @map("all_day")

  // «Входящие» (GTD inbox): quick-add без срока/исполнителя, ещё не разобрано.
  // Уточнение (срок или исполнитель через PATCH) снимает флаг автоматически.
  inbox Boolean @default(false)

  // Постановщик (creator). Other roles live in TaskParticipant.
  creatorId String @map("creator_id") @db.Uuid

  // Group assignment: when set, the task targets a Circle (Группа). The Исполнитель field
  // shows the circle's name; its members are co_executor participants. null = individual task.
  // Snapshot semantics: participants are materialised at creation; this only keeps the label.
  assignedCircleId String? @map("assigned_circle_id") @db.Uuid

  // Hierarchy (subtasks)
  parentId String? @map("parent_id") @db.Uuid
  parent   Task?   @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("SubTasks")

  // Reward — display-only INTENT for now (no wallet yet; real balance lands with the Store).
  // Per-person semantics ("каждому по X"): coinReward is the amount each executor earns.
  coinReward   Int     @default(0) @map("coin_reward")
  coinPenalty  Int     @default(0) @map("coin_penalty")
  giftRewardId String? @map("gift_reward_id") @db.Uuid // future: a gift from the owner's Store

  // Reminder (single reminder before the deadline for MVP; cron sends the notification).
  reminderAt     DateTime? @map("reminder_at")
  reminderSentAt DateTime? @map("reminder_sent_at")

  // Recurrence (RRULE-light, e.g. "FREQ=DAILY"). Generated instances point back via parent id.
  recurrenceRule     String? @map("recurrence_rule")
  recurrenceParentId String? @map("recurrence_parent_id") @db.Uuid

  // Context — null = personal. workspaceId is the B2B tenant key (workspace assignment later).
  workspaceId String? @map("workspace_id") @db.Uuid

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Мягкое скрытие (корзина 30 дней): восстанавливаемо, затем раннер purge (core/lifecycle).
  /// Частичный индекс `(deleted_at) WHERE deleted_at IS NOT NULL` — руками в миграции.
  deletedAt   DateTime? @map("deleted_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  creator        User       @relation("TaskCreator", fields: [creatorId], references: [id])
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  assignedCircle Circle?    @relation("TaskAssignedCircle", fields: [assignedCircleId], references: [id], onDelete: SetNull)

  participants TaskParticipant[]
  tags         TaskTag[]

  @@index([creatorId])
  @@index([workspaceId])
  @@index([status])
  @@index([dueDate])
  @@index([parentId])
  @@index([assignedCircleId])
  // Reminder cron scans WHERE reminderAt <= now AND reminderSentAt IS NULL.
  @@index([reminderAt])
  @@map("tasks")
}

model TaskParticipant {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String // executor (Исполнитель), co_executor (Соисполнитель), observer (Наблюдатель)

  // Per-participant execution state. Acceptance is per-person, so a group task closes
  // ("done") only when EVERY non-observer participant reaches "accepted".
  //   pending → submitted (marked done) → accepted (creator accepted) | returned (sent back)
  status      String    @default("pending")
  submittedAt DateTime? @map("submitted_at")
  acceptedAt  DateTime? @map("accepted_at")
  returnedAt  DateTime? @map("returned_at")

  // Reward snapshot for this participant ("каждому по X"). Display-only for now.
  rewardCoins  Int     @default(0) @map("reward_coins")
  giftRewardId String? @map("gift_reward_id") @db.Uuid

  addedAt DateTime @default(now()) @map("added_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId]) // one role per user per task
  @@index([userId, status]) // "tasks assigned to me" + filter by my state
  @@index([taskId, role])
  @@map("task_participants")
}

model TaskTag {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  name   String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@index([name])
  @@map("task_tags")
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarEvent {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title       String
  description String?
  location    String?
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  allDay      Boolean  @default(false) @map("all_day")
  color       String?
  // Значок события (значение Glyph: 'ph:car' | 'fl:…' | 'nt:…' | имя иконки кита | символ)
  icon        String?

  // Per-event privacy override (sharing semantics wired in Phase 2): inherit | busy | hidden
  visibility String @default("inherit")

  // Configured reminder offsets (minutes before start). Materialized into CalendarEventReminder.
  reminderOffsets Int[] @map("reminder_offsets")

  // Recurrence (RRULE). Master rows carry recurrenceRule; single-occurrence overrides carry
  // recurrenceParentId + recurrenceId. exDates excludes occurrences from the master expansion.
  recurrenceRule     String?    @map("recurrence_rule")
  recurrenceParentId String?    @map("recurrence_parent_id") @db.Uuid
  recurrenceId       DateTime?  @map("recurrence_id")
  exDates            DateTime[] @map("ex_dates")
  // Materialized end of the recurrence (last occurrence end from UNTIL/COUNT; null = infinite).
  // Lets range queries skip long-finished series instead of RRULE-expanding every master ever.
  recurrenceEndsAt   DateTime?  @map("recurrence_ends_at")

  // Future CalDAV two-way sync (unused in Phase 1)
  googleEventId    String? @map("google_event_id")
  googleCalendarId String? @map("google_calendar_id")

  // Resource booking (Phase 3): the resource this event holds + booking status (pending|confirmed|rejected).
  resourceId     String? @map("resource_id") @db.Uuid
  resourceStatus String? @map("resource_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое скрытие (корзина 30 дней): восстанавливаемо, затем раннер purge (core/lifecycle).
  /// Частичный индекс `(deleted_at) WHERE deleted_at IS NOT NULL` — руками в миграции.
  deletedAt DateTime? @map("deleted_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceParent CalendarEvent?          @relation("EventRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  overrides        CalendarEvent[]         @relation("EventRecurrence")
  reminders        CalendarEventReminder[]
  participants     EventParticipant[]
  resource         Resource?               @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId, startTime])
  @@index([recurrenceParentId])
  @@index([googleEventId])
  @@index([resourceId])
  @@map("calendar_events")
}

// A bookable shared resource (room, vehicle, equipment). Personal for now (owner = user);
// workspaceId reserved for future B2B. Bookings are CalendarEvents referencing it.
model Resource {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  workspaceId     String?  @map("workspace_id") @db.Uuid
  name            String
  type            String   @default("other") // room | vehicle | equipment | other
  capacity        Int      @default(1)
  // Allow-list of who may book: specific people + Groups from the owner's environment.
  bookerUserIds   String[] @map("booker_user_ids") @db.Uuid
  bookerCircleIds String[] @map("booker_circle_ids") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings CalendarEvent[]

  @@index([ownerId])
  // Частичный индекс каскада организации (миграция lifecycle_purge_runner, руками):
  //   resources_workspace_id_idx (workspace_id) WHERE workspace_id IS NOT NULL
  @@map("resources")
}

// Materialized reminder queue: one row per (event occurrence × configured offset × user).
// Rolling horizon kept by the calendar cron; dispatched rows emit calendar.event.reminder.
model CalendarEventReminder {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  occurrenceStart DateTime  @map("occurrence_start")
  minutesBefore   Int       @map("minutes_before")
  fireAt          DateTime  @map("fire_at")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, occurrenceStart, minutesBefore])
  @@index([fireAt, sentAt])
  // Чистка отправленных: WHERE sentAt < cutoff (иначе таблица растёт вечно —
  // повтор «ежедневно, 2 оффсета, 2 участника» = 4 строки в день навсегда).
  @@index([sentAt])
  @@map("calendar_event_reminders")
}

// Event attendees (Phase 2). The creator is the implicit organizer (event.userId);
// rows here are invitees. One shared event → many participants (no copies).
model EventParticipant {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  role            String   @default("attendee") // organizer | attendee
  rsvp            String   @default("pending") // pending | accepted | declined | tentative
  // This participant's own reminder offsets (minutes before start). Materialized per user.
  reminderOffsets Int[]    @map("reminder_offsets")
  addedAt         DateTime @default(now()) @map("added_at")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

// Personal calendar shares migrated to the access engine (core/access) — CalendarShare dropped.

// Per-user Google Calendar connection (Phase 4 two-way sync). One Google account per user.
// NOTE: tokens are stored as-is for MVP; encrypt-at-rest before production.
model GoogleConnection {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  googleEmail       String    @map("google_email")
  // Токены Google — envelope core/keys (`sa6e:`), KEK человека; строки прошлой эпохи
  // (открытый текст) перешифровывает джоб keys.legacy.reencrypt на первом старте.
  accessToken       String    @map("access_token")
  refreshToken      String    @map("refresh_token")
  tokenExpiry       DateTime? @map("token_expiry")
  // Google calendar we two-way sync events with; separate calendar for one-way task export.
  syncCalendarId    String?   @map("sync_calendar_id")
  tasksCalendarId   String?   @map("tasks_calendar_id")
  // Incremental sync state + push-notification channel.
  syncToken         String?   @map("sync_token")
  channelId         String?   @map("channel_id")
  channelResourceId String?   @map("channel_resource_id")
  channelExpiry     DateTime? @map("channel_expiry")
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

// ============================================================
// WORKSPACES (Job platform foundation)
// ============================================================

// A Workspace is ALWAYS a business/organization (B2B tenant). Personal life is the
// social graph (workspaceId = null), NOT a workspace — so there is no "type" field.
model Workspace {
  id   String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name String
  logo String?

  // Company profile (Анкета) — fields rendered on the company card.
  description  String? // "О компании"
  industry     String? // отрасль
  city         String?
  website      String?
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  // Кто видит анкету — правила видимости организации (core/visibility, `workspace.card`).

  // ЯЗЫК ДОКУМЕНТОВ организации: на нём печатаются бумаги (бланки, счета, акты)
  // и собираются печатные слова платформы внутри них. Умолчание — государственный
  // язык рынка (RegionProfile.defaultLocale); у отдельного бланка язык свой.
  documentLanguage String @default("kk") @map("document_language")

  ownerId    String    @map("owner_id") @db.Uuid // founder; single owner (billing/delete/transfer)
  isActive   Boolean   @default(true) @map("is_active")
  // Когда организацию деактивировали (отправили в архив). Отдельная колонка, а не
  // updatedAt: тот двигает ЛЮБАЯ правка строки, и ретеншн-крон отсчитывал бы 90 дней
  // заново после каждого касания. null у живой организации; restore обнуляет.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner                User                          @relation(fields: [ownerId], references: [id])
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  tasks                Task[]
  notificationPolicies WorkspaceNotificationPolicy[]
  staffDepartments     StaffDepartment[]
  staffPositions       StaffPosition[]
  staffBranches        StaffBranch[]
  staffAssignments     StaffAssignment[]
  staffingPositions    StaffingPosition[]
  staffRates           StaffRate[]
  shiftTemplates       ShiftTemplate[]
  shiftPatterns        ShiftPattern[]
  shifts               Shift[]
  shiftAttendance      ShiftAttendance[]
  assetModels          AssetModel[]
  assets               Asset[]
  assetMoves           AssetMove[]
  assetServices        AssetServiceRecord[]
  staffDeputies        StaffDeputy[]
  officeRooms          OfficeRoom[]
  legalEntities        LegalEntity[]
  bankAccounts         WorkspaceBankAccount[]
  docTypes             DocType[]
  docTemplates         DocTemplate[]
  orgDocuments         OrgDocument[]
  counterparties       Counterparty[]
  employments          Employment[]
  hrActions            HrAction[]
  hrActionBatches      HrActionBatch[]
  esutdSubmissions     EsutdSubmission[]
  docCampaigns         DocCampaign[]
  libraryInstalls      DocTemplateLibraryInstall[]
  bots                 Bot[]
  keyPolicy            WorkspaceKeyPolicy?
  visibilitySettings   WorkspaceVisibilitySettings?
  webhookEndpoints     WebhookEndpoint[]
  lifecycleSettings    LifecycleSetting[]

  @@index([ownerId])
  // Ретеншн-крон архива: выборка «что пора удалять» идёт по этой колонке.
  @@index([archivedAt])
  @@map("workspaces")
}

// Юрлицо организации (ТОО/ИП) — сторона договора, владелец счетов и балансодержатель.
// Workspace — это БРЕНД («Сеть кофеен Ромашка»), а договор с работником и счёт
// подписывает конкретное ТОО; у сети их бывает несколько (разные регионы, разные
// налоговые режимы). Ровно одно ГОЛОВНОЕ (isHead): его реквизиты отдаёт старая ручка
// /requisites, оно подставляется по умолчанию всюду, где юрлицо не выбрано.
// Не удаляется, а АРХИВИРУЕТСЯ: на неё ссылаются трудовые карточки и напечатанные
// документы. Редактирует admin+; кто видит блок — правила видимости (`workspace.card`).
//
// ⚠️ Рукописные ограничения (не выражаются в Prisma; `db push` запрещён):
//   CREATE UNIQUE INDEX "legal_entities_head_per_workspace_key"
//     ON "legal_entities"("workspace_id") WHERE "is_head";
//   CREATE UNIQUE INDEX "legal_entities_bin_live_key"
//     ON "legal_entities"("workspace_id","bin") WHERE "bin" IS NOT NULL AND "archived_at" IS NULL;
model LegalEntity {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /**
   * Как показывать в списках: «ТОО „Ромашка"» / «ИП Иванов»
   */
  name        String
  /**
   * Головное — ровно одно на организацию; архивировать нельзя.
   */
  isHead      Boolean @default(false) @map("is_head")

  orgForm         String?   @map("org_form") // ip | too | ao | kh | pk | institution | branch | other
  taxRegime       String?   @map("tax_regime") // general | simplified | retail | patent | snr_kh | astana_hub | other
  legalName       String?   @map("legal_name") // «ТОО „Ромашка"» — Workspace.name это бренд, в договор идёт юрформа
  bin             String? // 12 цифр, контрольная сумма проверяется схемой
  legalAddress    String?   @map("legal_address")
  kbe             String? // код бенефициара, 2 цифры — без него не заполнить платёжку
  vatPayer        Boolean   @default(false) @map("vat_payer")
  vatSeries       String?   @map("vat_series")
  vatNumber       String?   @map("vat_number")
  vatDate         DateTime? @map("vat_date") @db.Date
  // Директор — выбор из СОТРУДНИКОВ (валидируется членством при записи; FK на users
  // нет намеренно — увольнение не должно рвать реквизиты, подпись сверяется на выдаче).
  directorUserId  String?   @map("director_user_id") @db.Uuid
  // ОСНОВАНИЕ ПОДПИСИ — структурой, а не готовой фразой: «действующего на
  // основании Приказа № 12-к от 15.01.2026» печатается ВНУТРИ договора, а
  // договор бывает на трёх языках. Слова подбираются на выходе — в языке
  // бланка при рендере и в языке зрителя на экране (docs/counterparties.md).
  signBasisKind   String?   @map("sign_basis_kind") // ustav | svid_ip | doverennost | prikaz | polozhenie | custom
  signBasisNumber String?   @map("sign_basis_number")
  signBasisDate   DateTime? @map("sign_basis_date") @db.Date
  signBasisText   String?   @map("sign_basis_text") // своя формулировка целиком (kind = custom)

  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankAccounts  WorkspaceBankAccount[]
  employments   Employment[]
  branches      StaffBranch[]
  balanceAssets Asset[]

  @@index([workspaceId, archivedAt])
  @@map("legal_entities")
}

// Банковские счета организации — СПИСОК с основным (модель 1С/Odoo: счетов несколько,
// в документы подставляется основной). «Ровно один основной» держит сервис в
// транзакции (снять со всех → поставить одному); отдельного partial-unique нет —
// короткое окно двух основных не ломает ничего, а честный инвариант чинится следующей
// записью.
model WorkspaceBankAccount {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  /**
   * Счёт принадлежит ЮРЛИЦУ (в платёжку идут его БИН/КБе), а не бренду.
   */
  legalEntityId String   @map("legal_entity_id") @db.Uuid
  iban          String // KZ + 18 знаков, контроль ISO 13616
  ibanEnc       String?  @map("iban_enc") // ПДн под движком ключей (KEK организации)
  bankName      String   @map("bank_name")
  bik           String // 8 знаков SWIFT-формата
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([legalEntityId])
  @@map("workspace_bank_accounts")
}

// Платёжная карта человека — РЕКВИЗИТ для выплат (зарплата, возвраты), не платёжный
// инструмент: без CVV, платежи платформа через неё не проводит. Номер и IBAN
// карт-счёта шифруются envelope'ом core/keys (KEK человека, AAD = карта+поле);
// last4 хранится открыто для масок.
// Управляющим организаций основная карта отдаётся полностью — ради выплат блок и
// существует (второй уровень «Видимости в Компаниях»).
model UserPaymentCard {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  panEncrypted  String   @map("pan_encrypted")
  panLast4      String   @map("pan_last4")
  ibanEncrypted String?  @map("iban_encrypted")
  holderName    String   @map("holder_name") // как на карте
  expMonth      Int      @map("exp_month")
  expYear       Int      @map("exp_year")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_payment_cards")
}

// Membership row. Role & permissions are NOT stored here — the single source
// of truth is UserRole (context="workspace", tenantId=workspaceId). Должности/отделы/
// филиалы — сущности StaffModule (назначения в StaffAssignment), не текст здесь.
model WorkspaceMember {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  joinedAt DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// Hiring invitation. Найм ВСЕГДА в Стажёра (роль не выбирается; колонка остаётся для
// истории/будущих типов найма). Опциональные positionId + branchIds — «нанять официанта
// в Алматинский и Астанинский филиалы»: при принятии создаётся назначение на КАЖДЫЙ
// филиал (один сотрудник может обслуживать несколько). branchIds — scalar-массив (FK на
// массив в Postgres нет; мёртвый id безопасно скипается при принятии).
// toUserId is null for an external invite by phone — it activates when that phone registers.
model WorkspaceInvitation {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  invitedBy   String @map("invited_by") @db.Uuid // user_id who sent the invite

  toUserId     String? @map("to_user_id") @db.Uuid // null until the invited phone is on the platform
  toPhone      String  @map("to_phone") // normalized E.164
  // ПДн под движком ключей: envelope (KEK организации) + слепой индекс
  toPhoneEnc   String? @map("to_phone_enc")
  toPhoneBi    String? @map("to_phone_bi")
  toPhoneBiAlt String? @map("to_phone_bi_alt")

  role       String   @default("trainee") // всегда trainee для новых приглашений
  positionId String?  @map("position_id") @db.Uuid
  branchIds  String[] @map("branch_ids") @db.Uuid // несколько филиалов «с порога»
  message    String?

  status      String    @default("pending") // pending, accepted, rejected, cancelled, expired
  expiresAt   DateTime  @map("expires_at") // TTL — background job marks expired
  respondedAt DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User           @relation("WsInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  toUser    User?          @relation("WsInvitationRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  position  StaffPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([toUserId])
  @@index([toPhone])
  @@index([toPhoneBi])
  @@index([toPhoneBiAlt])
  @@index([workspaceId, status])
  @@index([toUserId, status])
  // Cleanup cron: WHERE status='pending' AND expiresAt < now.
  @@index([status, expiresAt])
  // FK position_id (SET NULL): удаление должности без индекса сканирует таблицу.
  @@index([positionId])
  @@map("workspace_invitations")
}

// ============================================================
// STAFF («Сотрудники») — справочники организации + назначения должностей + оргструктура
// ============================================================
// Должность/Отдел/Объект (StaffBranch) — первоклассные справочники воркспейса.
// Назначение = человек × должность × ОБЪЕКТ со статусом обучения (Додзё переключит
// training→certified). Членство в отделе — ПРОИЗВОДНОЕ от должности
// (StaffPosition.departmentId) — модель штатного расписания 1С. Роль прав
// (trainee/staff/manager/…) живёт в UserRole, справочники прав не несут.
//
// Оргструктура = граф ДОЛЖНОСТЕЙ и ОБЪЕКТОВ (не людей — переживает текучку,
// SAP SuccessFactors): руководящая должность у отдела (headPositionId) и у объекта,
// точечное переопределение подчинения (reportsToPositionId), заместители (StaffDeputy).
// Вертикаль ВЫЧИСЛЯЕТСЯ (modules/staff/org-resolve.ts), а не хранится.
// Рёбра проецируются в core/access: position#holder / branch#member|head /
// department#member|head. Замещения (датированные) в рёбра НЕ проецируются —
// RelationTuple хранит только независимые от времени факты.

model StaffDepartment {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  name           String
  parentId       String? @map("parent_id") @db.Uuid // дерево в данных
  sortOrder      Int     @default(0) @map("sort_order")
  // Руководящая должность отдела. Лежит НА ОТДЕЛЕ, а не флагом на должности:
  // должность вправе руководить отделом, находясь ВНЕ его (CFO ведёт «Финансовый»,
  // сидя вне отдела) и вести несколько отделов сразу (поэтому без @@unique).
  // FK SetNull + прикладной 409 при удалении должности-головы.
  headPositionId String? @map("head_position_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       StaffDepartment?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     StaffDepartment[] @relation("DepartmentTree")
  positions    StaffPosition[]
  headPosition StaffPosition?    @relation("DepartmentHead", fields: [headPositionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([headPositionId])
  @@map("staff_departments")
}

model StaffPosition {
  id                  String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId         String  @map("workspace_id") @db.Uuid
  name                String
  departmentId        String? @map("department_id") @db.Uuid // отдел должности (опционально)
  description         String?
  sortOrder           Int     @default(0) @map("sort_order")
  // Точечное переопределение подчинения — сильнее дерева отделов и головы объекта.
  // Self-FK SetNull: потеря переопределения = откат к дереву, безопасно.
  // Флага «корень» нет: корень = «нет разрешимого руководителя».
  reportsToPositionId String? @map("reports_to_position_id") @db.Uuid
  // Значок-данные для <Glyph/> (ключ реестра иконок или эмодзи) — выбирает человек.
  glyph               String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department        StaffDepartment?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments       StaffAssignment[]
  staffingPositions StaffingPosition[]
  shifts            Shift[]
  invitations       WorkspaceInvitation[]
  reportsTo         StaffPosition?        @relation("PositionReportsTo", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports           StaffPosition[]       @relation("PositionReportsTo")
  headedDepartments StaffDepartment[]     @relation("DepartmentHead")
  headedBranches    StaffBranch[]         @relation("BranchHead")
  deputiesFor       StaffDeputy[]         @relation("DeputyForPosition")
  deputyOf          StaffDeputy[]         @relation("DeputyPosition")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([departmentId])
  @@index([reportsToPositionId])
  @@map("staff_positions")
}

// Объект (в UI сегодня «Филиал»; сервис «Объекты» переименует и добавит реквизиты
// на объект — объект может быть отдельным ТОО). У организации ВСЕГДА ≥1 объект:
// основной (isDefault) заводится вместе с организацией, назначение всегда в объекте.
// Объект — «отдел по умолчанию»: должность без отдела подчиняется голове объекта.
//
// ⚠️ Рукописное ограничение (не выражается в Prisma; переживёт только ручное
// зеркалирование при `prisma db pull`; `db push` запрещён):
//   CREATE UNIQUE INDEX "staff_branches_default_per_workspace_key"
//     ON "staff_branches"("workspace_id") WHERE "is_default";
model StaffBranch {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  name           String
  address        String?
  note           String?
  sortOrder      Int     @default(0) @map("sort_order")
  isDefault      Boolean @default(false) @map("is_default")
  // Руководящая должность объекта («Управляющий точкой») — та же модель, что у отдела.
  headPositionId String? @map("head_position_id") @db.Uuid

  // ---- Дерево площадок (сервис «Объекты») ----
  // Self-FK Restrict: узел с детьми не удаляется (прикладной 409 object_has_children —
  // дети переносятся явно, а не осиротевают молча).
  parentId         String?   @map("parent_id") @db.Uuid
  kind             String    @default("site") // OBJECT_KINDS: site|building|floor|room|warehouse|zone|other
  // Юрлицо объекта. null = наследуется от ближайшего предка, иначе головное
  // (ObjectsService.effectiveLegalEntity) — сеть заводит ТОО один раз на площадку.
  legalEntityId    String?   @map("legal_entity_id") @db.Uuid
  // Смены считаются в поясе ОБЪЕКТА, не организации: «сегодня» у точки в Актау
  // наступает раньше, чем у бэк-офиса в Алматы.
  timeZone         String    @default("Asia/Almaty") @map("time_zone")
  glyph            String?
  // Материализованные предки (корень ПЕРВЫМ, без себя) + глубина. Паттерн Диска и
  // closure отделов: одно условие в SQL и для поддерева, и для прав через предков.
  // GIN объявлен НИЖЕ (@@index): пока он жил только в комментарии, следующая же
  // `prisma migrate dev` посчитала его дрейфом и вписала в чужую миграцию DROP INDEX.
  ancestorIds      String[]  @default([]) @map("ancestor_ids") @db.Uuid
  depth            Int       @default(0)
  // Правила смен объекта = ДАННЫЕ (ObjectScheduleSettings): minRestMin, maxShiftMin,
  // lateToleranceMin, weekStartsOn, accountingPeriod.
  scheduleSettings Json?     @map("schedule_settings")
  // Закрытая точка: история, смены и активы остаются; в новых формах не предлагается.
  archivedAt       DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments       StaffAssignment[]
  staffingPositions StaffingPosition[]
  shiftTemplates    ShiftTemplate[]
  shiftPatterns     ShiftPattern[]
  shifts            Shift[]
  shiftAttendance   ShiftAttendance[]
  assets            Asset[]
  headPosition      StaffPosition?     @relation("BranchHead", fields: [headPositionId], references: [id], onDelete: SetNull)
  deputies          StaffDeputy[]
  parent            StaffBranch?       @relation("BranchTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          StaffBranch[]      @relation("BranchTree")
  legalEntity       LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  // ⚠️ РУКАМИ: уникальность имени — на пару «родитель + имя» и только среди ЖИВЫХ
  // (Prisma не выражает ни COALESCE, ни партиальный уникум):
  // CREATE UNIQUE INDEX staff_branches_parent_name_key
  //   ON staff_branches (workspace_id, COALESCE(parent_id, ''), name) WHERE archived_at IS NULL;
  // Прежний @@unique([workspaceId, name]) запрещал второй «Этаж 1» во всей сети.
  @@index([workspaceId])
  @@index([headPositionId])
  @@index([workspaceId, parentId])
  @@index([legalEntityId])
  // Права через предков (`ancestor_ids && granted`) и обход поддерева — только по нему
  @@index([ancestorIds(ops: ArrayOps)], map: "staff_branches_ancestor_ids_gin", type: Gin)
  @@map("staff_branches")
}

// Назначение должности. Несколько на человека — норма (официант + бармен; одна
// должность в двух объектах = два назначения). Объект ОБЯЗАТЕЛЕН (по умолчанию —
// основной объект организации). Дубль закрывает @@unique.
//
// isPrimary — основное место человека: первое назначение основное автоматически,
// смена снимает старое в той же транзакции, удаление основного повышает следующее
// по createdAt. Читают: computeMismatch КЭДО, поля шаблонов, managerOf.
//
// ⚠️ Рукописное ограничение (не выражается в Prisma):
//   CREATE UNIQUE INDEX "staff_assignments_primary_per_user_key"
//     ON "staff_assignments"("workspace_id", "user_id") WHERE "is_primary";
model StaffAssignment {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  positionId  String  @map("position_id") @db.Uuid
  branchId    String  @map("branch_id") @db.Uuid
  isPrimary   Boolean @default(false) @map("is_primary")
  status      String  @default("training") // training | certified (Додзё/manager+ переключает)
  assignedBy  String? @map("assigned_by") // user_id назначившего (аудит)

  // ---- Датирование (сервис «Объекты») ----
  // Закрытое назначение ОСТАЁТСЯ: на него ссылаются ставки, смены и история.
  // null у starts_on = «с сотворения», null у ends_on = бессрочно.
  startsOn           DateTime? @map("starts_on") @db.Date
  endsOn             DateTime? @map("ends_on") @db.Date
  /**
   * Доля ставки: два человека по 0.5 закрывают одну штатную единицу
   */
  rateShare          Float     @default(1) @map("rate_share")
  /**
   * К какой штатной единице отнесено (FK SetNull — единицу можно убрать из штатки)
   */
  staffingPositionId String?   @map("staffing_position_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  position         StaffPosition     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  // Restrict: удаление объекта с людьми — прикладной 409 «сначала переведите».
  branch           StaffBranch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staffingPosition StaffingPosition? @relation(fields: [staffingPositionId], references: [id], onDelete: SetNull)
  rates            StaffRate[]
  shifts           Shift[]
  shiftPatterns    ShiftPattern[]

  // ⚠️ РУКАМИ (Prisma не выражает ни EXCLUDE, ни CHECK, ни партиальный уникум):
  //  · staff_assignments_primary_per_user_key — UNIQUE(workspace_id, user_id) WHERE is_primary
  //  · staff_assignments_dates_check — CHECK (ends_on >= starts_on)
  //  · staff_assignments_no_overlap — EXCLUDE по диапазону дат (btree_gist):
  //    один человек не занимает одну должность в одном объекте дважды в один период.
  @@index([workspaceId, userId])
  @@index([positionId])
  @@index([branchId])
  @@index([staffingPositionId])
  @@index([workspaceId, endsOn])
  @@map("staff_assignments")
}

/// Штатная ЕДИНИЦА: должность × объект. Существует и ВАКАНТНОЙ — на этом держится
/// план затрат («по штату 3 бариста, работают 2»). Плановая ставка единицы копируется
/// в фактическую при назначении человека.
///
/// ⚠️ Рукописное ограничение (Prisma не выражает):
///   CREATE UNIQUE INDEX "staffing_positions_live_key"
///     ON "staffing_positions"("branch_id","position_id") WHERE "archived_at" IS NULL;
model StaffingPosition {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  positionId      String    @map("position_id") @db.Uuid
  /**
   * «По штату N» — целое; частичная занятость выражается rateShare назначения
   */
  headcount       Int       @default(1)
  /**
   * График по умолчанию для новых назначений на эту единицу
   */
  shiftTemplateId String?   @map("shift_template_id") @db.Uuid
  sortOrder       Int       @default(0) @map("sort_order")
  note            String?
  archivedAt      DateTime? @map("archived_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch        StaffBranch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  position      StaffPosition     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assignments   StaffAssignment[]
  rates         StaffRate[]
  shifts        Shift[]
  shiftPatterns ShiftPattern[]
  shiftTemplate ShiftTemplate?    @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, branchId])
  @@index([positionId])
  @@index([shiftTemplateId])
  @@map("staffing_positions")
}

/// ВЕРСИЯ ставки (SCD2, append-only). Новая ставка с даты D закрывает предыдущую
/// (effectiveTo = D−1) в одной транзакции — «сколько платили в марте» обязано
/// отвечаться через год. Ровно одна цель: штатная единица (план) XOR назначение (факт).
///
/// ⚠️ Рукописные ограничения (Prisma их не выражает):
///   CHECK  staff_rates_target_xor_check   — план XOR факт
///   CHECK  staff_rates_dates_check        — конец не раньше начала
///   UNIQUE staff_rates_assignment_from_key / staff_rates_staffing_from_key
model StaffRate {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  staffingPositionId String? @map("staffing_position_id") @db.Uuid
  assignmentId       String? @map("assignment_id") @db.Uuid

  rateType String @map("rate_type") // monthly | per_shift | hourly | revenue_share (reserved)
  amount   BigInt // тиыны; на проводе — строкой
  currency String @default("KZT")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  staffingPosition StaffingPosition? @relation(fields: [staffingPositionId], references: [id], onDelete: Cascade)
  assignment       StaffAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, effectiveFrom])
  @@index([staffingPositionId, effectiveFrom])
  @@index([workspaceId])
  @@map("staff_rates")
}

// Заместитель: КОГО замещают — ДОЛЖНОСТЬ (positionId), в каком объекте (null = во всех).
// Кем — ровно одно из: должность (deputyPositionId) или человек (deputyUserId).
// Семантика по датам: без дат = ЗАПАСНОЙ (только когда должность пуста в этом объекте);
// с датами = ВМЕСТО на период; датированное сильнее. Пересечения разрешены (ответ —
// множество, как у resolveAssignees). В рёбра прав НЕ проецируется никогда:
// проекция не пересчитывается в полночь, датированное замещение пережило бы отпуск.
//
// ⚠️ Рукописные ограничения (не выражаются в Prisma):
//   CHECK "staff_deputies_target_xor_check"  — ровно одна цель (должность XOR человек)
//   CHECK "staff_deputies_dates_check"       — ends_on >= starts_on
//   CHECK "staff_deputies_not_self_check"    — должность не замещает сама себя
//   UNIQUE "staff_deputies_dedup_key" по COALESCE(...) — защита от двойного клика
model StaffDeputy {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  positionId       String    @map("position_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  deputyPositionId String?   @map("deputy_position_id") @db.Uuid
  deputyUserId     String?   @map("deputy_user_id") @db.Uuid
  startsOn         DateTime? @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  note             String?
  createdById      String    @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  position       StaffPosition  @relation("DeputyForPosition", fields: [positionId], references: [id], onDelete: Cascade)
  branch         StaffBranch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deputyPosition StaffPosition? @relation("DeputyPosition", fields: [deputyPositionId], references: [id], onDelete: Cascade)
  deputyUser     User?          @relation("DeputyUser", fields: [deputyUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([positionId])
  @@index([deputyPositionId])
  @@index([deputyUserId])
  @@map("staff_deputies")
}

/// Шаблон смены («Утро 09–17») — СПРАВОЧНИК. Экземпляр смены замораживает время в
/// себе: правка шаблона задним числом план не трогает (иначе «мне ставили 9:00»
/// превращалось бы в спор без доказательств). branchId=null — шаблон организации.
model ShiftTemplate {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  name        String
  glyph       String?
  /**
   * Цвет-ДАННЫЕ (выбирает человек) — сетка красит чип по нему
   */
  color       String?
  /**
   * Минуты от полуночи локального дня объекта
   */
  startMin    Int       @map("start_min")
  durationMin Int       @map("duration_min")
  breakMin    Int       @default(0) @map("break_min")
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch            StaffBranch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  staffingPositions StaffingPosition[]

  @@index([workspaceId, branchId])
  @@map("shift_templates")
}

/// Ротация (2/2, 5/2, произвольный цикл) — ПОРОЖДАЕТ смены на горизонт джобом
/// `objects.shifts.generate`. Принадлежит человеку (assignmentId) ИЛИ открытым
/// слотам штатной единицы (staffingPositionId) — рукописный CHECK XOR.
model ShiftPattern {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid

  assignmentId       String? @map("assignment_id") @db.Uuid
  staffingPositionId String? @map("staffing_position_id") @db.Uuid

  name        String
  anchorDate  DateTime  @map("anchor_date") @db.Date
  /**
   * По элементу на день цикла: id шаблона или null (выходной)
   */
  cycle       Json
  activeFrom  DateTime  @map("active_from") @db.Date
  activeTo    DateTime? @map("active_to") @db.Date
  horizonDays Int       @default(42) @map("horizon_days")
  archivedAt  DateTime? @map("archived_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch           StaffBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignment       StaffAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  staffingPosition StaffingPosition? @relation(fields: [staffingPositionId], references: [id], onDelete: Cascade)
  shifts           Shift[]

  @@index([workspaceId, branchId])
  @@index([assignmentId])
  @@index([staffingPositionId])
  @@map("shift_patterns")
}

/// ПЛАН смены. Отдельная сущность от факта (ShiftAttendance): «кто закрыл» ≠ «кому
/// назначена». `userId` денормализован ради слоя календаря; null = ОТКРЫТАЯ смена
/// (её берёт сотрудник с подходящей должностью).
///
/// ⚠️ Рукописные ограничения (Prisma их не выражает):
///   UNIQUE  shifts_pattern_slot_key   — идемпотентная генерация по ротации
///   EXCLUDE shifts_user_no_overlap    — (workspace_id, user_id, диапазон): один человек
///     не стоит на двух пересекающихся сменах В ОДНОЙ организации (между организациями
///     совместительство не полицействуем — это утечка сквозь B2B-изоляцию)
model Shift {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  branchId    String @map("branch_id") @db.Uuid

  staffingPositionId String? @map("staffing_position_id") @db.Uuid
  positionId         String  @map("position_id") @db.Uuid
  assignmentId       String? @map("assignment_id") @db.Uuid
  userId             String? @map("user_id") @db.Uuid

  /**
   * День НАЧАЛА смены в поясе ОБЪЕКТА (смена через полночь — день начала)
   */
  localDate DateTime @map("local_date") @db.Date
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  breakMin  Int      @default(0) @map("break_min")

  templateId  String? @map("template_id") @db.Uuid
  patternId   String? @map("pattern_id") @db.Uuid
  patternSlot Int     @default(0) @map("pattern_slot")

  status      String    @default("draft") // draft | published | cancelled
  publishedAt DateTime? @map("published_at")
  note        String?
  /**
   * Оптимистичная блокировка правки сетки
   */
  version     Int       @default(1)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch           StaffBranch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staffingPosition StaffingPosition? @relation(fields: [staffingPositionId], references: [id], onDelete: SetNull)
  position         StaffPosition     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assignment       StaffAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  template         ShiftTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pattern          ShiftPattern?     @relation(fields: [patternId], references: [id], onDelete: SetNull)
  attendance       ShiftAttendance[]

  @@index([workspaceId, branchId, localDate])
  @@index([userId, startsAt])
  @@index([patternId, localDate])
  @@index([assignmentId])
  @@index([staffingPositionId])
  @@index([templateId])
  @@index([positionId])
  @@map("shifts")
}

/// ФАКТ выхода. Источник `manual` (менеджер) сегодня, `access_control` (пропускная
/// система, порт AttendancePort) и `self` — на вырост; таблица одна, чтобы сверка
/// плана и факта не собиралась из двух моделей.
///
/// ⚠️ Рукописное ограничение: UNIQUE shift_attendance_shift_key — один факт на смену.
model ShiftAttendance {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  branchId    String  @map("branch_id") @db.Uuid
  /**
   * null = внеплановый выход (смены в плане не было)
   */
  shiftId     String? @map("shift_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid

  localDate     DateTime  @map("local_date") @db.Date
  outcome       String // worked | late | absent
  lateMin       Int       @default(0) @map("late_min")
  actualStartAt DateTime? @map("actual_start_at")
  actualEndAt   DateTime? @map("actual_end_at")

  source    String  @default("manual") @map("source") // manual | access_control | self
  /**
   * id события устройства — под будущую сверку и акт
   */
  sourceRef String? @map("source_ref")

  markedById String?  @map("marked_by_id") @db.Uuid
  markedAt   DateTime @default(now()) @map("marked_at")
  note       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branch    StaffBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift     Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // ⚠️ РУКАМИ: партиальные уникумы —
  //  · shift_attendance_shift_key — один факт на смену (WHERE shift_id IS NOT NULL)
  //  · shift_attendance_source_ref_key — UNIQUE(workspace_id, source_ref)
  //    WHERE source_ref IS NOT NULL: повтор доставки события турникета не заводит
  //    второй выход.
  @@index([workspaceId, branchId, localDate])
  @@index([userId, localDate])
  // Раннер сроков: табель старше срока (core/lifecycle)
  @@index([localDate])
  @@map("shift_attendance")
}

/// СПРАВОЧНИК моделей оборудования (на организацию). Инструкции и паспорт крепятся
/// СЮДА один раз — на все двадцать одинаковых кофемашин сети.
model AssetModel {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  kind         String    @default("equipment") // equipment | vehicle | land | other
  name         String
  manufacturer String?
  category     String?
  specs        Json?
  glyph        String?
  archivedAt   DateTime? @map("archived_at")
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@unique([workspaceId, kind, name])
  @@map("asset_models")
}

/// ЭКЗЕМПЛЯР. Два независимых измерения:
///   ГДЕ стоит   — branchId + parentAssetId (узел внутри линии) + locationNote;
///   ЧЬЁ и на балансе ли — holdingKind + balanceLegalEntityId + holdingCounterpartyId.
/// Арендованная кофемашина стоит в нашем зале, но на балансе арендодателя — смешение
/// этих осей и есть главная ошибка учёта, которую модель не даёт совершить.
///
/// ⚠️ Рукописное ограничение (Prisma его не выражает):
///   CREATE UNIQUE INDEX "assets_inventory_live_key"
///     ON "assets"("workspace_id","inventory_number")
///     WHERE "inventory_number" IS NOT NULL AND "archived_at" IS NULL;
model Asset {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String  @map("workspace_id") @db.Uuid
  modelId         String  @map("model_id") @db.Uuid
  /**
   * Денормализовано с модели — фильтр «только транспорт» без join
   */
  kind            String  @default("equipment")
  name            String
  inventoryNumber String? @map("inventory_number")
  serialNumber    String? @map("serial_number")

  branchId      String  @map("branch_id") @db.Uuid
  parentAssetId String? @map("parent_asset_id") @db.Uuid
  locationNote  String? @map("location_note")

  holdingKind           String  @default("owned") @map("holding_kind") // owned | leased | rented | third_party
  balanceLegalEntityId  String? @map("balance_legal_entity_id") @db.Uuid
  holdingCounterpartyId String? @map("holding_counterparty_id") @db.Uuid
  /**
   * Ответственный. Без FK (паттерн Employment.userId): увольнение не рвёт карточку.
   */
  custodianUserId       String? @map("custodian_user_id") @db.Uuid

  status String @default("active") // active | in_repair | stored | written_off | disposed

  purchasedOn    DateTime? @map("purchased_on") @db.Date
  commissionedOn DateTime? @map("commissioned_on") @db.Date
  warrantyUntil  DateTime? @map("warranty_until") @db.Date
  purchasePrice  BigInt?   @map("purchase_price")
  currency       String    @default("KZT")

  note       String?
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  model               AssetModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  branch              StaffBranch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parentAsset         Asset?               @relation("AssetTree", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children            Asset[]              @relation("AssetTree")
  balanceLegalEntity  LegalEntity?         @relation(fields: [balanceLegalEntityId], references: [id], onDelete: SetNull)
  holdingCounterparty Counterparty?        @relation(fields: [holdingCounterpartyId], references: [id], onDelete: SetNull)
  moves               AssetMove[]
  services            AssetServiceRecord[]

  @@index([workspaceId, branchId, status])
  @@index([modelId])
  @@index([parentAssetId])
  @@index([custodianUserId])
  @@index([balanceLegalEntityId])
  @@index([holdingCounterpartyId])
  @@map("assets")
}

/// ЖУРНАЛ движения (append-only): место / ответственный / владение / статус.
/// «Переместили» без записи о том, кто и когда, — потеря, а не экономия.
model AssetMove {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  assetId     String @map("asset_id") @db.Uuid
  kind        String // placement | custodian | holding | status

  fromBranchId      String? @map("from_branch_id") @db.Uuid
  toBranchId        String? @map("to_branch_id") @db.Uuid
  fromParentAssetId String? @map("from_parent_asset_id") @db.Uuid
  toParentAssetId   String? @map("to_parent_asset_id") @db.Uuid
  fromUserId        String? @map("from_user_id") @db.Uuid
  toUserId          String? @map("to_user_id") @db.Uuid
  fromValue         String? @map("from_value")
  toValue           String? @map("to_value")

  reason    String?
  movedById String   @map("moved_by_id") @db.Uuid
  movedAt   DateTime @default(now()) @map("moved_at")
  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, movedAt])
  @@index([workspaceId])
  @@map("asset_moves")
}

/// Обслуживание и ремонт — журнал; TCO = SUM(cost) по экземпляру.
model AssetServiceRecord {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  assetId     String @map("asset_id") @db.Uuid
  kind        String @default("repair") // maintenance | repair | inspection
  status      String @default("done") // planned | in_progress | done | cancelled

  title       String
  description String?
  scheduledOn DateTime? @map("scheduled_on") @db.Date
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  nextDueOn   DateTime? @map("next_due_on") @db.Date

  cost     BigInt?
  currency String  @default("KZT")

  performedByUserId String? @map("performed_by_user_id") @db.Uuid
  counterpartyId    String? @map("counterparty_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@index([assetId, scheduledOn])
  @@index([workspaceId, status, nextDueOn])
  @@index([counterpartyId])
  @@map("asset_service_records")
}

// ============================================================
// WALLET — currencies, typed accounts, immutable double-entry journal, escrow
// ============================================================
// Real-money-grade ledger (NOT a bank — but correct enough that real money via a future bank
// top-up can flow through it): a chart of typed Accounts, double-entry transfers (every movement
// balances within one currency), two-phase holds (pending → post/void), integer minor units with
// a per-currency scale, and no negative balances on user wallets.

// An issued currency. Exactly ONE active currency per issuer. Polymorphic issuer (user now;
// workspace later) → issuerId validated in the service, not an FK. Name/icon referenced by id
// everywhere (rename is retroactive, ≤1×/3 months). Deletion = soft-delete. `scale` is the
// ISO-4217-style minor-unit exponent (0 = whole coins; 2 = tenge/tiyin) — amounts are always
// integer minor units. `code` is an optional fiat code (e.g. 'KZT'); null for personal coins.
model Currency {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  issuerType   String  @map("issuer_type") // 'user' | 'workspace'
  issuerId     String  @map("issuer_id")
  name         String
  icon         String // emoji, no ticker
  code         String? // optional ISO-4217-style code for fiat (e.g. 'KZT'); null for personal coins
  scale        Int     @default(0) // minor-unit exponent: 0 = whole coins, 2 = tenge/tiyin
  currencyType String  @default("CUSTOM_COIN") @map("currency_type") // CUSTOM_COIN | FIAT…

  // B2B hook: who may see holders' balances (role/position matrix). null = personal rule
  // (balance visible to holder + issuer only). Unused this phase.
  visibilityPolicy Json? @map("visibility_policy")

  status        String    @default("active") // active | deleted
  lastRenamedAt DateTime? @map("last_renamed_at") // enforces the 1×/3-months rename limit

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts Account[]

  // "One active currency per issuer" is a PARTIAL unique index (WHERE status='active')
  // added in the migration — Prisma can't express partial uniques in-schema.
  @@index([issuerType, issuerId])
  @@index([status])
  @@map("currencies")
}

// Chart of accounts. Every balance is an Account of a TYPE — double-entry, so money never appears
// or vanishes: it only moves between accounts.
//   user      — a holder's wallet (a liability: we owe them this balance).
//   issuance  — the source coins are minted FROM (allowNegative: its balance goes negative by the
//               amount in circulation, offsetting all user balances → per-currency Σ = 0).
//   escrow / fee / external — reserved for later (marketplace fees, bank top-up/withdrawal rails).
// `balance` (posted, credit-normal: +credit / −debit) and `held` (Σ of this account's unresolved
// pending OUTGOING reservations) are a materialized cache; the journal is the truth. Row-locked on
// spend. available = balance − held; user wallets may not go negative (allowNegative = false).
// For system accounts (issuance/external/fee) ownerId = the currencyId (one per currency).
model Account {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  currencyId String @map("currency_id") @db.Uuid
  type       String // user | issuance | escrow | fee | external
  ownerType  String @map("owner_type") // user | workspace | system
  ownerId    String @map("owner_id") // userId / workspaceId; system accounts use the currencyId

  balance       BigInt  @default(0) // posted net (credit-normal)
  held          BigInt  @default(0) // Σ unresolved pending outgoing reservations
  allowNegative Boolean @default(false) @map("allow_negative")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([currencyId, type, ownerType, ownerId]) // one account per (currency, type, owner)
  @@index([ownerType, ownerId])
  @@index([currencyId, type])
  @@map("accounts")
}

// Immutable, append-only double-entry journal — the single source of truth for every balance. Rows
// are never updated or deleted; corrections are compensating rows. FK-free (hot writes; integrity
// enforced in LedgerService). Monotonic bigint PK (append-log ordering). Each row moves `amount`
// (positive integer minor units) from debitAccount to creditAccount within one currency. kind:
//   posted        — settles now (mint, P2P, payout, burn).
//   pending       — a hold/authorization: reserves on the debit account (held += amount) without
//                   settling. The escrow "freeze".
//   post_pending  — settles a prior pending (pendingId set); `amount` ≤ the pending amount.
//   void_pending  — cancels a prior pending (pendingId set): releases the reservation.
model LedgerTransfer {
  id              BigInt   @id @default(autoincrement())
  currencyId      String   @map("currency_id") @db.Uuid
  debitAccountId  String   @map("debit_account_id") @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  amount          BigInt // positive integer minor units
  kind            String // posted | pending | post_pending | void_pending
  pendingId       BigInt?  @map("pending_id") // the pending row this posts/voids
  agreementId     String?  @map("agreement_id") @db.Uuid // origin escrow agreement (task / order)
  idempotencyKey  String?  @unique @map("idempotency_key") // duplicate event collides here
  memo            String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([debitAccountId, id]) // history + balance recompute
  @@index([creditAccountId, id])
  @@index([currencyId])
  @@index([pendingId])
  @@index([agreementId])
  /// Поиск по времени в журнале, который только растёт (миграция core_lifecycle)
  @@index([createdAt], type: Brin)
  // Append-only: триггер `ledger_transfers_append_only` ENABLE ALWAYS (UPDATE/DELETE/TRUNCATE
  // запрещены — исправление только встречной проводкой), миграция core_lifecycle.
  // РУКОПИСНЫЙ partial unique (миграция 20260611000000, Prisma его не выражает):
  //   ledger_transfers_pending_resolution_key ON (pending_id) WHERE kind IN ('post_pending','void_pending')
  // — DB-ремень «pending закрывается ровно один раз» (двойная выплата невозможна).
  // При squash миграций / db pull индекс НЕ ТЕРЯТЬ.
  @@map("ledger_transfers")
}

// "Сделка" — an escrow agreement: the first-class grouping of the per-leg holds for ONE source
// (a task or a marketplace order). Thin by design: a status + a grouping anchor only. Crowdfunding
// target/progress are NOT stored here (a price can be multi-currency, e.g. 100🍎+50🌟, so a single
// number can't express the target) — the target lives on the priced source (the listing) and
// "collected" is Σ of the active holds per currency. The generic escrow engine (wallet) owns this;
// Tasks and Commerce are its two clients. refType discriminates the source kind.
model EscrowAgreement {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  refType   String   @map("ref_type") // 'task' | 'order'
  refId     String   @map("ref_id") // the task / order id
  status    String   @default("open") // open | settled | refunded | cancelled
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  holds EscrowHold[]

  @@unique([refType, refId]) // exactly one agreement per source; also serves lookups
  @@index([status])
  @@map("escrow_agreements")
}

// One leg of an agreement, backed by a two-phase transfer in the journal. The "freeze" is a
// `pending` transfer payer→beneficiary (reserves on the payer's account, no settlement yet). status
// mirrors the transfer: active (pending live) → captured (post_pending settled the payout) →
// released (void_pending refunded the reservation). `pendingTransferId` links the live pending row;
// `postedTransferId` is set on capture. A released leg can be re-activated (idempotent re-fund).
// One leg per (agreement, payer, beneficiary, currency): a task funds one leg per worker (payer =
// creator, single currency); a marketplace order funds one leg per payer × currency (crowdfunding =
// many payers; cross-currency price = many currencies; beneficiary = the seller).
model EscrowHold {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  agreementId       String   @map("agreement_id") @db.Uuid
  currencyId        String   @map("currency_id") @db.Uuid
  payerUserId       String   @map("payer_user_id") @db.Uuid // whose coins are frozen (user id, or workspace id if payerType=workspace)
  payerType         String   @default("user") @map("payer_type") // user | workspace (company treasury, B2B P9)
  beneficiaryUserId String   @map("beneficiary_user_id") @db.Uuid // who is paid on capture (user id, or workspace id if beneficiaryType=workspace)
  beneficiaryType   String   @default("user") @map("beneficiary_type") // user | workspace (company treasury, B2B P9)
  amount            BigInt
  status            String   @default("active") // active | captured | released
  pendingTransferId BigInt?  @map("pending_transfer_id") // the live pending transfer (the freeze)
  postedTransferId  BigInt?  @map("posted_transfer_id") // the post_pending settlement (enables collect-back)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agreement EscrowAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, payerUserId, beneficiaryUserId, currencyId]) // one leg per tuple; idempotent
  @@index([payerUserId, currencyId, status]) // "what I froze"
  @@index([currencyId, status]) // deleteCurrency release sweep
  @@index([agreementId, status]) // capture / release by agreement
  @@index([beneficiaryUserId, status])
  @@map("escrow_holds")
}

// ============================================================
// MY WISH & SHOP — shops, showcases, listings (Phase 2: catalog skeleton)
// ============================================================
// A personal/company storefront. 1 shop per owner (lazily created). Owner is polymorphic
// (user|workspace) — B2B isolation is by explicit ownership + authorization (NOT the workspace
// chokepoint; a shop is accessed by id, not as implicit "my data"). Staff are NOT here — they are
// UserRole rows (context 'shop'/'showcase'). Buying/escrow is Phase 3; the catalog lives here.
model Shop {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType String   @map("owner_type") // 'user' | 'workspace'
  ownerId   String   @map("owner_id") @db.Uuid
  name      String? // display name; null → fall back to the owner's name
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  showcases Showcase[]

  @@unique([ownerType, ownerId]) // one shop per owner
  @@map("shops")
}

// A "Витрина": a folder of listings inside a shop, switched in the left rail. Visibility is shared
// per-showcase to people and/or Circle Groups (mirrors calendar/card sharing) via the access
// engine (core/access); no grants → visible only to the owner + staff (no separate "draft" flag).
model Showcase {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([shopId])
  @@map("showcases")
}

// Showcase audiences migrated to the access engine (core/access) — ShowcaseShare dropped.
// Showcase visibility is now `showcase:<id>#viewer@user|circle#member` tuples.

// A lot. Full schema now; Phase 2 wires only catalog CRUD + display. Behaviour is added in later
// phases: purchase/escrow (P3), task/calendar fulfilment (P4), cross-currency price (P5),
// crowdfunding (P6), stock + time window + FOMO discount + auto-archive (P7), wishlist copy (P8).
model Listing {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  showcaseId   String  @map("showcase_id") @db.Uuid
  title        String
  description  String?
  icon         String? // emoji from the standard set
  itemType     String  @default("material") @map("item_type") // material | nonmaterial
  withTask     Boolean @default(false) @map("with_task") // creates a Task/Event on purchase (P4)
  taskDays     Int?    @map("task_days") // days to fulfil when withTask
  crowdfunding Boolean @default(false) // joint fundraising on the card (P6)

  // Availability (P7 behaviour; fields now). stockLimit null = infinite.
  stockLimit      Int?      @map("stock_limit")
  stockSold       Int       @default(0) @map("stock_sold")
  availableFrom   DateTime? @map("available_from")
  availableUntil  DateTime? @map("available_until")
  discountPercent Int?      @map("discount_percent") // FOMO discount
  discountUntil   DateTime? @map("discount_until")

  status           String   @default("active") // active | archived
  sourceWishItemId String?  @map("source_wish_item_id") @db.Uuid // origin wishlist item when copied (P8)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  showcase Showcase       @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  prices   ListingPrice[]
  orders   Order[]

  @@index([showcaseId, status])
  @@index([sourceWishItemId])
  @@map("listings")
}

// A price line item: the lot costs `amount` of `currencyId`. Multiple rows = combined cross-currency
// price (P5); Phase 2 uses a single line in the owner's own currency. FK-free to Currency (validated).
model ListingPrice {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String @map("listing_id") @db.Uuid
  currencyId String @map("currency_id") @db.Uuid
  amount     BigInt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, currencyId])
  @@index([currencyId])
  @@map("listing_prices")
}

// A purchase (Phase 3+5). One order = one listing, single buyer; the price is a SNAPSHOT of N
// currency lines (OrderPrice) — one line per currency (cross-currency = P5; single line in Phase 3).
// The price is held in escrow (EscrowAgreement refType='order', refId=order.id) as one leg per
// currency: frozen on placement, captured on confirm (instant items) or on task completion (material
// «с задачей», P4), refunded on reject/cancel. listingId is nullable (onDelete SetNull) so an order
// survives as history if its listing is later deleted — the title and price are snapshotted. seller =
// the shop owner (the coins' beneficiary), even when a co-manager confirms.
model Order {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId     String?   @map("listing_id") @db.Uuid
  titleSnapshot String    @map("title_snapshot")
  showcaseId    String    @map("showcase_id") @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid // single buyer; for crowdfunding = the campaign initiator
  sellerId      String    @map("seller_id") @db.Uuid // shop owner = escrow beneficiary (B2C: a user)
  status        String    @default("pending") // funding(P6) | pending | confirmed | settled | rejected | cancelled | refunded
  crowdfunding  Boolean   @default(false) // snapshot: a joint-funded campaign (P6) — see OrderContribution
  itemType      String    @map("item_type") // snapshot: material | nonmaterial
  withTask      Boolean   @default(false) @map("with_task") // snapshot
  taskId        String?   @map("task_id") @db.Uuid // fulfilment task (P4, material «с задачей»)
  taskDays      Int?      @map("task_days") // snapshot: days to fulfil → the auto-task due date
  eventId       String?   @map("event_id") // calendar event (P4, non-material «с задачей»)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  confirmedAt   DateTime? @map("confirmed_at")
  closedAt      DateTime? @map("closed_at") // settled / rejected / cancelled
  expiresAt     DateTime? @map("expires_at") // crowdfunding campaign deadline (P7); null = no auto-expiry

  listing       Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  prices        OrderPrice[]
  contributions OrderContribution[]

  @@index([shopId, status])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([listingId])
  @@index([taskId])
  // Раннер сроков: закрытые заказы старше срока (core/lifecycle)
  @@index([closedAt])
  @@map("orders")
}

// A pledge toward a crowdfunding campaign (P6): contributor freezes `amount` of `currencyId` (one
// escrow leg, payer=contributor → beneficiary=owner) under the campaign Order. Cross-currency goal →
// a contributor's pledge can span currencies (one row each). FK to Order cascade; FK-free to Currency
// (validated). All-or-nothing: legs captured to the owner only when EVERY goal currency is filled.
model OrderContribution {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  contributorId String   @map("contributor_id") @db.Uuid
  currencyId    String   @map("currency_id") @db.Uuid
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, contributorId, currencyId])
  @@index([orderId])
  @@index([contributorId])
  @@map("order_contributions")
}

// A wishlist item (Phase 8): something the OWNER wants. No price — a person from the owner's
// окружение turns it into a priced Listing in THEIR OWN shop (Listing.sourceWishItemId links back),
// so the wish auto-fulfils when that lot settles. The wishlist is shared to people/Groups via the
// access engine (resource `wishlist:<ownerId>`). itemType (material/nonmaterial) is set by the owner.
model WishItem {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  title       String
  description String?
  icon        String?
  link        String? // a URL the owner wants (optional)
  itemType    String    @default("material") @map("item_type") // material | nonmaterial
  status      String    @default("active") // active | fulfilled | archived
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  fulfilledAt DateTime? @map("fulfilled_at")

  @@index([ownerId, status])
  @@map("wish_items")
}

// A snapshotted price line of an order: the buyer pays `amount` of `currencyId`. Multiple rows =
// cross-currency price (P5). Mirrors ListingPrice and is FK-free to Currency (validated, not
// constrained) so a later currency deletion can't block order history. Each line is one escrow leg.
model OrderPrice {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  currencyId String @map("currency_id") @db.Uuid
  amount     BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, currencyId])
  @@index([currencyId])
  @@map("order_prices")
}

// ============================================================
// ACCESS: Unified authorization engine (ReBAC) — core/access
// ============================================================
// One uniform store of relationship tuples: "subject has <relation> on <resource>".
//   resourceType:resourceId # relation @ subjectType:subjectId(#subjectRelation)
// Permissions are DERIVED from these tuples + per-resource-type rewrite rules
// (core/access/access-schema.ts) — never stored. Pure-sharing data (CalendarShare,
// ShowcaseShare) migrates here (Phase 2); domain membership/roles are PROJECTED here
// and kept in sync (Phase 1). Cross-cutting — deliberately NOT in the workspace chokepoint.
//
//   subjectRelation = ""        → the subject is named directly (a user, or an object
//                                 such as a parent pointer showcase#parent@shop).
//   subjectRelation = "member"  → a userset: every subject holding that relation on the
//                                 subject object, e.g. circle:fam#member (all members of fam).
// ============================================================
// MESSENGER: Chats, members, messages (Phase 1: DM + spine)
// ============================================================

model Chat {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // dm | group | context
  type String @default("dm")

  // Canonical "minUserId:maxUserId" for DMs (unique → exactly one DM per pair). Null otherwise.
  dmKey String? @unique @map("dm_key")

  // Polymorphic parent for CONTEXT chats (null for DM/group).
  // parentType: task | calendar_event | listing | order | ...
  parentType String? @map("parent_type")
  parentId   String? @map("parent_id") @db.Uuid

  // Creator/owner of an ad-hoc group chat (null for dm/context). Owner has full management.
  createdById String? @map("created_by_id") @db.Uuid

  // B2B scoping (mirrors Task). Null = personal. Not chokepoint-scoped yet (B2B phase).
  workspaceId String? @map("workspace_id") @db.Uuid

  // Optional display title (group chats); DM/context derive it from peer/parent.
  title String?

  // Monotonic per-chat message counter; assigned to Message.seq under row lock.
  lastSeq Int @default(0) @map("last_seq")

  /// Таймер автоудаления сообщений (core/lifecycle Э5): 1 | 7 | 30 дней, null — выключен.
  /// CHECK chats_message_ttl_days_check — в миграции. Чтение режет старше сразу, раннер удаляет.
  messageTtlDays    Int?      @map("message_ttl_days")
  messageTtlSetById String?   @map("message_ttl_set_by_id") @db.Uuid
  messageTtlSetAt   DateTime? @map("message_ttl_set_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           ChatMember[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  // One context chat per parent (e.g. one chat per task). Postgres treats NULLs as
  // distinct, so DM/group chats (parentType/parentId NULL) are exempt and unconstrained.
  @@unique([parentType, parentId])
  @@index([type])
  @@index([workspaceId])
  @@map("chats")
}

model ChatMember {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chatId String @map("chat_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  // owner | admin | member | bot (group management + display)
  role String @default("member")

  // History floor: this member only sees messages with seq >= visibleFromSeq.
  // Set to chat.lastSeq when added to a group (WhatsApp-style join-point history); 0 = full history (DM, task chat).
  visibleFromSeq Int @default(0) @map("visible_from_seq")

  // Read-cursor model (D6): how far messages were delivered / read for this user.
  deliveredSeq Int       @default(0) @map("delivered_seq")
  deliveredAt  DateTime? @map("delivered_at")
  lastReadSeq  Int       @default(0) @map("last_read_seq")
  lastReadAt   DateTime? @map("last_read_at")

  // Per-user chat state.
  mutedUntil DateTime? @map("muted_until")
  pinned     Boolean   @default(false)
  archived   Boolean   @default(false)

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, archived])
  @@map("chat_members")
}

model Message {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chatId String @map("chat_id") @db.Uuid

  // Null for system messages (no human author).
  authorId String? @map("author_id") @db.Uuid

  // text | system | rich_card
  type String @default("text")

  // Plain text for text messages; JSON payload for system/rich_card.
  content String?
  payload Json?

  // Per-chat monotonic order; assigned from Chat.lastSeq under row lock.
  seq Int

  // Reply/quote (Phase 7): the message this one quotes (self-relation; null = not a reply).
  replyToId String? @map("reply_to_id") @db.Uuid

  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  chat    Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replyTo Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReply")

  @@unique([chatId, seq]) // also serves (chatId, seq) range scans — no separate index needed
  @@index([authorId])
  // FK reply_to_id (SET NULL) обязан иметь индекс: каскадное удаление чата на КАЖДУЮ
  // строку ищет ссылающиеся ответы — без индекса это полный скан messages × N строк.
  @@index([replyToId])
  @@map("messages")
}

// ============================================================
// SCHEDULED MESSAGES (Phase 7, "Напомнить"): a message the author schedules to be
// sent into a chat at a future time. A cron fires due ones → posts a normal Message
// from the author + pings the author. The author can view/edit/cancel while pending.
// ============================================================
model ScheduledMessage {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chatId   String @map("chat_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  content   String
  // Optional quote carried into the eventual message.
  replyToId String? @map("reply_to_id") @db.Uuid

  // When to send.
  sendAt DateTime @map("send_at")

  // pending | sending (claimed by a firing cron — transient) | sent | cancelled
  status        String  @default("pending")
  // The Message created when it fired (audit / dedup).
  sentMessageId String? @map("sent_message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  // @default(now()) mirrors the DB's `DEFAULT CURRENT_TIMESTAMP` (created in raw SQL)
  // so `migrate dev` sees no drift; @updatedAt keeps the app-side bump on write.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Cron scan: due pending rows.
  @@index([status, sendAt])
  @@index([chatId, authorId])
  // Раннер сроков: отправленные/отменённые (три статуса фильтра — порядок по updated_at)
  @@index([updatedAt])
  @@map("scheduled_messages")
}

// ============================================================

// ============================================================
// SEARCH INDEX (Phase 6): denormalized, permission-trimmed search "витрина" for the
// unified core/search engine. One row per searchable item across services (messenger
// now; tasks/events/etc. later). The index is a PROJECTION — domain tables stay the
// source of truth; rows are kept fresh by best-effort hooks + a reconcile cron + a
// backfill script (same pattern as core/access). FTS (generated `tsvector`, 'russian'
// config for word-form stemming) + pg_trgm GIN (typo/substring/name match, language-
// agnostic for KZ/EN) live in raw SQL (the migration); SearchService queries via $queryRaw.
// ============================================================
model SearchDocument {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // Provider/source kind: message | chat | (task | event | wish … later).
  sourceType String @map("source_type")
  // The domain entity id this row mirrors.
  sourceId   String @map("source_id")

  // B2B scoping (null = personal/social). Mirrors the entity's workspace.
  workspaceId String? @map("workspace_id") @db.Uuid

  // Searchable text: title (chat name, task title…) + body (message text, description…).
  title String?
  body  String?

  // Deep link to open the result.
  url String

  // Access keys (provider-specific, used to permission-trim at query time):
  // message/chat → chatId; message → seq (vs ChatMember.visibleFromSeq); author for display.
  chatId   String? @map("chat_id") @db.Uuid
  seq      Int?
  authorId String? @map("author_id") @db.Uuid

  // The ENTITY's timestamp (NOT row-insert time) — drives recency ranking.
  itemCreatedAt DateTime @map("item_created_at")

  createdAt DateTime @default(now()) @map("created_at")
  // @default(now()) mirrors the DB's `DEFAULT CURRENT_TIMESTAMP` (created in raw SQL)
  // so `migrate dev` sees no drift; @updatedAt keeps the app-side bump on write.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Generated FTS column (Postgres `GENERATED ALWAYS AS (...) STORED`), maintained by
  // the DB and never written by Prisma (Unsupported fields are excluded from writes).
  // Prisma's schema-engine reads a generated column's expression as a column DEFAULT, so
  // declaring the SAME expression via @default(dbgenerated(...)) makes `migrate dev` see
  // no drift (otherwise it emits a failing `ALTER COLUMN ... DROP DEFAULT`). The string is
  // Prisma's own round-tripped form of the expression in migrations/20260601160000_search.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body, ''::text)))")) @map("search_vector")

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([chatId])
  // GIN indexes created in raw SQL (migrations/20260601160000_search) — declared here so
  // `migrate dev` does not try to drop them. trgm for typo/substring/name matching; the
  // searchVector GIN (default tsvector_ops) backs FTS ranking.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "search_documents_title_trgm_idx", type: Gin)
  @@index([body(ops: raw("gin_trgm_ops"))], map: "search_documents_body_trgm_idx", type: Gin)
  @@index([searchVector], type: Gin)
  // Частичный индекс каскада организации (миграция lifecycle_purge_runner, руками):
  //   search_documents_workspace_id_idx (workspace_id) WHERE workspace_id IS NOT NULL
  @@map("search_documents")
}

model RelationTuple {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resourceType    String   @map("resource_type")
  resourceId      String   @map("resource_id")
  relation        String
  subjectType     String   @map("subject_type")
  subjectId       String   @map("subject_id")
  subjectRelation String   @default("") @map("subject_relation")
  createdAt       DateTime @default(now()) @map("created_at")

  // One row per distinct edge. subjectRelation defaults to "" (never NULL) so the unique
  // constraint is deterministic for direct subjects (avoids Postgres NULL-distinct gotcha).
  @@unique([resourceType, resourceId, relation, subjectType, subjectId, subjectRelation])
  // Forward walk: who has <relation> on <resource> (expand a resource's relation).
  @@index([resourceType, resourceId, relation])
  // Reverse walk: every edge a subject appears in (group expansion, parent pointers, listObjects).
  @@index([subjectType, subjectId])
  // listObjects fast path: resources of a type where a subject is named for a relation.
  @@index([subjectType, subjectId, resourceType, relation])
  @@map("relation_tuples")
}

// ============================================================
// CARD SKINS — cosmetic skins for PersonCard (platform-sold)
//
// CardSkin = the DESIGN/type (tokens + layer assets, rarity, price, supply).
// CardSkinInstance = an owned copy ("real item"): serial for limited skins,
//   transfer history → future gift/trade. Purchases use the platform currency
//   via the Ledger (issuerType='platform'); no escrow (instant), trade later.
// ============================================================

model CardSkin {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?
  // Author of the design — shown nowhere in UI; set manually for collabs.
  authorId    String? @map("author_id") @db.Uuid
  rarity      String  @default("common") // common|uncommon|rare|epic|legendary|mythic
  priceAmount BigInt  @default(0) @map("price_amount") // platform-currency minor units

  // Supply: null = unlimited; a number = limited tirage. `minted` counts issued copies
  // (drives serial numbers and sold-out). Optional sales window.
  supply         Int?
  minted         Int       @default(0)
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")

  // Render layers — tokens (CardSkinTokens JSON) + optional assets. Skin = DATA.
  tokens        Json
  decor         String  @default("none") // 'crayon' | 'none'
  frameUrl      String? @map("frame_url")
  backgroundUrl String? @map("background_url")
  effectUrl     String? @map("effect_url") // Lottie JSON URL
  schemaVersion Int     @default(1) @map("schema_version")

  status    String   @default("active") // active | archived
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instances CardSkinInstance[]

  @@index([status])
  @@map("card_skins")
}

model CardSkinInstance {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  skinId        String   @map("skin_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  serial        Int? // only set for limited skins (#N of supply)
  acquiredVia   String   @default("purchase") @map("acquired_via") // purchase | gift | trade | grant
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at")

  skin      CardSkin           @relation(fields: [skinId], references: [id], onDelete: Cascade)
  transfers CardSkinTransfer[]

  // Defense-in-depth: a limited skin can't issue the same serial twice. NULL serials
  // (unlimited skins) are treated as distinct by Postgres, so they're unaffected.
  @@unique([skinId, serial], map: "card_skin_instances_skin_serial_key")
  @@index([ownerId])
  @@index([skinId])
  @@map("card_skin_instances")
}

model CardSkinTransfer {
  id         BigInt   @id @default(autoincrement())
  instanceId String   @map("instance_id") @db.Uuid
  fromUserId String?  @map("from_user_id") @db.Uuid // null = minted by the platform
  toUserId   String   @map("to_user_id") @db.Uuid
  kind       String // mint | gift | trade | sale
  createdAt  DateTime @default(now()) @map("created_at")

  instance CardSkinInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("card_skin_transfers")
}

// ============================================================
// PROCESSES — нодовый движок бизнес-процессов (Фаза 1, B2B)
// Документ-канвас (nodes/edges/form) живёт в ProcessVersion.document;
// исполнение — token-движок строками БД (instance + step runs).
// Кросс-агрегатные ссылки (user/workspace) — плоскими id, как в RelationTuple.
// ============================================================

model ProcessDefinition {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String  @map("workspace_id") @db.Uuid
  name             String
  description      String?
  // 'team' — по командным правилам (manager+ редактирует, команда видит/запускает);
  // 'admins' — виден и запускается только admin+ («процессы для разработчиков»).
  visibility       String  @default("team")
  // Профиль редактора: какой НАБОР НОД показывать и какие правила предметной области
  // проверять. 'general' — полный канвас Процессов; 'documents.hr' — урезанный для
  // кадровых маршрутов (кадровик не видит ноды про счета и AI-агентов).
  // Ключ = категория вида документа, поэтому новая область — строка, а не правка палитры.
  surface          String  @default("general")
  status           String  @default("active") // active | archived
  currentVersionId String? @map("current_version_id") @db.Uuid // активная (опубликованная) версия
  createdById      String  @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions  ProcessVersion[]
  instances ProcessInstance[]
  triggers  ProcessTrigger[]

  @@index([workspaceId, status])
  @@map("process_definitions")
}

model ProcessVersion {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  version      Int
  status       String    @default("draft") // draft | published | superseded
  document     Json // канвас-документ (nodes/edges/form) — источник правды, канвас лишь его рисует
  compiled     Json? // скомпилированный план исполнения (заполняется при публикации)
  createdById  String    @map("created_by_id") @db.Uuid
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  definition ProcessDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  instances  ProcessInstance[]

  @@unique([definitionId, version])
  @@index([definitionId, status])
  @@map("process_versions")
}

model ProcessInstance {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  versionId    String    @map("version_id") @db.Uuid // pin: запущенный процесс доживает на своей версии (модель Salesforce Flow)
  workspaceId  String    @map("workspace_id") @db.Uuid
  status       String    @default("running") // running | done | cancelled | error
  variables    Json      @default("{}") // анкета процесса (значения стартовой формы)
  error        String?
  // Монотонный счётчик всех порождённых шагов (стоп-кран от бесконечных циклов).
  // Инкрементится в транзакции спавна → O(1) на переход вместо COUNT(*) (P8/A5).
  stepsSpawned Int       @default(1) @map("steps_spawned")
  startedById  String    @map("started_by_id") @db.Uuid // «от имени кого» бежит процесс (для триггеров — runAs)
  triggerType  String    @default("manual") @map("trigger_type") // manual | event | schedule | webhook
  wakeAt       DateTime? @map("wake_at") // будильник крона (таймеры/SLA — Фаза 2)
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  definition ProcessDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version    ProcessVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps      ProcessStepRun[]

  @@index([workspaceId, status])
  @@index([definitionId, status])
  @@index([startedById])
  @@index([wakeAt])
  // FK version_id (Cascade): без индекса удаление/архив версии сканирует таблицу.
  @@index([versionId])
  @@map("process_instances")
}

model ProcessStepRun {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  instanceId String  @map("instance_id") @db.Uuid
  nodeId     String  @map("node_id") // id ноды в документе версии
  nodeType   String  @map("node_type") // снимок типа ноды (списки без джойна версии)
  label      String? // снимок подписи ноды (P7): журнал/детали не парсят документ версии
  status     String  @default("active") // active | done | error | cancelled

  // Активирован = side-effect шага (создание задачи/уведомление/таймер) уже отработал.
  // kick перезапускает только НЕ активированные ожидания (auto-ноды по флагу auto).
  activated Boolean @default(false)

  // Аренда шага (P3): взявший kick ставит leasedUntil перед внешним I/O (HTTP/LLM) и
  // отпускает per-instance лок на время вызова. Параллельный kick/крон пропускает
  // залоченный шаг (leasedUntil > now) — дорогая нода не задваивается, даже если
  // TTL инстанс-лока истёк под долгим агентом. По истечении аренды крон переберёт.
  leasedUntil DateTime? @map("leased_until")

  // Аудит/«секундомер отделов»: каждый шаг сам считает своё время.
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  outcome String? // выходной порт, по которому ушёл токен ('main' / 'true' / 'false')
  output  Json?
  error   String?

  taskId       String? @unique @map("task_id") @db.Uuid // человеческий шаг → реальная задача Задачника
  assigneeId   String? @map("assignee_id")
  sourceStepId String? @map("source_step_id") @db.Uuid // какой шаг породил этот (аудит токен-движка)

  // Ф2.5 — параллель: сколько токенов уже пришло в join-ноду (ждёт joinExpected).
  joinArrivals Int @default(0) @map("join_arrivals")

  // Ф2 — человеческие процессы:
  departmentId String?   @map("department_id") @db.Uuid // задача на отдел (очередь): кто может claim
  claimedById  String?   @map("claimed_by_id") @db.Uuid // кто забрал задачу отдела из очереди
  claimedAt    DateTime? @map("claimed_at")
  decision     String? // одобрение: approved | rejected (снимок решения)
  deadlineAt   DateTime? @map("deadline_at") // SLA человеческого шага ИЛИ время побудки паузы
  escalatedAt  DateTime? @map("escalated_at") // когда отправлена эскалация просрочки (дедуп)

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, status])
  @@index([assigneeId])
  // Кроны сканируют активные шаги (добивка + сверка задач) — без status-ведущего
  // индекса это seq-scan вечно растущей таблицы.
  @@index([status, startedAt])
  // Таймеры паузы + эскалация SLA сканируют дедлайны.
  @@index([deadlineAt])
  // «Входящие отдела»: claimable-шаги по отделу.
  @@index([departmentId])
  // РУКОПИСНЫЕ partial-индексы (Prisma их не выражает; при squash / db pull НЕ ТЕРЯТЬ):
  //   process_step_runs_active_join_key  UNIQUE (instance_id, node_id) WHERE status='active'
  //     (миграция 20260701175000) — join-нода копит токены в ОДНОЙ строке;
  //   process_step_runs_claimable_idx    ON (department_id, status) WHERE task_id IS NULL
  //     (миграция 20260701190000) — «Входящие отдела» без скана.
  @@map("process_step_runs")
}

// ============================================================
// PROCESSES Ф3 — триггеры запуска + сейф кредов
// ============================================================

model ProcessTrigger {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId    String    @map("definition_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  type            String // event | schedule | webhook
  enabled         Boolean   @default(true)
  // Тип события для event-триггера (P4): денормализован из config в колонку → роутер
  // фильтрует индексом, а не JSONB-path-запросом. Заполняется при публикации.
  eventType       String?   @map("event_type")
  // event: {nodeId, eventType}; schedule: {nodeId, everyValue, everyUnit}; webhook/telegram: {nodeId, credentialId?}
  config          Json      @default("{}")
  // Секрет публичного эндпоинта: в колонке — SHA-256 hex сырого токена (lookup по равенству),
  // сам токен — в webhookTokenEnc (envelope core/keys, показывается редакторам холста).
  // Строки прошлой эпохи держат сырой токен (32 символа base64url) до бэкфилла.
  webhookToken    String?   @unique @map("webhook_token")
  webhookTokenEnc String?   @map("webhook_token_enc")
  // Telegram: момент регистрации вебхука с secret_token (проверяется заголовком приёмника);
  // NULL = зарегистрирован без секрета (до движка ключей) — крон перерегистрирует.
  webhookSecretAt DateTime? @map("webhook_secret_at")
  runAsUserId     String    @map("run_as_user_id") // процесс запускается «от имени» этого сотрудника
  nextRunAt       DateTime? @map("next_run_at") // schedule: следующий запуск
  lastRunAt       DateTime? @map("last_run_at")
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  definition ProcessDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, enabled])
  @@index([type, enabled, nextRunAt]) // schedule-крон
  @@index([workspaceId, type, enabled, eventType]) // P4: роутер событий по индексу
  @@index([definitionId])
  @@map("process_triggers")
}

model ProcessCredential {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  type        String // header | basic | bearer
  // Envelope core/keys (`sa6e:`, KEK организации, AAD = строка); прошлый формат
  // base64(iv).base64(tag).base64(ct) читается на legacy-окне и перешивается джобом.
  data        String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("process_credentials")
}

// ============================================================
// ФИНАНСЫ (B2C) — managerial accounting book
// ============================================================
// An EDITABLE bookkeeping book with a double-entry STRUCTURE (Firefly III / QuickBooks
// model) — records about the OUTSIDE world (cash, bank card). Kept strictly separate
// from the wallet's immutable settlement ledger (coins): the wallet never gains rows
// here, Финансы shows coins as a read-only projection. Edits are allowed (soft delete)
// and every change lands in FinAuditLog — the bookkeeping answer to immutability.

// One book per owner (user today; workspace = the B2B path, created lazily by the
// Processes "record operation" node / future B2B UI). Ownership never moves (PRD).
model FinBook {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType String   @default("user") @map("owner_type") // 'user' | 'workspace'
  ownerId   String   @map("owner_id") @db.Uuid
  // АВТОимя платформы (человек книгу не переименовывает): хранится в языке
  // ИСТОЧНИКА, а показывается в языке зрителя — `FinancesService.bookName`.
  // Дефолт БД — машинный запасной путь для строки, заведённой мимо сервиса.
  name      String   @default("My finances")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts       FinAccount[]
  transactions   FinTransaction[]
  budgets        FinBudget[]
  people         FinPerson[]
  recurringRules FinRecurringRule[]

  @@unique([ownerType, ownerId]) // one book per owner
  @@map("fin_books")
}

// "Everything is an account" (Firefly III): asset (Наличные/Карта) and liability (долги)
// are the money sides; expense/income accounts ARE the categories (2-level tree via
// parentId); equity is the hidden opening-balance peg. Category rows ignore currencyCode
// (the transaction carries the money-side currency). Liability rows carry the debt
// passport (total / monthly / months / due day) — the remaining debt is the account's
// balance, never a mutable counter.
model FinAccount {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId       String  @map("book_id") @db.Uuid
  kind         String // asset | liability | expense | income | equity
  subtype      String? // asset: cash|card|savings|other; liability: installment|loan
  parentId     String? @map("parent_id") @db.Uuid // category tree (expense/income only)
  name         String
  icon         String?
  currencyCode String  @default("KZT") @map("currency_code")
  archived     Boolean @default(false)
  isSystem     Boolean @default(false) @map("is_system") // seeded equity account
  sortOrder    Int     @default(0) @map("sort_order")

  // Debt passport (kind = liability): рассрочка (installment) / кредит деньгами (loan).
  debtTotal      BigInt?   @map("debt_total") // full obligation in minor units
  debtMonthly    BigInt?   @map("debt_monthly") // monthly payment
  debtMonths     Int?      @map("debt_months")
  debtDueDay     Int?      @map("debt_due_day") // day of month the payment is due
  debtClosedAt   DateTime? @map("debt_closed_at")
  debtRemindedAt DateTime? @map("debt_reminded_at") // dedup: one payment_due reminder per day

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book     FinBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent   FinAccount?      @relation("FinCategoryTree", fields: [parentId], references: [id])
  children FinAccount[]     @relation("FinCategoryTree")
  txFrom   FinTransaction[] @relation("FinTxFrom")
  txTo     FinTransaction[] @relation("FinTxTo")

  @@index([bookId, kind])
  @@index([parentId])
  @@map("fin_accounts")
}

// One movement of value from one account to another (the double-entry pair). The type
// (расход/доход/перевод/платёж по долгу…) is DERIVED from the from→to kinds, never stored.
// amount is denominated in the money-side currency (from for expenses/transfers, to for
// income); amountTo is set only for cross-currency money→money moves (обмен: two sums, no
// FX rates). Rows are soft-deleted (deletedAt) and every create/update/delete is audited.
model FinTransaction {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId          String    @map("book_id") @db.Uuid
  fromAccountId   String    @map("from_account_id") @db.Uuid
  toAccountId     String    @map("to_account_id") @db.Uuid
  amount          BigInt // positive integer minor units (money-side currency)
  amountTo        BigInt?   @map("amount_to") // cross-currency: amount in the to-account currency
  currencyCode    String    @map("currency_code") // denormalized money-side currency
  occurredOn      DateTime  @map("occurred_on") @db.Date // date-only bookkeeping
  note            String?
  personUserId    String?   @map("person_user_id") @db.Uuid // «на кого / от кого» — private analytics link
  personName      String?   @map("person_name") // snapshot (history survives Circle changes)
  createdById     String    @map("created_by_id") @db.Uuid
  source          String    @default("manual") // manual | recurring | process | service | import
  recurringRuleId String?   @map("recurring_rule_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  book        FinBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fromAccount FinAccount @relation("FinTxFrom", fields: [fromAccountId], references: [id])
  toAccount   FinAccount @relation("FinTxTo", fields: [toAccountId], references: [id])

  @@index([bookId, occurredOn])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([bookId, personUserId])
  // Частичный индекс шага finances.trash (миграция lifecycle_purge_runner, руками):
  //   fin_transactions_deleted_at_idx (deleted_at) WHERE deleted_at IS NOT NULL
  @@map("fin_transactions")
}

// План-факт: a monthly limit for one category (or subcategory) in one currency.
// A parent-category limit counts its children's spending too (report-side aggregation).
model FinBudget {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId            String   @map("book_id") @db.Uuid
  categoryAccountId String   @map("category_account_id") @db.Uuid
  period            String // 'YYYY-MM'
  amount            BigInt // minor units
  currencyCode      String   @default("KZT") @map("currency_code")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  book FinBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, categoryAccountId, period])
  @@map("fin_budgets")
}

// «Близкие» — the curated quick-pick list for the «на кого» field (owner builds it from
// Circle). A name snapshot keeps history readable if the contact link is later severed.
model FinPerson {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String // snapshot
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  book FinBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@map("fin_people")
}

// Повторяющиеся операции: a transaction template fired by FinanceCron. autoRecord=true
// writes the row silently (fixed sums: подписки/аренда); autoRecord=false sends a
// reminder with a one-tap confirm (плавающие суммы + платежи по долгам).
model FinRecurringRule {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId        String    @map("book_id") @db.Uuid
  title         String
  fromAccountId String    @map("from_account_id") @db.Uuid
  toAccountId   String    @map("to_account_id") @db.Uuid
  amount        BigInt
  amountTo      BigInt?   @map("amount_to")
  note          String?
  personUserId  String?   @map("person_user_id") @db.Uuid
  personName    String?   @map("person_name")
  interval      String // monthly | weekly
  dayOfMonth    Int?      @map("day_of_month") // monthly: 1..31 (clamped to month end)
  weekday       Int? // weekly: 1..7 (ISO)
  autoRecord    Boolean   @default(true) @map("auto_record")
  active        Boolean   @default(true)
  nextRunAt     DateTime  @map("next_run_at")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  book FinBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt]) // cron sweep
  @@index([bookId])
  @@map("fin_recurring_rules")
}

// The bookkeeping audit trail: who created/updated/deleted what (before/after snapshots,
// BigInt → number). FK-free on purpose (like ledger_transfers) — audit rows outlive edits.
model FinAuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookId     String   @map("book_id") @db.Uuid
  entityType String   @map("entity_type") // transaction | account | budget | recurring | debt
  entityId   String   @map("entity_id")
  userId     String   @map("user_id") @db.Uuid
  action     String // create | update | delete
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([bookId, createdAt])
  @@index([entityType, entityId])
  @@map("fin_audit_logs")
}

// ============================================
// CHATTER ENGINE (core/chatter) — «Хроника записи», 9-й платформенный движок
// Универсальная лента «кто/что/когда + было → стало» на любой сущности.
// Полиморфно по refType+refId (как FileLink), FK-free (как fin_audit_logs) —
// хроника переживает свои сущности. Пишется СИНХРОННО в транзакции доменной
// мутации (шина at-most-once и без old-значений не годится). Доступ на чтение —
// canView-резолвер потребителя (ChatterRefRegistry, паттерн FilesRefRegistry).
// Плашки контекстных чатов = проекция записей: needsChatPost → джоб chatter.chatpost
// движка core/jobs, поставленный В ТОЙ ЖЕ транзакции (outbox); дедуп мессенджера
// по chatterEntryId. НЕ в chokepoint; workspaceId — денормализация для «Журнала организации».
// ============================================

model ChatterEntry {
  id            BigInt    @id @default(autoincrement()) // append-log; он же курсор
  refType       String    @map("ref_type") // 'task' | 'workspace' | ...
  refId         String    @map("ref_id")
  workspaceId   String?   @map("workspace_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid // null = система (крон/движок)
  actorName     String?   @map("actor_name") // снапшот — переживает удаление аккаунта
  typeKey       String    @map("type_key") // ключ CHATTER_REGISTRY: 'task.deadline_changed', 'staff.role_changed'…
  changes       Json? // [{field,label,from,to}] — display-ready строки
  payload       Json? // переменные шаблона: targetUserId, targetName, branchName…
  needsChatPost Boolean   @default(false) @map("needs_chat_post")
  chatPostedAt  DateTime? @map("chat_posted_at") // терминал успешной проекции в чат (ремень идемпотентности хэндлера джоба)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([refType, refId, id]) // хроника записи (keyset DESC)
  @@index([workspaceId, id]) // журнал организации (keyset DESC)
  @@index([workspaceId, typeKey, id]) // журнал с фильтром category → typeKey IN
  // Частичный индекс незапощенных плашек (id) WHERE needs_chat_post AND chat_posted_at IS NULL —
  // держит ~0 строк; пересоздан руками в миграции jobs_engine (бэкфилл/страховка движка джобов).
  // Частичный индекс псевдонимизации следа стёртого актора (миграция lifecycle_actor_indexes, руками):
  //   chatter_entries_actor_id_idx (actor_id) WHERE actor_id IS NOT NULL
  // GIN chatter_entries_person_ids_idx на chatter_person_ids(payload, changes) — id людей, чьи имена
  // лежат в payload/changes (стирание человека находит их без скана); выражение — руками в миграции
  // 20260927000100 (Prisma его не выражает), ключи — packages/shared/src/lifecycle/person-refs.ts
  @@map("chatter_entries")
}

// ============================================
// JOBS ENGINE (core/jobs) — фоновые джобы / transactional outbox, 10-й платформенный движок
// Модель Oban/River/Solid Queue: джоб ставится В ТОЙ ЖЕ транзакции, что и доменная
// мутация (enqueue(tx, …): коммит = джоб есть, откат = джоба нет), исполнение
// at-least-once — claim пачкой FOR UPDATE SKIP LOCKED, attempts инкрементится ПРИ
// клейме и служит клейм-токеном финальных записей (поздний зомби-врайт = no-op),
// аренда leaseUntil → reaper, экспоненциальный бэкофф с джиттером, dead-letter.
// Статусы: available | executing | completed | discarded | cancelled
// («retryable» видно по attempts>0, «scheduled» — по runAt>now). НЕ в chokepoint.
// payload — только id-шки, не объекты (правило Sidekiq). Обработчики — JobsRegistry.
// ============================================

model Job {
  id          BigInt    @id @default(autoincrement())
  type        String // ключ обработчика в JobsRegistry: 'messenger.scheduled.fire', 'chatter.chatpost'…
  queue       String    @default("default") // группа concurrency (per-queue cap, модель Solid Queue)
  payload     Json      @default("{}")
  status      String    @default("available") // available | executing | completed | discarded | cancelled
  priority    Int       @default(0) // 0 = самый высокий (модель Oban)
  runAt       DateTime  @default(now()) @map("run_at") // видимость: отложенный запуск и бэкофф ретраев
  attempts    Int       @default(0) // инкремент при клейме = клейм-токен поздних записей
  maxAttempts Int       @default(5) @map("max_attempts")
  leaseUntil  DateTime? @map("lease_until") // протухла у executing → reaper вернёт в очередь/похоронит
  uniqueKey   String?   @map("unique_key") // идемпотентная постановка/отмена; unique среди живых (partial, руками)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  finishedAt  DateTime? @map("finished_at")

  // ВНИМАНИЕ: новая NOT NULL-колонка ОБЯЗАНА иметь DEFAULT — иначе сломается сырой
  // INSERT в JobsService.enqueue (он перечисляет колонки руками, т.к. ON CONFLICT
  // DO NOTHING иначе не выразить), причём сломается внутри чужих доменных транзакций.
  // Партиальные индексы — руками в миграции jobs_engine (Prisma не выражает WHERE):
  //   jobs_claim_idx        (queue, priority, run_at, id)  WHERE status='available'
  //   jobs_lease_idx        (lease_until)                   WHERE status='executing'
  //   jobs_unique_key_live  UNIQUE (type, unique_key)       WHERE status IN ('available','executing') AND unique_key IS NOT NULL
  //   jobs_retention_idx    (status, finished_at)           WHERE status IN ('completed','discarded','cancelled')
  @@map("jobs")
}

// ============================================
// FILES ENGINE (core/files) — платформенное хранилище файлов
// Метаданные здесь; байты — у драйвера (local disk | S3-совместимое хранилище).
// Доступ: владелец/загрузивший/public + наследование от привязанной сущности
// через FilesRefRegistry (без tuple-проекции — родитель = источник истины).
// ============================================

model FileObject {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType     String    @map("owner_type") // user | workspace
  ownerId       String    @map("owner_id") @db.Uuid
  uploaderId    String    @map("uploader_id") @db.Uuid
  profile       String    @default("generic") // ключ FILE_PROFILES (shared)
  kind          String // image | video | audio | document | other
  name          String // оригинальное имя — только метаданные, в storageKey не попадает
  mime          String
  size          BigInt
  sha256        String?
  status        String    @default("uploading") // uploading | ready | failed | deleted
  visibility    String    @default("private") // private | public
  publicToken   String?   @unique @map("public_token") // неугадываемый токен вечной публичной ссылки
  scanStatus    String    @default("none") @map("scan_status") // none | pending | clean | infected | skipped (политика shouldScanFile)
  storageDriver String    @map("storage_driver") // local | s3
  storageKey    String    @map("storage_key")
  uploadId      String?   @map("upload_id") // S3 multipart upload id (живёт пока uploading)
  meta          Json? // width/height/durationMs/pipeline/retries...
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  readyAt       DateTime? @map("ready_at")
  deletedAt     DateTime? @map("deleted_at")

  links        FileLink[]
  variants     FileVariant[]
  transcript   VoiceTranscript?
  driveNodes   DriveNode[]
  driveVersion DriveNodeVersion[]

  @@index([ownerType, ownerId, status])
  @@index([status, createdAt]) // крон-свипы: зависшие uploading / просроченные deleted
  @@index([uploaderId])
  // Дедуп «у вас уже есть такой файл» — ТОЛЬКО в пределах владельца: глобальный поиск
  // по хэшу превратил бы sha256 в оракул «есть ли на платформе вот этот файл».
  @@index([ownerType, ownerId, sha256])
  @@map("file_objects")
}

model FileLink {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  refType     String   @map("ref_type") // chat_message | task | listing | ... (резолвер в FilesRefRegistry)
  refId       String   @map("ref_id")
  role        String   @default("attachment") // attachment | avatar | gallery | ...
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, refType, refId, role])
  @@index([refType, refId])
  @@map("file_links")
}

model FileVariant {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  kind       String // thumb | medium | poster | waveform | text | pdf
  storageKey String   @map("storage_key")
  mime       String
  size       BigInt
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind])
  @@map("file_variants")
}

// Счётчик занятого места на владельца: инкременты в одной транзакции с
// complete/softDelete, ночная сверка кроном (пересчёт от file_objects).
// Расход места на Диске — `QuotaCounter` движка core/entitlements (ключи
// `files.storageBytes` и `files.count` на владельца файлов).

// ============================================
// VOICE ENGINE (core/voice) — 7-й платформенный движок: транскрипция аудио
// Транскрипт ключуется по файлу (1 файл = 1 расчёт навсегда); джоб и результат
// в одной строке — клейм status-guarded updateMany (дисциплина FilesScanHook).
// Доступ к транскрипту = доступ к файлу (резолвер привязки в FilesRefRegistry).
// ============================================

model VoiceTranscript {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId           String    @unique @map("file_id") @db.Uuid
  status           String    @default("queued") // queued | processing | ready | error
  language         String? // запрошенный язык: auto | ru | kk | en
  detectedLanguage String?   @map("detected_language") // что определил STT (ISO-код)
  text             String?   @db.Text
  segments         Json? // [{start,end,text,speaker?}]
  provider         String? // драйвер: openai_compatible | mock
  model            String?
  durationMs       Int?      @map("duration_ms")
  diarize          Boolean   @default(false)
  error            String?
  attempts         Int       @default(0) // счётчик попыток джоба (для UI/дебага; ставится из ctx.attempt)
  requestedById    String    @map("requested_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  readyAt          DateTime? @map("ready_at")

  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt]) // бэкфилл на старте: незавершённые queued|processing
  @@map("voice_transcripts")
}

// Запись Диктофона: владелец + титул; файл привязан FileLink'ом
// refType='voice_recording' (без прямого FK — паттерн движка файлов).
model VoiceRecording {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  // ПУСТО = названия нет, оно собирается ПРИ ЧТЕНИИ в языке зрителя («Запись 05.09.2026
  // 21:07» / «Recording …»). Хранить автоимя значило бы запереть его в языке, который
  // был у человека в момент создания: сменив язык, он остался бы со старой лентой.
  // Непустое — имя, введённое руками (его не трогаем никогда).
  title           String?
  // Момент, который НАЗЫВАЕТ автоимя. У записи звонка это начало разговора: createdAt
  // у неё — когда запись доехала из егресса, то есть уже после конца звонка. Пусто → createdAt.
  titleAt         DateTime? @map("title_at")
  source          String    @default("upload") // upload | web | terminal | call («Журнал звонков»)
  language        String? // предпочтительный язык расшифровки
  // «Журнал звонков»: source='call' + ссылка на запись движка звонков (без FK —
  // движок не знает потребителей). Файл ОБЩИЙ у всех клеймантов (общий транскрипт).
  callRecordingId String?   @map("call_recording_id") @db.Uuid
  // длительность НЕ дублируется колонкой: источник правды — meta файла (конвейер)
  // с добором из транскрипта (STT посчитал), см. RecorderService.serialize
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// Мягкое скрытие (корзина 30 дней): восстанавливаемо, затем раннер purge (core/lifecycle).
  /// Частичный индекс `(deleted_at) WHERE deleted_at IS NOT NULL` — руками в миграции.
  deletedAt       DateTime? @map("deleted_at")

  @@unique([callRecordingId, ownerId]) // идемпотентность доставки клейма (NULL не конфликтует)
  @@index([ownerId, createdAt])
  @@map("voice_recordings")
}

// ============================================
// CALLS ENGINE (core/calls) — 8-й платформенный движок: аудио/видеозвонки (LiveKit).
// Сессия = один созвон, привязана к сущности-родителю полиморфно (refType+refId,
// паттерн FileLink/EscrowAgreement — без FK на доменные таблицы); доступ решает
// резолвер потребителя (CallsRefRegistry). Комната LiveKit живёт от первого токена
// до room_finished; истина о статусе — эта таблица (вебхуки + крон-реконсиляция).
// ============================================

model CallSession {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roomName     String    @unique @map("room_name") // имя комнаты LiveKit = call_<id>
  refType      String    @map("ref_type") // office_room | chat | (будущие)
  refId        String    @map("ref_id")
  workspaceId  String?   @map("workspace_id") @db.Uuid // денормализация для событий/фильтров (без FK)
  startedById  String    @map("started_by_id") @db.Uuid
  status       String    @default("active") // active | ended
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  // Клейм «итоговая плашка звонка уже постнута» — идемпотентность против повторной
  // доставки шины (XAUTOCLAIM): листенер постит плашку только при успешном клейме.
  summarizedAt DateTime? @map("summarized_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  participants CallSessionParticipant[]
  recordings   CallRecording[]

  // Одна АКТИВНАЯ сессия на сущность — partial unique index дописан руками в миграции
  // calls_office_engine (Prisma не описывает WHERE-индексы):
  //   CREATE UNIQUE INDEX call_sessions_one_active_per_ref ON call_sessions(ref_type, ref_id) WHERE status = 'active'
  @@index([refType, refId])
  @@index([status, updatedAt]) // крон-реконсиляция зависших active
  // Частичный индекс каскада организации (миграция lifecycle_purge_runner, руками):
  //   call_sessions_workspace_id_idx (workspace_id) WHERE workspace_id IS NOT NULL
  @@map("call_sessions")
}

// Журнал участий в созвоне (вебхуки participant_joined/left; at-least-once →
// «открытая строка» = (sessionId, userId, leftAt IS NULL), дубли не создаются).
model CallSessionParticipant {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  session CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Одна ОТКРЫТАЯ строка на (сессия, пользователь) — partial unique дописан руками в
  // миграции calls_review_fixes (Prisma не описывает WHERE-индексы): повторная доставка
  // вебхука participant_joined не плодит дублей «внутри».
  //   CREATE UNIQUE INDEX call_session_participants_one_open_per_user
  //     ON call_session_participants(session_id, user_id) WHERE left_at IS NULL
  @@index([sessionId, userId])
  @@index([sessionId, leftAt]) // «кто сейчас внутри» (leftAt IS NULL)
  @@map("call_session_participants")
}

// Запись созвона (LiveKit Egress, всегда аудио): recording → processing (stop послан)
// → ingesting (вебхук/крон клеймит финализацию) → ready | error. Итоговый файл
// инжестится в core/files (владелец = startedBy), доставка клеймантам — через
// CallsRecordingRegistry (хук потребителя по refType, паттерн FilesRefRegistry).
// «Одна АКТИВНАЯ запись на сессию» — partial unique дописан руками в миграции
// calls_messenger_recording (Prisma не описывает WHERE-индексы):
//   CREATE UNIQUE INDEX call_recordings_one_active_per_session ON call_recordings(session_id)
//     WHERE status IN ('recording', 'processing', 'ingesting')
model CallRecording {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  refType     String    @map("ref_type") // денормализация сессии — хук доставки и события без join
  refId       String    @map("ref_id")
  workspaceId String?   @map("workspace_id") @db.Uuid
  startedById String    @map("started_by_id") @db.Uuid
  egressId    String?   @unique @map("egress_id") // null только в момент create→StartEgress
  status      String    @default("recording") // recording | processing | ingesting | ready | error
  fileId      String?   @map("file_id") @db.Uuid // FileObject готовой записи (владелец/квота = startedBy)
  error       String?
  attempts    Int       @default(0) // финализация кроном ≤5 попыток, дальше error
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  session CallSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claims  CallRecordingClaim[]

  @@index([sessionId])
  @@index([status, updatedAt]) // крон: редрайв зависших финализаций
  // Частичный индекс каскада организации (миграция lifecycle_purge_runner, руками):
  //   call_recordings_workspace_id_idx (workspace_id) WHERE workspace_id IS NOT NULL
  @@map("call_recordings")
}

// «Получить запись»: каждый нажавший клеймант получает ПОЛНУЮ запись в свой Диктофон
// (VoiceRecording source='call') после финализации. Инициатор клеймится автоматически.
// deliveredAt IS NULL + status='ready' → крон-редрайв доставки.
model CallRecordingClaim {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recordingId String    @map("recording_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  recording CallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, userId])
  @@map("call_recording_claims")
}

// ============================================
// ВИРТУАЛЬНЫЙ ОФИС (B2B) — видеовстречи организации (аналог Google Meet, потребитель
// core/calls). Встреча (OfficeRoom) ≠ созвон (CallSession): room_finished закрывает
// созвон, встреча-ссылка живёт до «Завершить» (host/manager+) или авто-энда кроном.
// kind='channel' — задел Discord-фазы (постоянные комнаты).
// ============================================

model OfficeRoom {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  kind        String    @default("meeting") // meeting | channel (v1 — только meeting)
  status      String    @default("active") // active | ended
  createdById String    @map("created_by_id") @db.Uuid
  endedAt     DateTime? @map("ended_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants OfficeRoomParticipant[]

  @@index([workspaceId, status])
  @@map("office_rooms")
}

// Причастные к встрече (host при создании, participant при приглашении/первом входе) —
// источник проекции office_room#host|participant в core/access и членов чата встречи.
model OfficeRoomParticipant {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("participant") // host | participant
  createdAt DateTime @default(now()) @map("created_at")

  room OfficeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("office_room_participants")
}

// ============================================
// ДВИЖОК ПОДТВЕРЖДЕНИЙ (core/verify, 11-й платформенный) — SMS-OTP.
// Цепочка подтверждения (challenge): одна АКТИВНАЯ на (phone, purpose); ресенд в живом
// TTL шлёт НОВЫЙ код в ту же цепочку (перезапись code_hash + send_count++ + новый TTL):
// храним только хэш, поэтому «переслать тот же» невозможно (модель Supabase). attempts
// при ресенде НЕ сбрасываются (модель SuperTokens). Код хранится ТОЛЬКО HMAC-хэшем
// (контекст = phone+purpose). После успешной проверки выдаётся одноразовый verifyToken
// (тоже хэшем), который потребитель гасит (consumedAt) В ТРАНЗАКЦИИ своего действия.
// FK на users НЕТ: register-цепочки живут до существования пользователя.
// ============================================

model VerifyChallenge {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phone             String
  // ПДн под движком ключей: envelope (платформенный KEK — аккаунта ещё нет) + слепой индекс
  phoneEnc          String?   @map("phone_enc")
  phoneBi           String?   @map("phone_bi")
  phoneBiAlt        String?   @map("phone_bi_alt")
  purpose           String // register | password_reset | password_change | phone_change_old | phone_change_new
  codeHash          String    @map("code_hash")
  attempts          Int       @default(0) // неверные вводы на цепочку; 5 → цепочка сгорает
  sendCount         Int       @default(1) @map("send_count") // отправки SMS этой цепочки (ресенды)
  lastSentAt        DateTime  @default(now()) @map("last_sent_at")
  expiresAt         DateTime  @map("expires_at")
  verifiedAt        DateTime? @map("verified_at")
  consumedAt        DateTime? @map("consumed_at")
  verifyTokenHash   String?   @unique @map("verify_token_hash")
  requestIp         String?   @map("request_ip")
  // Что человек принял ДО отправки SMS (цель register): {versionIds, locale, channel} —
  // записи приёмки строятся ИЗ этого контекста, а не из тела запроса шага 3 (core/consents)
  context           Json?
  userId            String?   @map("user_id") @db.Uuid // владелец цели: step-up залогиненных И password_reset (привязка к аккаунту, не только к номеру)
  // Ответ SMS-шлюза на последнюю отправку: id сообщения у провайдера (доказательство
  // отправки для поддержки «мне не пришла SMS») и признак «код никуда не уходил»
  // (нейтральная имитация сброса по несуществующему номеру / тест-карта).
  providerMessageId String?   @map("provider_message_id")
  delivery          String    @default("sms") // sms | simulated | test_map
  createdAt         DateTime  @default(now()) @map("created_at")

  // Активная цепочка ищется по (phone, purpose) среди неистёкших.
  @@index([phone, purpose, createdAt])
  @@index([phoneBi, purpose, createdAt])
  @@index([phoneBiAlt, purpose, createdAt])
  // Потолки SMS на номер: окно считается по времени ПОСЛЕДНЕЙ отправки, а не по
  // созданию цепочки (ресенды долгоживущей цепочки иначе выпадали бы из часового окна).
  @@index([phone, lastSentAt])
  @@index([phoneBi, lastSentAt])
  @@index([phoneBiAlt, lastSentAt])
  @@index([createdAt]) // ретеншн-крон (7 дней)
  @@map("verify_challenges")
}

// ============================================
// DOCS ENGINE (core/docs) — 12-й платформенный движок: работа с документами.
// Документ = ЖИВОЙ файл core/files, который редактор МУТИРУЕТ НА МЕСТЕ (модель Google
// Drive: стабильный id файла, ревизии — отдельными блобами). Перевешивание FileLink'а
// на новый файл сюда не годится: мессенджер хранит снимок вложения внутри Message.payload,
// и вложение просто исчезло бы из чата, а осиротевший файл прибрал бы реап.
// Редактор — внешний WOPI-клиент (Collabora), сменная деталь; контракт WOPI не меняется.
// FK на file_objects НЕТ намеренно (паттерн FileLink/CallSession): физическая уборка
// файла не имеет права каскадом стереть журнал версий и сам документ.
// ============================================

model Document {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId        String    @unique @map("file_id") @db.Uuid // ЖИВОЙ ЧЕРНОВИК (мутируется на месте)
  ownerType     String    @map("owner_type") // user | workspace (владение файла)
  ownerId       String    @map("owner_id") @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  title         String
  ext           String // docx | xlsx | pptx | odt | ods | odp
  mime          String
  editorKind    String    @map("editor_kind") // writer | calc | impress
  mode          String    @default("edit") // edit | readonly (владелец «заморозил» правку)
  status        String    @default("active") // active | archived
  // Узел редактора, липкий на время сессии: два узла на одном документе = два брокера
  // в памяти = потерянные правки (задел под шардирование, в v1 узел один).
  editorBaseUrl String?   @map("editor_base_url")
  // Рубильник самодостаточных WOPI-токенов: инкремент гасит ВСЕ выданные (вердикт
  // «заражён», перевод в readonly, отзыв доступа) — токены в БД не хранятся.
  tokenEpoch    Int       @default(1) @map("token_epoch")
  lastVersionNo Int       @default(0) @map("last_version_no")
  lastSavedAt   DateTime? @map("last_saved_at")
  lastEditorId  String?   @map("last_editor_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  versions DocumentVersion[]
  sessions DocumentSession[]

  @@index([ownerType, ownerId, status])
  // Частичный индекс шага docs.trash (миграция lifecycle_purge_runner, руками):
  //   documents_archived_deleted_at_idx (deleted_at) WHERE status = 'archived'
  @@map("documents")
}

// Неизменяемая веха: снимок черновика отдельным FileObject + sha256. Режется при уходе
// последнего редактора (Unlock) и по кнопке «Сохранить версию»; создаётся в статусе
// pending В ТОЙ ЖЕ транзакции, что и джоб docs.milestone (transactional outbox).
model DocumentVersion {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  versionNo   Int      @map("version_no")
  status      String   @default("pending") // pending | ready | skipped (байты не менялись) | failed
  fileId      String?  @map("file_id") @db.Uuid // FileObject снимка (появляется после инжеста)
  sha256      String?
  size        BigInt?
  reason      String // session_end | manual | pre_sign (отпечаток под ЭЦП)
  createdById String?  @map("created_by_id") @db.Uuid
  authorIds   String[] @default([]) @map("author_ids") @db.Uuid // кто правил в сессии вехи
  signed      Boolean  @default(false) // ретеншн (20 последних) подписанные не трогает
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo]) // ремень от гонки двух одновременных Unlock
  @@index([documentId, createdAt])
  @@index([status, createdAt]) // подбор зависших pending
  @@map("document_versions")
}

// Сессия правки = ОДНА WOPI-блокировка на документ (не на пользователя): в COOL все
// соредакторы сидят за одним брокером и держат общий lock. Закрывается тремя ремнями:
// Unlock (основной), подсказка IsExitSave (укороченный простой) и крон-жнец.
model DocumentSession {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  lockValue      String    @map("lock_value") // строка блокировки, выданная WOPI-клиентом
  editorBaseUrl  String    @map("editor_base_url")
  status         String    @default("open") // open | closed | expired
  lockedAt       DateTime  @default(now()) @map("locked_at")
  expiresAt      DateTime  @map("expires_at") // +30 мин, двигается RefreshLock
  lastPutAt      DateTime? @map("last_put_at")
  exitSaveSeen   Boolean   @default(false) @map("exit_save_seen")
  participantIds String[]  @default([]) @map("participant_ids") @db.Uuid
  closedAt       DateTime? @map("closed_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // ПАРТИАЛЬНЫЙ UNIQUE ДОПИСАН РУКАМИ в миграции docs_engine (Prisma не выражает WHERE —
  // тот же приём, что у jobs и call_sessions):
  //   CREATE UNIQUE INDEX document_sessions_live ON document_sessions(document_id) WHERE status = 'open';
  @@index([documentId]) // «сессии этого документа» + каскад удаления (FK-колонки Postgres не индексирует сам)
  @@index([status, expiresAt]) // крон-жнец протухших блокировок
  @@map("document_sessions")
}

// ============================================
// OMNIDRIVE («Диск») — слой ИМЁН И ДЕРЕВА поверх core/files
//
// Байтами, квотой, вариантами и антивирусом по-прежнему владеет движок файлов. Один
// FileObject может лежать и вложением в чате, и узлом на Диске — это две строки
// FileLink на одни байты: копирования нет, квота не удваивается, правка через
// core/docs видна во всех местах сразу.
//
// Права: core/access хранит только ПРЯМЫЕ гранты (drive_node:<id>#viewer|editor|manager@…),
// а наследование по дереву Диск считает сам — материализованным массивом предков и
// одним условием в SQL. Рекурсия в движке отвергнута гриллом: обход предков стоил бы
// десятки запросов на промах кэша, а тип-эпоха сбрасывала бы ACL-кэш всей платформы
// на каждый шеринг.
// ============================================

// Пространство: «Мой диск» человека или «Диск организации». Сущность с первого дня —
// project-пространства (общий диск проектной команды) добавляются сюда же, без миграции
// смысла. Создаётся лениво при первом обращении (паттерн getOrCreateBook финансов).
model DriveSpace {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      String // personal | workspace
  ownerType String   @map("owner_type") // user | workspace
  ownerId   String   @map("owner_id") @db.Uuid
  // Корневой узел. Без FK осознанно: узел ссылается на пространство, и обратная связь
  // замкнула бы цикл создания — корень пишется вторым шагом той же транзакции.
  rootId    String?  @map("root_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nodes   DriveNode[]
  buckets DrivePhotoBucket[]

  @@unique([ownerType, ownerId, kind])
  @@map("drive_spaces")
}

// Узел дерева: папка, файл или (задел) ярлык.
model DriveNode {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  spaceId     String  @map("space_id") @db.Uuid
  kind        String // folder | file | shortcut
  parentId    String? @map("parent_id") @db.Uuid // null только у корня
  // ВНИМАНИЕ: колонке руками навешена коллация natural_ru (ICU ru-RU-u-kn) — «файл2»
  // сортируется перед «файл10». Коллация висит на КОЛОНКЕ, а не пишется в ORDER BY:
  // несовпадение коллации индекса и запроса даёт вечный Sort в плане.
  name        String
  // NFC + нижний регистр: по нему живёт частичный unique «одно имя в папке».
  // Считается в одном месте (driveNameKey в shared) — иначе «Договор.pdf» и
  // «договор.pdf» лежали бы рядом, а составное «й» дало бы визуальный дубль.
  nameKey     String  @map("name_key")
  fileId      String? @map("file_id") @db.Uuid // kind='file'
  targetId    String? @map("target_id") // kind='shortcut' — колонка-задел, UI в v1 нет
  createdById String  @map("created_by_id")

  // Материализованные предки от корня, БЕЗ себя. На них держится и наследование прав
  // (ancestor_ids && granted), и перенос поддерева одним UPDATE.
  ancestorIds String[] @default([]) @map("ancestor_ids") @db.Uuid
  depth       Int      @default(0)
  // 0 = папка, 1 = всё остальное: «папки вперёд» это ведущий ключ сортировки, а не
  // отдельная ветка запроса. Обычная колонка, не GENERATED — вычисляемые колонки
  // Prisma не моделирует, и migrate dev ловил бы вечный дрейф.
  sortRank    Int      @default(1) @map("sort_rank")

  trashedAt     DateTime? @map("trashed_at")
  // Что человек удалил ЯВНО: восстановление возвращает именно этот узел со всем
  // поддеревом, а не каждый вложенный файл по отдельности.
  trashedRootId String?   @map("trashed_root_id") @db.Uuid

  // Роллап поддерева у папки. null = «пересчитать» (сентинел Nextcloud): мутация
  // помечает предков null, джоб добивает. Считать на лету у папки с 50 000 файлов
  // означало бы полное сканирование на каждый листинг.
  subtreeBytes BigInt? @map("subtree_bytes")
  subtreeFiles Int?    @map("subtree_files")

  // Системная папка пространства («Файлы из переписки») — не удаляется, не переносится.
  systemKey      String? @map("system_key")
  // АВТОимя платформы: ключ каталога + его параметры («{base} (с печатью).{ext}»).
  // `name` при этом остаётся снимком в языке источника — по нему живут поиск,
  // сортировка и уникальность в папке, — а человек читает имя, собранное ПРИ ЧТЕНИИ
  // в его языке (`DriveService.displayName`). Переименование человеком гасит ключ.
  autoNameKey    String? @map("auto_name_key")
  autoNameParams Json?   @map("auto_name_params")

  // ЗАКРЫТАЯ ПАПКА: наследование прав СВЕРХУ обрывается на ней. Нужна там, где общий
  // корень раздаёт доступ всей команде, а содержимое обязано быть закрытым — личные
  // дела сотрудников (сервис «Документы»). Доступ внутрь дают только гранты на самой
  // папке и ниже; владелец пространства (admin+) видит всё, как и раньше.
  restricted Boolean @default(false)

  // Время СЪЁМКИ, стенное. Колонка Prisma — timestamp БЕЗ пояса, и это здесь несущее:
  // ночной снимок не должен уезжать на соседние сутки при смене пояса зрителя, а
  // date_trunc по timestamptz не IMMUTABLE — индекс по месяцу не построить.
  takenAtLocal DateTime? @map("taken_at_local")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space    DriveSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   DriveNode?  @relation("DriveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DriveNode[] @relation("DriveTree")
  // Узел без файла смысла не имеет: физическая уборка файла движком забирает и узел.
  file     FileObject? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  versions DriveNodeVersion[]
  stars    DriveStar[]
  recents  DriveRecent[]

  // ПАРТИАЛЬНЫЕ ИНДЕКСЫ И КОЛЛАЦИЯ ДОПИСАНЫ РУКАМИ в миграции drive_engine (Prisma не
  // выражает ни WHERE, ни COLLATE, ни GIN — тот же приём, что у jobs и search):
  //   CREATE COLLATION natural_ru (provider = icu, locale = 'ru-RU-u-kn');
  //   ALTER TABLE drive_nodes ALTER COLUMN name TYPE TEXT COLLATE natural_ru;
  //   CREATE INDEX drive_ls_name ON drive_nodes (parent_id, sort_rank, name, id)                    WHERE trashed_at IS NULL;
  //   CREATE INDEX drive_ls_date ON drive_nodes (parent_id, sort_rank, updated_at DESC, id DESC)    WHERE trashed_at IS NULL;
  //   CREATE INDEX drive_ls_size ON drive_nodes (parent_id, sort_rank, subtree_bytes DESC, id DESC) WHERE trashed_at IS NULL;
  //   CREATE UNIQUE INDEX drive_name_uniq ON drive_nodes (parent_id, name_key) WHERE trashed_at IS NULL;
  //   CREATE INDEX drive_anc   ON drive_nodes USING GIN (ancestor_ids);
  //   CREATE INDEX drive_trash ON drive_nodes (space_id, trashed_at) WHERE trashed_at IS NOT NULL;
  //   CREATE INDEX drive_dirty ON drive_nodes (space_id, id) WHERE kind = 'folder' AND subtree_bytes IS NULL;
  //   CREATE INDEX drive_photo ON drive_nodes (space_id, taken_at_local DESC, id)
  //                                WHERE kind = 'file' AND taken_at_local IS NOT NULL AND trashed_at IS NULL;
  @@index([spaceId])
  @@index([parentId]) // каскад дерева + выборки корзины (FK-колонки Postgres не индексирует сам)
  @@index([fileId]) // «этот файл уже на Диске?» и каскад от движка файлов
  @@index([spaceId, systemKey]) // поиск системной папки пространства
  // GIN по предкам создаётся сырым SQL выше, но ОБЪЯВЛЯЕТСЯ здесь: партиальные индексы
  // (с WHERE) schema-engine не видит и не трогает, а GIN он выразить умеет — и поэтому
  // считает «лишним» и на следующем migrate dev пишет DROP INDEX. Ровно тот же приём,
  // что у GIN-индексов search_documents.
  @@index([ancestorIds(ops: ArrayOps)], map: "drive_anc", type: Gin)
  @@map("drive_nodes")
}

// Версия обычного файла. У офисных документов версии свои — их режет core/docs по
// вехам правки, и дублировать их здесь нельзя (join идёт через Document.fileId).
model DriveNodeVersion {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nodeId      String   @map("node_id") @db.Uuid
  versionNo   Int      @map("version_no")
  fileId      String   @map("file_id") @db.Uuid // отдельный FileObject-снимок
  size        BigInt
  sha256      String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  node DriveNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([nodeId, versionNo]) // ремень от гонки двух одновременных снимков
  @@index([nodeId, createdAt])
  @@index([fileId])
  @@map("drive_node_versions")
}

// «Избранное» — персональная отметка зрителя, не свойство узла.
model DriveStar {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nodeId    String   @map("node_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  node DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, createdAt])
  @@index([nodeId])
  @@map("drive_stars")
}

// «Недавние» — что зритель открывал. Строка на пару (человек, узел): лента коротких
// повторных открытий не должна расти неограниченно.
model DriveRecent {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  nodeId   String   @map("node_id") @db.Uuid
  openedAt DateTime @default(now()) @map("opened_at")

  node DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, openedAt])
  @@index([nodeId])
  // Раннер сроков: «недавние» старше срока по всей платформе (core/lifecycle)
  @@index([openedAt])
  @@map("drive_recents")
}

// Счётчики ленты «Фото» по месяцам: скрубберу нужен ВЕСЬ год сразу, а COUNT(*) с
// группировкой по 20 000 снимков на каждое открытие ленты — это полное сканирование.
// Ведётся инкрементально, ночная сверка лечит расхождения.
model DrivePhotoBucket {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  spaceId String @map("space_id") @db.Uuid
  month   String // YYYY-MM (по takenAtLocal, то есть по СТЕННОЙ дате съёмки)
  count   Int    @default(0)

  space DriveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, month])
  @@map("drive_photo_buckets")
}

// ============================================
// SHARE-LINKS ENGINE (core/share-links) — 13-й платформенный движок:
// гостевые ссылки «наружу», людям БЕЗ аккаунта. Токен → гостевая СТРАНИЦА
// просмотра и скачивания (не сырые байты), срок действия, отзыв, счётчик
// открытий и журнал визитов.
//
// refType/refId полиморфны и БЕЗ внешнего ключа (паттерн FileLink/CallSession):
// движок не знает таблиц потребителей, а потребитель сам отзывает свои ссылки,
// когда объект умирает (Диск — в purge, документы — в archive). Права на
// управление решает резолвер потребителя (ShareLinksRegistry); core/access здесь
// не участвует вовсе — гость не принципал, строка ссылки И ЕСТЬ грант.
// ============================================
model ShareLink {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // randomBytes(24) base64url, плейнтекстом: токен — ключ поиска, а не пароль
  // (та же модель, что у вечной публичной ссылки файла и у токена веб-хука).
  token             String    @unique
  refType           String    @map("ref_type") // drive_node | document | (дальше — счета, витрины, ЭДО)
  refId             String    @map("ref_id")
  ownerType         String    @map("owner_type") // user | workspace — владелец объекта, из резолвера
  ownerId           String    @map("owner_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid // денормализация под «Журнал организации»
  createdById       String    @map("created_by_id") @db.Uuid
  label             String? // подпись «для кого» — видна только управляющим
  // СНИМОК названия объекта на момент выдачи. Нужен разделу «Ссылки наружу»: без него
  // список звал бы резолвер потребителя на каждую строку (N запросов на страницу),
  // показывал бы «Объект удалён» вместо имени там, где объекта уже нет, и светил бы
  // ТЕКУЩЕЕ имя тому, у кого доступ к объекту давно отобрали. Снимок честнее и дешевле:
  // в списке «что я раздал» важно, чем это было в момент раздачи.
  refTitle          String?   @map("ref_title")
  refIcon           String?   @map("ref_icon")
  expiresAt         DateTime? @map("expires_at") // null = бессрочная (модель Google Drive)
  revokedAt         DateTime? @map("revoked_at")
  revokedById       String?   @map("revoked_by_id") @db.Uuid // null при СИСТЕМНОМ отзыве (объект удалён)
  passwordHash      String?   @map("password_hash") // bcrypt; null = без пароля
  // Перебор пароля считается на САМОЙ ссылке, а не по IP: троттлер платформы бьёт по
  // адресу, а адресов у распределённого перебора сколько угодно. Модель — core/verify
  // (5 попыток), но вместо гашения цепочки временная блокировка: убивать ссылку насмерть
  // значит дать любому, кто знает токен, отрезать от неё получателя.
  pwdFailedAttempts Int       @default(0) @map("pwd_failed_attempts")
  pwdLockedUntil    DateTime? @map("pwd_locked_until")
  maxOpens          Int?      @map("max_opens") // null = без потолка открытий
  openCount         Int       @default(0) @map("open_count")
  lastOpenedAt      DateTime? @map("last_opened_at")
  // Скачивание. ВАЖНО: это не защита от копирования — если гость видит файл, байты уже
  // у него в браузере (так же честно называют это Google Drive и Dropbox). Выключенное
  // скачивание убирает кнопки и отдаёт превью вместо оригинала.
  allowDownload     Boolean   @default(true) @map("allow_download")
  // Личность гостя: перед показом содержимого гость называет имя и подтверждает номер
  // SMS-кодом (core/verify, purpose share_link_guest). Журнал визитов показывает КТО
  // открывал, а не только IP; будущие действия гостя (подпись, оплата, ответ на опрос)
  // берут личность из этой же записи. Включение тумблера на живой ссылке бампает
  // sessionEpoch — уже открытые АНОНИМНЫЕ сессии умирают (иначе настройка не делала бы
  // того, что обещает).
  requireIdentity   Boolean   @default(false) @map("require_identity")
  // Уведомлять владельца об открытиях. По умолчанию ДА: самый частый случай — «отправил
  // документ человеку», и там уведомление и есть смысл. От массовых ссылок спасает
  // предохранитель ниже, а не выключенный по умолчанию тумблер.
  notifyOnOpen      Boolean   @default(true) @map("notify_on_open")
  // Предохранитель: сутки считаем открытия, после потолка уведомления по этой ссылке
  // замолкают до следующего дня (одно прощальное «дальше сегодня тихо»). Без крона:
  // день хранится прямо здесь и сбрасывается первым открытием следующих суток.
  notifyDay         DateTime? @map("notify_day") @db.Date
  notifyCount       Int       @default(0) @map("notify_count")
  // Поколение гостевых пропусков. Пропуск подписан по linkId, а не по токену, поэтому
  // без этого счётчика смена адреса НЕ отрезала бы того, кто уже открыл ссылку, — то
  // есть ровно того, ради кого адрес и меняют.
  sessionEpoch      Int       @default(0) @map("session_epoch")
  tokenRotatedAt    DateTime? @map("token_rotated_at")
  settings          Json      @default("{}") // слот пер-refType опций (v1 пусто; ЭДО положит своё)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  visits ShareLinkVisit[]

  @@index([refType, refId])
  // Страница «Мои ссылки»: свои ссылки, новые сверху.
  @@index([createdById, createdAt])
  @@index([ownerType, ownerId])
  // «Ссылки организации» (manager+): всё, что раздала наружу вся команда, новые
  // сверху. Отдельный индекс, а не (ownerType, ownerId): организация — это ещё и
  // КОНТЕКСТ, в котором личный объект может быть роздан по работе, и такие строки
  // обязаны попадать в организационный вид.
  @@index([workspaceId, createdAt])
  // Раннер сроков: общая пачка «старейшие отозванные первыми» (core/lifecycle)
  @@index([revokedAt])
  @@map("share_links")
}

// Журнал визитов (модель DocSend): владелец видит, когда ссылку открывали.
// Append-log с BigInt-идентификатором — он же курсор (паттерн ChatterEntry);
// наружу id ВСЕГДА строкой. Ретеншн — крон движка.
model ShareLinkVisit {
  id        BigInt   @id @default(autoincrement())
  linkId    String   @map("link_id") @db.Uuid
  openedAt  DateTime @default(now()) @map("opened_at")
  ip        String? // req.ip (с учётом TRUST_PROXY)
  userAgent String?  @map("user_agent")
  // Кто открывал (ссылка требовала подтверждение номера). null у анонимных визитов.
  guestId   String?  @map("guest_id") @db.Uuid

  link  ShareLink       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  guest ShareLinkGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([linkId, id])
  @@index([openedAt])
  @@index([guestId])
  @@map("share_link_visits")
}

// Личность гостя — человек БЕЗ аккаунта, подтвердивший номер SMS-кодом (core/verify).
// Подсистема движка ссылок, а не отдельный движок: гость существует только через
// ссылку, и все гостевые потребители (ЭДО, счета, опросы, booking) получают его через
// authorizeGuest — одной регистрацией в ShareLinksRegistry, как и всё остальное.
//
// Запись скоупится на ВЛАДЕЛЬЦА объекта (организацию/человека), а не глобально:
// постоянный контрагент организации узнаваем в её журналах («этот номер уже подписывал
// наши документы»), но организация А не может выяснить, что номер знаком организации Б.
//
// Это же — будущий мостик к Universal Identity: гость, зарегистрировавшийся на тот же
// номер, сможет получить свою историю (прецедент активации pending-приглашений).
model ShareLinkGuest {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType       String   @map("owner_type") // user | workspace — владелец объектов ссылок
  ownerId         String   @map("owner_id") @db.Uuid
  phone           String // нормализованный, подтверждён SMS-кодом
  // ПДн под движком ключей: envelope (KEK владельца ссылки) + слепой индекс (уникум ниже)
  phoneEnc        String?  @map("phone_enc")
  phoneBi         String?  @map("phone_bi")
  phoneBiAlt      String?  @map("phone_bi_alt")
  // Имя вводит сам гость (не подтверждается). Последнее введённое побеждает —
  // человек мог опечататься в первый раз.
  name            String
  firstVerifiedAt DateTime @default(now()) @map("first_verified_at")
  lastVerifiedAt  DateTime @default(now()) @map("last_verified_at")

  visits ShareLinkVisit[]

  @@unique([ownerType, ownerId, phone])
  @@unique([ownerType, ownerId, phoneBi])
  @@unique([ownerType, ownerId, phoneBiAlt])
  // Раннер сроков: гости без подтверждения дольше срока (core/lifecycle)
  @@index([lastVerifiedAt])
  @@map("share_link_guests")
}

// ============================================================
// core/approvals — движок согласований (14-й платформенный)
// ============================================================
// «Задачник для решений». Асимметрия, которую он чинит: нода «Задача человеку» в
// Процессах создаёт НАСТОЯЩУЮ задачу в Задачнике, а нода «Одобрение» держала
// человека внутри канваса и показывала ему одну строку текста — без файла, без
// суммы, без карточки. Теперь решение живёт своей сущностью, знает свой предмет и
// умеет попадать в стопку «Ждут решения», в чат рич-карточкой и в журнал.
//
// Ветвлений, условий и циклов здесь НЕТ — это работа движка Процессов. Заявка
// умеет ровно одно: прямой список шагов, где одинаковый `order` идёт параллельно.

/// Заявка: предмет + маршрут. Предмет полиморфен и БЕЗ FK (паттерн FileLink /
/// ShareLink): движок не знает своих потребителей, а история решений обязана
/// пережить удаление самого предмета.
model ApprovalRequest {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  refType     String  @map("ref_type") // org_document | (дальше — счета, задачи, сообщения)
  refId       String  @map("ref_id")
  // СНИМОК названия предмета на момент создания. Тот же довод, что у ShareLink.refTitle:
  // список не должен звать резолвер потребителя на каждую строку, обязан пережить
  // удаление объекта и не должен светить ТЕКУЩЕЕ имя тому, у кого доступ уже отобрали.
  refTitle    String  @map("ref_title")
  refIcon     String? @map("ref_icon")
  // Организация — скоуп стопки и будущего «Журнала организации». null у личных заявок.
  workspaceId String? @map("workspace_id") @db.Uuid
  status      String  @default("pending") // pending | approved | rejected | returned | cancelled

  // Кто ведёт заявку снаружи. Для движка это НЕПРОЗРАЧНАЯ пара: он не знает ни
  // процессов, ни их шагов — по originType находит хук в ApprovalOriginRegistry и
  // отдаёт ему originRef как есть. Так направление знания остаётся «потребитель → движок».
  originType String? @map("origin_type") // process | null (заявка сама по себе)
  originRef  String? @map("origin_ref")

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  steps ApprovalStep[]

  // Стопка «Ждут решения» и списки «мои заявки» — обе по активным.
  @@index([workspaceId, status, createdAt])
  @@index([createdById, status, createdAt])
  @@index([refType, refId])
  // Хук возврата: процесс просыпается по своей паре (тип, ссылка).
  @@index([originType, originRef])
  // ВНИМАНИЕ: партиальный UNIQUE (origin_type, origin_ref) WHERE status='pending'
  // дописан РУКАМИ в миграции `approvals_origin_unique` — Prisma такое не выражает.
  // «Одна живая заявка на шаг ведущего»: повторный толчок ноды при at-least-once
  // не заводит вторую. По предмету (refType+refId) уника НЕТ намеренно — на одном
  // документе законно идут параллельные подпись и ознакомление.
  @@map("approval_requests")
}

/// Шаг маршрута. Одинаковый `order` = группа, идущая одновременно; следующая
/// группа активируется, когда закрылась предыдущая. Отдельного режима
/// «последовательно/параллельно» у заявки нет намеренно: одно поле выражает оба
/// случая, а два способа сказать одно и то же всегда разъезжаются.
model ApprovalStep {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId   String  @map("request_id") @db.Uuid
  order       Int
  kind        String // approval | signature | acknowledgement
  title       String
  // Заголовок собрала ПЛАТФОРМА (маршрут из библиотеки бланков): ключ каталога и его
  // параметры. `title` — снимок в языке источника (фолбэк старых заявок), а читателю
  // заголовок собирается на его языке. Набранный человеком заголовок ключа не имеет.
  titleKey    String? @map("title_key")
  titleParams Json?   @map("title_params")
  status      String  @default("waiting") // waiting | active | approved | rejected | returned | skipped

  assigneeType      String  @map("assignee_type") // user | position | department
  assigneeId        String  @map("assignee_id")
  // Подпись адресата шага — СНИМКОМ СТРУКТУРЫ, а не фразой (core/audiences,
  // AudienceLabelSnapshot): `assignee_label_key` — ключ каталога формы («Отдел
  // «{name}»»), `assignee_label_name` — имя справочника на момент заведения.
  // Справочник переименуют, а история решений должна остаться читаемой
  // («Согласовал Главный бухгалтер» — тот, что был тогда), и при этом читаться в
  // языке ЗРИТЕЛЯ: готовая фраза застыла бы в языке автора заявки навсегда.
  assigneeLabelKey  String? @map("assignee_label_key")
  assigneeLabelName String? @map("assignee_label_name")
  // Наследный снимок фразой — записи, заведённые до перехода на структуру. Новые
  // строки его не пишут; читающий путь берёт его, только если ключа и имени нет.
  assigneeLabel     String? @map("assignee_label")
  rule              String  @default("any") // any (первый ответивший) | all (нужен каждый)

  // ЕДИНСТВЕННОЕ, что движок решений знает про подпись (core/sign).
  // null → обычный путь: клик закрывает шаг решением `internal`.
  // 'sms' | 'ecp' → публичный `decide` отвергается кодом approval_needs_signature,
  // а закрыть шаг может только `decideAttested` из транзакции финализации акта.
  // Направление знания при этом остаётся «sign → approvals»: движок подписи здесь
  // потребитель, как и все остальные.
  requiredSignatureKind String? @map("required_signature_kind")

  // Кого ждём поимённо. Заполняется СНИМКОМ в момент активации, а не читается на
  // лету: иначе принятый в середине согласования сотрудник молча получал бы
  // обязанность, а уволенный навсегда подвешивал бы шаг, который некому закрыть.
  awaitingUserIds String[] @default([]) @map("awaiting_user_ids") @db.Uuid

  // Срок хранится В ЧАСАХ до активации и превращается в дату ПРИ ней. Считать
  // дедлайн от создания заявки нельзя: шаг может неделю ждать своей очереди, и
  // третий согласующий получал бы документ уже просроченным.
  dueHours    Int?      @map("due_hours")
  activatedAt DateTime? @map("activated_at")
  deadlineAt  DateTime? @map("deadline_at")
  escalatedAt DateTime? @map("escalated_at") // дедуп эскалации просрочки
  decidedAt   DateTime? @map("decided_at")

  request   ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  // Стопка «Ждут решения» — ОДИН индексный запрос: «активные шаги, где я в снимке».
  // Снимок и делает это возможным: адресация развёрнута в людей на активации, поэтому
  // читающий путь не ходит в движок прав и ничего не знает про должности и отделы.
  @@index([awaitingUserIds(ops: ArrayOps)], map: "approval_steps_awaiting", type: Gin)
  @@index([requestId, order])
  @@map("approval_steps")
}

/// Одно решение одного человека. Неизменяемо: это запись в истории, а не состояние
/// (модель LedgerTransfer — журнал не переписывают).
model ApprovalDecision {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId   String  @map("step_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  decision String // approved | rejected | returned
  comment  String?

  // Отпечаток ТОЙ версии предмета, которую человек видел, когда решал. Без него
  // подпись не значит ничего: файл могли переписать после решения, и доказать,
  // под чем именно стоит согласие, было бы нечем.
  subjectSha256 String? @map("subject_sha256")
  // Чем подтверждено решение. В v1 всегда `internal` — нажатие в SuperApp6, а не
  // юридическая подпись; core/sign добавит `sms`/`ecp`, не трогая маршруты.
  signatureKind String  @default("internal") @map("signature_kind")
  // Акт подписи, которым закрыто решение (core/sign). Без FK намеренно: движок
  // решений не должен зависеть от таблиц движка подписи, а само решение обязано
  // читаться и тогда, когда до подписи дело не дошло.
  signActId     String? @map("sign_act_id") @db.Uuid
  ip            String?

  decidedAt DateTime @default(now()) @map("decided_at")

  step ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // Один человек — одно решение на шаг. Двойной клик и гонка «любого из» гасятся
  // индексом, а не проверкой в приложении.
  @@unique([stepId, userId])
  @@index([userId, decidedAt])
  @@map("approval_decisions")
}

// ============================================================
// Сервис «Контрагенты» (B2B) — справочник ВНЕШНИХ организаций и людей.
//
// ОДИН справочник на организацию: его читает «Документооборот» (договоры/АВР с
// внешней стороной), дальше встанут Счета, Финансы B2B, ЭСФ и CRM — свой список
// контрагентов каждый сервис не заводит. Контрагент — НЕ пользователь платформы
// (подписывает по гостевой ссылке); БИН — якорь будущего связывания
// workspace↔workspace. Доступ гейтится РОЛЬЮ (чтение — команда trainee+, запись —
// manager+, модель Staff), в core/access тип НЕ заводится намеренно.
// ============================================================

model Counterparty {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  // legal (ТОО/АО…) | entrepreneur (ИП) | individual (физлицо). От вида зависит,
  // что лежит в `bin` (БИН юрлица / ИИН ИП и физлица) и с чем сверяется
  // сертификат ЭЦП внешнего подписанта.
  kind String @default("legal")

  name      String // рабочее имя («Ромашка») — то, что видно в списках
  legalName String? @map("legal_name") // полное юрнаименование — то, что идёт в договор

  // БИН/ИИН: 12 цифр, контрольная сумма проверяется схемой (isValidIinOrBin)
  bin           String?
  orgForm       String?   @map("org_form")
  legalAddress  String?   @map("legal_address")
  // Фактический адрес; NULL = совпадает с юридическим (обычная оговорка договора)
  actualAddress String?   @map("actual_address")
  kbe           String?
  // Налоговый режим (справочник TAX_REGIMES shared); NULL = не указан
  taxRegime     String?   @map("tax_regime")
  vatPayer      Boolean   @default(false) @map("vat_payer")
  vatSeries     String?   @map("vat_series")
  vatNumber     String?   @map("vat_number")
  vatDate       DateTime? @map("vat_date") @db.Date

  // Руководитель — ТЕКСТ, а не user_id: человек вне платформы (паттерн
  // WorkspaceRequisites.directorUserId здесь неприменим — некого валидировать).
  directorName    String?   @map("director_name")
  // ОСНОВАНИЕ ПОДПИСИ — структурой, а не готовой фразой: «действующего на
  // основании Приказа № 12-к от 15.01.2026» печатается ВНУТРИ договора, а
  // договор бывает на трёх языках. Слова подбираются на выходе — в языке
  // бланка при рендере и в языке зрителя на экране (docs/counterparties.md).
  signBasisKind   String?   @map("sign_basis_kind") // ustav | svid_ip | doverennost | prikaz | polozhenie | custom
  signBasisNumber String?   @map("sign_basis_number")
  signBasisDate   DateTime? @map("sign_basis_date") @db.Date
  signBasisText   String?   @map("sign_basis_text") // своя формулировка целиком (kind = custom)

  phone      String?
  email      String?
  // ПДн под движком ключей (KEK организации): телефон ещё и слепым индексом (сверка ПЭП)
  phoneEnc   String? @map("phone_enc")
  phoneBi    String? @map("phone_bi")
  phoneBiAlt String? @map("phone_bi_alt")
  emailEnc   String? @map("email_enc")
  comment    String?

  createdById String    @map("created_by_id") @db.Uuid
  archivedAt  DateTime? @map("archived_at") // архив вместо удаления: на карточке висят документы
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      CounterpartyContact[]
  bankAccounts  CounterpartyBankAccount[]
  heldAssets    Asset[]
  assetServices AssetServiceRecord[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, name])
  @@index([workspaceId, phoneBi])
  @@index([workspaceId, phoneBiAlt])
  // ВНИМАНИЕ: партиальный UNIQUE (workspace_id, bin)
  // WHERE bin IS NOT NULL AND archived_at IS NULL дописан РУКАМИ в миграции
  // `counterparties_service` — Prisma такое не выражает. Дубль БИН среди живых →
  // P2002 → 409: один контрагент — одна карточка, иначе якорь связывания не работает.
  @@map("counterparties")
}

/// Контактное лицо контрагента: кому уходит документ на подпись (SMS-канал) и с
/// чьим номером мягко сверяется личность ПЭП-подписанта.
model CounterpartyContact {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  counterpartyId String @map("counterparty_id") @db.Uuid
  workspaceId    String @map("workspace_id") @db.Uuid // денормализован: гейты и выборки идут по организации

  name       String
  position   String?
  phone      String? // нормализованный (+7…): канал SMS и сверка ПЭП
  email      String?
  // ПДн под движком ключей (KEK организации)
  phoneEnc   String? @map("phone_enc")
  phoneBi    String? @map("phone_bi")
  phoneBiAlt String? @map("phone_bi_alt")
  emailEnc   String? @map("email_enc")

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId, archivedAt])
  @@index([workspaceId])
  @@index([workspaceId, phoneBi])
  @@index([workspaceId, phoneBiAlt])
  @@map("counterparty_contacts")
}

/// Банковские счета контрагента — СПИСОК с основным (клон WorkspaceBankAccount:
/// «ровно один основной» держит сервис в транзакции, partial-unique не нужен).
model CounterpartyBankAccount {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  counterpartyId String  @map("counterparty_id") @db.Uuid
  // Денормализовано (как у CounterpartyContact): скоуп KEK шифрования IBAN — организация
  workspaceId    String? @map("workspace_id") @db.Uuid

  iban      String
  ibanEnc   String?  @map("iban_enc") // ПДн под движком ключей (KEK организации)
  bankName  String   @map("bank_name")
  bik       String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId])
  @@index([workspaceId])
  @@map("counterparty_bank_accounts")
}

// ============================================================
// Сервис «Документы» (B2B) — Этап 4 документной вертикали.
//
// Вид (DocType) — справочник организации: нумерация, видимость, категория.
// Шаблон (DocTemplate) — бланк core/docs + форма полей; кому доступен, решают
// гранты core/access (тип `doc_template`), а не своя таблица.
// Карточка (OrgDocument) — сам документ: файл, стороны, статус, номер, маршрут.
//
// Ссылки на сущности ЧУЖИХ движков (документ core/docs, файлы, заявка
// согласования, запуск процесса) — БЕЗ FK намеренно (паттерн WorkspaceRequisites
// .directorUserId и FileLink): их жизненный цикл свой, и архивация документа в
// движке не должна рвать карточку, которая является юридической записью.
// ============================================================

model DocType {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  // Имя УНИКАЛЬНО среди живых видов организации — партиальный функциональный
  // индекс doc_types_workspace_name_live (workspace_id, lower(name)) WHERE
  // archived_at IS NULL, руками в миграции doc_type_name_unique_live: папка
  // реестра на Диске ключуется именем, и одноимённые виды делили бы одну папку
  // вместе с её грантами.
  name            String
  category        String    @default("general") // hr | general | external — профиль правил и редактора (external = ЭДО, контрагенты)
  // «ПР-{ГГГГ}-{NNN}»: номер присваивается ПРИ РЕГИСТРАЦИИ, черновики номеров не съедают
  numberFormat    String?   @map("number_format")
  visibility      String    @default("managers") // team | department | managers
  // Чем подписывается документ этого вида: none | pep | ecp. Вид ДИКТУЕТ уровень,
  // а не подсказывает: кадровые документы по ст. 33 ТК РК требуют именно ЭЦП, и
  // выбирать это на каждом маршруте вручную — способ однажды забыть.
  signatureLevel  String    @default("none") @map("signature_level")
  toPersonalFile  Boolean   @default(false) @map("to_personal_file")
  // Режим ОБЯЗАТЕЛЬНОГО вручения (ст. 61 п. 3 / ст. 65 ТК РК — акты о прекращении
  // и взыскании): печатный комплект + фиксация способа вручения на карточке.
  specialDelivery Boolean   @default(false) @map("special_delivery")
  // Номенклатурный срок хранения (приказ № 279-НК — до 75 лет). Справочно:
  // enforcement не нужен, подписанное и так не удаляется.
  retentionYears  Int?      @map("retention_years")
  // Откуда установлен (платформенная библиотека кадровых бланков)
  libraryKey      String?   @map("library_key")
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates DocTemplate[]
  counters  DocTypeCounter[]
  documents OrgDocument[]

  @@index([workspaceId])
  @@map("doc_types")
}

// Счётчик номеров: свой на каждый год (1 января нумерация начинается заново).
// Инкремент атомарный — два одновременных «Зарегистрировать» не выдадут один номер.
model DocTypeCounter {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  docTypeId String   @map("doc_type_id") @db.Uuid
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  docType DocType @relation(fields: [docTypeId], references: [id], onDelete: Cascade)

  @@unique([docTypeId, year])
  @@map("doc_type_counters")
}

model DocTemplate {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid // денормализован: выборки идут по организации
  docTypeId   String  @map("doc_type_id") @db.Uuid
  name        String // человеческое: «Отпуск», а не «Заявление о предоставлении…»
  description String?

  // Вид бланка: 'docx' — загруженный Word-файл, 'builder' — блочный конструктор
  kind       String @default("docx")
  // Блоки конструктора (kind='builder'; формат BuilderDoc из shared)
  builderDoc Json?  @map("builder_doc")

  // Бланк — ОБЫЧНЫЙ документ core/docs (правится тем же редактором, что и всё остальное).
  documentId String? @map("document_id") @db.Uuid
  fileId     String? @map("file_id") @db.Uuid // .docx бланка; живёт и без включённого редактора

  fields      Json    @default("[]") // форма подачи: [{key,label,kind,required,options?}]
  // ЯЗЫК БЛАНКА (не интерфейса): на нём печатаются слова платформы внутри
  // документа — «М.П.», «№ … от …», месяц прописью, сумма прописью. Умолчание —
  // язык документов организации; у бланков библиотеки ТК РК он свой (ru).
  language    String  @default("kk")
  selfService Boolean @default(false) @map("self_service") // «сотрудник подаёт сам»
  status      String  @default("draft") // draft | published
  version     Int     @default(1)

  createdById String    @map("created_by_id") @db.Uuid
  // Откуда установлен (платформенная библиотека кадровых бланков) — по нему
  // работает «Обновить» при новой версии каталога.
  libraryKey  String?   @map("library_key")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  docType   DocType       @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents OrgDocument[]

  @@index([workspaceId, status])
  @@index([docTypeId])
  @@map("doc_templates")
}

model OrgDocument {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  docTypeId   String  @map("doc_type_id") @db.Uuid
  templateId  String? @map("template_id") @db.Uuid

  title  String
  // draft | in_review | signed | registered | active | rejected | cancelled | archived
  status String @default("draft")

  number     String? // присваивается при регистрации
  numberedAt DateTime? @map("numbered_at")

  // Сторона документа — сотрудник (заявитель / субъект приказа). У документов
  // «С контрагентами» опциональна (внутренний куратор договора).
  subjectUserId         String? @map("subject_user_id") @db.Uuid
  // ВТОРАЯ сторона — контрагент из справочника (виды категории `external`).
  // БЕЗ FK намеренно (паттерн subjectUserId): карточка документа — юридическая
  // запись, и архивация контрагента её не рвёт.
  counterpartyId        String? @map("counterparty_id") @db.Uuid
  counterpartyContactId String? @map("counterparty_contact_id") @db.Uuid
  createdById           String  @map("created_by_id") @db.Uuid

  documentId String? @map("document_id") @db.Uuid // живой документ core/docs (правка в редакторе)
  // «Один файл — одна карточка» (правило загрузки готового файла). Уникум, а не
  // проверка чтением: две карточки на один файл молча делили бы правку и
  // подписание — заморозка одной закрывала бы редактор другой, а на подпись обе
  // отдавали бы один и тот же PDF. NULL'ы в Postgres различны, поэтому карточки
  // без файла (черновик, пока джоб собирает бланк) уникуму не мешают.
  fileId     String? @unique @map("file_id") @db.Uuid // .docx карточки; у builder-документа — сам PDF
  pdfFileId  String? @map("pdf_file_id") @db.Uuid // отпечаток на момент отправки/подписи
  // Снимок блоков конструктора (документ по builder-шаблону или свободный документ);
  // у docx-документов null. Снимок, а не ссылка: правка шаблона не меняет поданное.
  builderDoc Json?   @map("builder_doc")
  // Снимок ЯЗЫКА БЛАНКА: документ печатается одинаково всегда, даже если
  // шаблон потом переведут на другой язык.
  language   String  @default("kk")

  fields     Json  @default("{}") // значения формы подачи
  // Объявление полей СВОБОДНОГО документа (без шаблона): у документа по шаблону
  // форма живёт в шаблоне, здесь null — двух источников правды быть не должно.
  formFields Json? @map("form_fields")

  approvalRequestId String? @map("approval_request_id") @db.Uuid
  processInstanceId String? @map("process_instance_id") @db.Uuid
  parentDocumentId  String? @map("parent_document_id") @db.Uuid // приказ ← заявление

  // КЭДО: кадровое действие, породившее документ (без FK — паттерн subjectUserId)
  hrActionId          String?   @map("hr_action_id") @db.Uuid
  // Гибридный режим: как документ доводится до работника. electronic — подпись/
  // ознакомление в системе; paper — печатный комплект; hybrid — и то и другое.
  deliveryMode        String    @default("electronic") @map("delivery_mode")
  // Фиксация ВРУЧЕНИЯ (specialDelivery-виды: ст. 61 п. 3 — 3 рабочих дня)
  deliveredAt         DateTime? @map("delivered_at")
  deliveryMethod      String?   @map("delivery_method") // in_person | refusal_act | registered_mail
  deliveryTrackNumber String?   @map("delivery_track_number")

  // Узлы Диска: реестр вида и личное дело — ОДИН файл, два места (байты не дублируются).
  registryNodeId String? @map("registry_node_id") @db.Uuid
  personalNodeId String? @map("personal_node_id") @db.Uuid

  signedAt   DateTime? @map("signed_at")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docType   DocType       @relation(fields: [docTypeId], references: [id])
  template  DocTemplate?  @relation(fields: [templateId], references: [id])
  parent    OrgDocument?  @relation("OrgDocumentChain", fields: [parentDocumentId], references: [id])
  children  OrgDocument[] @relation("OrgDocumentChain")

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, docTypeId])
  @@index([subjectUserId])
  @@index([workspaceId, counterpartyId])
  @@index([templateId])
  @@index([parentDocumentId])
  @@index([processInstanceId])
  @@index([hrActionId])
  @@map("org_documents")
}

// ============================================================
// core/sign — движок электронной подписи (15-й платформенный)
// ============================================================
// Шаг 3 документной вертикали. До него подпись в платформе была
// `ApprovalDecision.signatureKind='internal'` — нажатие кнопки, юридической силы
// ноль. Движок отвечает за акт подписи, криптографию и её проверку, ВЕЧНЫЕ
// доказательства, экспорт и публичную проверку (ст. 61 Цифрового кодекса РК).
//
// Маршрута здесь НЕТ: маршрут — это core/approvals (шаг `signature`) и Процессы.
// Направление знания одностороннее: sign → approvals, как у любого потребителя.
//
// ХРАНЕНИЕ ВЕЧНОЕ. Ретеншн-кроны этих таблиц НЕ КАСАЮТСЯ: срок хранения
// доказательств равен сроку хранения самого документа (приказ № 279-НК — до 75
// лет). Поэтому же FK на акт стоит `Restrict`, а ссылки на чужие сущности —
// вообще без FK (паттерн ApprovalRequest / ShareLink / FileLink).

/// Заявка на подпись: ЧТО подписываем, каким уровнем и кто должен подписать.
/// Один предмет и один раунд сбора; «на доработку» закрывает заявку, повторная
/// подача порождает новый маршрут, новый шаг и новую заявку с новым отпечатком.
model SignRequest {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  refType  String  @map("ref_type") // org_document | (дальше — счета, договоры ЭДО, файлы Диска)
  refId    String  @map("ref_id")
  // Снимок названия предмета — тот же довод, что у ApprovalRequest.refTitle и
  // ShareLink.refTitle: список не зовёт резолвер на каждую строку, переживает
  // удаление объекта и не светит ТЕКУЩЕЕ имя тому, у кого доступ отобрали.
  refTitle String  @map("ref_title")
  refIcon  String? @map("ref_icon")

  workspaceId String? @map("workspace_id") @db.Uuid

  // ЗАМОРОЖЕННЫЙ предмет. Движок сам читает байты у потребителя и кладёт их
  // ОТДЕЛЬНЫМ неизменяемым файлом (профиль sign_subject), а не ссылается на
  // живой: у документа PDF существует лишь ВАРИАНТОМ файла и умирает при первой
  // же правке (replaceContent сносит производные) — подписанные байты можно было
  // бы физически потерять. Подписанту показывается эта копия, и над ней же
  // считается CMS: «что видел = что подписал» по построению, а не по
  // договорённости потребителя.
  subjectFileId String @map("subject_file_id") @db.Uuid
  subjectSha256 String @map("subject_sha256")

  level   String // ecp | pep
  methods String[] @default([]) // qr | ncalayer | pep_otp — что разрешено этой заявкой
  status  String   @default("pending") // pending | completed | declined | cancelled | expired

  // Шаг маршрута, который закроется подписью. Заводится ЛЕНИВО и идемпотентно
  // (партиальный UNIQUE ниже), потому что заявка на подпись нужна только тогда,
  // когда до шага реально дошли, а не при создании всего маршрута.
  approvalStepId String? @map("approval_step_id") @db.Uuid

  // ШТАМПОВАННАЯ копия (внешний этап ЭДО, Doodocs-модель): итоговый PDF с
  // полосами-штампами на каждой странице и «Листом подписей» в конце. Собирается
  // джобом `sign.stamp` после завершения заявки. НЕ доказательство — при потере
  // пересобирается из subject + актов (профиль sign_stamped вне evidence-режима).
  stampedFileId String? @map("stamped_file_id") @db.Uuid
  stampedSha256 String? @map("stamped_sha256")

  // Потребитель САМ рассказывает людям об исходе (ЭДО шлёт свои «контрагент
  // подписал/отказал» с контекстом документа) — движковые sign.completed и
  // sign.declined для такой заявки подавлены, иначе автор получал бы дубль.
  // Флаг на СТРОКЕ, а не в payload джоба: SIGN_FINISHED_JOB читает заявку из БД.
  // sign.requested (позвать внутренних подписантов) НЕ подавляется.
  suppressOutcomeNotify Boolean @default(false) @map("suppress_outcome_notify")

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  completedAt DateTime? @map("completed_at")

  acts SignAct[]

  @@index([refType, refId])
  @@index([workspaceId, status, createdAt])
  // Публичная проверка по отпечатку файла (ст. 61 ЦК): проверяющий приносит СВОЙ
  // файл, браузер считает sha256, на сервер уходит только хэш.
  @@index([subjectSha256])
  // Публичная проверка находит и ШТАМПОВАННУЮ копию: у неё свой отпечаток,
  // отличный от подписанного оригинала (matchedBy: 'stamped_copy').
  @@index([stampedSha256])
  // ВНИМАНИЕ: партиальный UNIQUE (approval_step_id) WHERE status='pending'
  // дописан РУКАМИ в миграции `sign_engine` — Prisma такое не выражает.
  // «Одна живая заявка на шаг»: ленивое создание идемпотентно даже в гонке.
  //
  // ВНИМАНИЕ-2: партиальный UNIQUE `sign_requests_one_active_freeform`
  // (ref_type, ref_id) WHERE status='pending' AND approval_step_id IS NULL —
  // РУКАМИ в миграции `sign_external_stage`: одна живая СВОБОДНАЯ заявка на
  // предмет (двойная отправка контрагенту невозможна даже в гонке; кадровым
  // шаговым заявкам не мешает — у них свой per-step уникум).
  @@map("sign_requests")
}

/// Акт — ОДНА подпись ОДНОГО лица. Самодостаточен: несёт свою копию отпечатка,
/// снимок имени подписанта и замороженные вердикты проверки сертификата.
model SignAct {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId String @map("request_id") @db.Uuid

  signerType    String  @map("signer_type") // user | guest
  signerUserId  String? @map("signer_user_id") @db.Uuid
  // Гость внешней ссылки (ShareLinkGuest): личность = подтверждённый номер + ИИН
  // из ключа. FK нет намеренно — доказательство переживает уборку чего угодно.
  signerGuestId String? @map("signer_guest_id") @db.Uuid
  // Снимок имени: акт обязан читаться и после удаления аккаунта.
  signerName    String  @map("signer_name")
  signerPhone   String? @map("signer_phone") // ПЭП и гость: чем подтверждали личность

  method String? // qr | ncalayer | pep_otp — null, пока подписант не выбрал
  level  String // ecp | pep
  status String  @default("pending") // pending | signed | declined | failed | expired

  // Копия отпечатка с заявки: акт не должен требовать join, чтобы ответить на
  // главный вопрос «под чем стоит эта подпись».
  subjectSha256 String @map("subject_sha256")

  // ---- ЭЦП ----
  // CMS лежит в core/files, а не в bytea: миллионы подписей × ~10 КБ раздули бы
  // TOAST, WAL и бэкапы. Целостность держит cmsSha256 на строке + запись файла
  // ДО финализации акта.
  cmsFileId String? @map("cms_file_id") @db.Uuid
  cmsSha256 String? @map("cms_sha256")

  certSubjectCn       String?   @map("cert_subject_cn")
  // ИИН/БИН разбираются из сертификата. Расхождение с users.iin — ОТКАЗ, а не
  // предупреждение: иначе подпись доказывает не того человека.
  certSubjectIin      String?   @map("cert_subject_iin")
  // ПДн под движком ключей: ИИН подписанта — envelope (платформенный KEK) + слепой индекс «все подписи ИИН»
  certSubjectIinEnc   String?   @map("cert_subject_iin_enc")
  certSubjectIinBi    String?   @map("cert_subject_iin_bi")
  certSubjectIinBiAlt String?   @map("cert_subject_iin_bi_alt")
  certSubjectBin      String?   @map("cert_subject_bin")
  certSerial          String?   @map("cert_serial")
  certIssuerCn        String?   @map("cert_issuer_cn")
  certNotBefore       DateTime? @map("cert_not_before")
  certNotAfter        DateTime? @map("cert_not_after")

  // Вердикты ЗАМОРАЖИВАЮТСЯ в момент подписи и НИКОГДА не пересчитываются:
  // юридически значим статус сертификата ТОГДА (приказ № 1187 требует проверки
  // цепочки, OCSP на момент подписания и метки TSP). Через год сертификат
  // истечёт, и живая проверка не докажет ничего.
  chainValid Boolean?  @map("chain_valid")
  ocspStatus String?   @map("ocsp_status") // good | revoked | unknown
  ocspAt     DateTime? @map("ocsp_at")
  ocspFileId String?   @map("ocsp_file_id") @db.Uuid // сырая квитанция для сторонней проверки
  tspAt      DateTime? @map("tsp_at") // метка доверенного времени = юридическое время
  tspSerial  String?   @map("tsp_serial")
  tspFileId  String?   @map("tsp_file_id") @db.Uuid

  // ---- ПЭП ----
  verifyChallengeId String? @map("verify_challenge_id") @db.Uuid // цепочка core/verify (purpose sign_pep)
  // СНИМОК текста соглашения сторон + его версия. Ссылка на «текущую редакцию»
  // доказательством не является: доказывать придётся тот текст, который человек
  // видел (ст. 47 ЦК — ПЭП равнозначна подписи ПО СОГЛАШЕНИЮ СТОРОН).
  consentText       String? @map("consent_text")
  consentVersion    String? @map("consent_version")

  // Юридическое время подписи: у ЭЦП это метка TSP, у ПЭП — время системы.
  signedAt      DateTime? @map("signed_at")
  declineReason String?   @map("decline_reason")
  failureCode   String?   @map("failure_code") // машинный код отказа проверки

  // Токен ПУБЛИЧНОЙ страницы проверки: печатается в QR на протоколе подписания,
  // то есть живёт на бумаге у третьих лиц.
  checkToken String @unique @map("check_token")

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  request    SignRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  events     SignActEvent[]
  qrSessions SignQrSession[]

  @@index([requestId])
  @@index([signerUserId, signedAt])
  // «Найти все подписи этого ИИН» — запрос проверяющего и будущего аудита.
  @@index([certSubjectIin])
  @@index([certSubjectIinBi])
  @@index([certSubjectIinBiAlt])
  @@index([status, createdAt])
  // ВНИМАНИЕ: партиальный UNIQUE (request_id, signer_user_id)
  // WHERE status IN ('pending','signed') дописан РУКАМИ в миграции `sign_engine`
  // (прецедент approvals_origin_unique): один человек — одна живая подпись на
  // заявку. Отказавшийся и не прошедший проверку могут зайти ещё раз.
  @@map("sign_acts")
}

/// Протокол подписания — append-only лента событий акта.
/// Отдельная таблица, а не поля строки: для суда важны независимость записи и
/// ПОРЯДОК (прецеденты ShareLinkVisit и LedgerTransfer — журнал не переписывают).
/// BigInt id = он же курсор; наружу ВСЕГДА строкой.
model SignActEvent {
  id    BigInt @id @default(autoincrement())
  actId String @map("act_id") @db.Uuid
  type  String // created | viewed | consent | otp_sent | otp_verified | qr_issued | qr_claimed | cms_received | chain_checked | signed | declined | failed

  at        DateTime @default(now())
  ip        String?
  userAgent String?  @map("user_agent")
  data      Json?

  act SignAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId, id])
  @@map("sign_act_events")
}

/// Одноразовая сессия подписания через eGov Mobile (мост Smart Bridge, сервис
/// NITEC-S-5096). Паспорт сервиса ТРЕБУЕТ публичных HTTPS-URL, ограниченных по
/// времени и числу обращений, — отсюда два разных @unique-токена (за данными и
/// за подписью ходят разными запросами) и жёсткая статус-машина: второе
/// обращение отбивает статус-гвард `updateMany`, а не проверка в приложении.
model SignQrSession {
  id    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actId String @map("act_id") @db.Uuid

  dataToken String @unique @map("data_token")
  signToken String @unique @map("sign_token")

  status      String  @default("issued") // issued | claimed | submitted | expired
  // Идентификатор процедуры на стороне моста (формат eGov mobile изолирован в драйвере)
  procedureId String? @map("procedure_id")

  claimedAt   DateTime? @map("claimed_at")
  submittedAt DateTime? @map("submitted_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // FK внутри движка есть (наружу — нет): сессия без своего акта бессмысленна,
  // а Cascade избавляет от сирот при удалении тестовых данных.
  act SignAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId])
  @@index([status, expiresAt])
  @@map("sign_qr_sessions")
}

// ============================================================
// КЭДО — кадровый электронный документооборот (modules/hr, шаг 5 документной
// вертикали). Данные о трудовых отношениях — домен «Сотрудников», бумаги о них —
// домен «Документооборота»; hr их связывает и ничего не хранит дважды.
// ============================================================

/// Юридический план трудовых отношений («по договору»). Живёт РЯДОМ с фактом
/// (StaffAssignment): расхождение — плашка, не ошибка. Снимки названий должности
/// и филиала — документ печатает то, о чём договорились, даже если справочник
/// потом переименуют.
model Employment {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String  @map("workspace_id") @db.Uuid
  userId          String  @map("user_id") @db.Uuid // без FK (паттерн OrgDocument.subjectUserId)
  // РАБОТОДАТЕЛЬ по договору. Restrict: юрлицо с карточками только архивируется.
  // Совместительство внутри организации = вторая карточка в ДРУГОМ юрлице.
  legalEntityId   String  @map("legal_entity_id") @db.Uuid
  legalEntityName String? @map("legal_entity_name") // снимок на момент договора (как legalBranchName)

  status String @default("draft") // draft | active | terminated

  hiredAt         DateTime? @map("hired_at") @db.Date
  firedAt         DateTime? @map("fired_at") @db.Date
  dismissalGround String?   @map("dismissal_ground") // код справочника статей ТК РК

  contractNumber          String?   @map("contract_number")
  contractDate            DateTime? @map("contract_date") @db.Date
  contractType            String    @default("indefinite") @map("contract_type") // indefinite | fixed_term | seasonal | task_based
  contractEndAt           DateTime? @map("contract_end_at") @db.Date
  // Ст. 30 ТК РК: продление срочного договора молчанием — максимум 2 раза,
  // дальше договор считается бессрочным (плашка в интерфейсе, не блок).
  contractExtensionsCount Int       @default(0) @map("contract_extensions_count")

  probationUntil DateTime? @map("probation_until") @db.Date

  // Снимок должности/филиала ПО ДОГОВОРУ (факт живёт в StaffAssignment)
  legalPositionId   String? @map("legal_position_id") @db.Uuid
  legalPositionName String? @map("legal_position_name")
  legalBranchId     String? @map("legal_branch_id") @db.Uuid
  legalBranchName   String? @map("legal_branch_name")

  workRate     Float?  @default(1) @map("work_rate") // ставка: 1 / 0.5 / 0.25
  workSchedule String? @map("work_schedule") // «5/2, 09:00–18:00»

  // Оклад — СНИМКОМ на карточке (тиыны). Видят Менеджер+ и сам человек:
  // приказ о приёме обязан печатать оклад (ст. 28 ТК — обязательное условие).
  salaryAmount   BigInt? @map("salary_amount")
  salaryCurrency String  @default("KZT") @map("salary_currency")

  // Гибрид — ПОСТОЯННЫЙ режим, не этап миграции: обязать работника получить
  // ЭЦП нельзя. true → подписи работника заменяет печать комплекта + фиксация
  // вручения (скан подшивается в дело).
  paperMode Boolean @default(false) @map("paper_mode")

  personnelNumber String? @map("personnel_number") // табельный (под 1С)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([userId])
  @@index([legalEntityId])
  // ВНИМАНИЕ: партиальный UNIQUE (workspace_id, user_id, legal_entity_id)
  // WHERE status <> 'terminated' дописан РУКАМИ (миграция `legal_entities`) —
  // «одна живая трудовая карточка на человека В КАЖДОМ юрлице»; повторный приём
  // после увольнения = новая строка.
  @@map("hr_employments")
}

/// Кадровое действие — ПЕРВИЧНО, документ производен: «Уволить» → приказ →
/// подпись → применение. `scheduled` = документы подписаны, ждёт effectiveAt
/// (иначе списки не различают «на подписи» и «вступает в силу 01.09»).
model HrAction {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid // субъект действия (сотрудник)

  kind   String // hire | transfer | salary_change | leave | dismissal
  status String @default("draft") // draft | in_progress | scheduled | applied | cancelled | failed
  // Та же сущность, два входа: заявление работника и решение работодателя
  source String @default("employer") // employee | employer

  effectiveAt DateTime  @map("effective_at") @db.Date
  effectiveTo DateTime? @map("effective_to") @db.Date // период отпуска

  params Json @default("{}")

  batchId      String?   @map("batch_id") @db.Uuid
  employmentId String?   @map("employment_id") @db.Uuid // без FK: действие — историческая запись
  appliedAt    DateTime? @map("applied_at")
  failReason   String?   @map("fail_reason")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, effectiveAt])
  @@index([workspaceId, userId, createdAt])
  @@index([batchId])
  @@map("hr_actions")
}

/// Массовая кадровая операция: один вид, общие параметры, аудитория из ростера.
/// Потолок 500 за прогон; экран прогресса читает свои действия по batchId.
model HrActionBatch {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  kind     String
  params   Json   @default("{}")
  audience Json   @default("[]") // принципалы [{type,id}] — снимок выбора
  total    Int    @default(0)
  status   String @default("running") // running | done | cancelled

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("hr_action_batches")
}

/// Очередь сдачи в ЕСУТД (erdo.enbek.kz). Правила № 353: заключение — 5 РАБОЧИХ
/// дней от подписания обеими сторонами, изменения — 15 КАЛЕНДАРНЫХ, прекращение —
/// 3 РАБОЧИХ. `payload` — снимок сведений по перечню Правил («Скопировать
/// сведения» отдаёт ровно то, что просит форма enbek). После сдачи прекращения
/// правка — только через госорган по труду (п. 13): валидация строго ДО отправки.
model EsutdSubmission {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  kind         String // contract | amendment | termination
  hrActionId   String? @map("hr_action_id") @db.Uuid
  employmentId String? @map("employment_id") @db.Uuid

  dueAt  DateTime @map("due_at") @db.Date // посчитан по производственному календарю
  status String   @default("pending") // pending | submitted | failed | not_required

  submittedAt     DateTime? @map("submitted_at")
  submittedById   String?   @map("submitted_by_id") @db.Uuid
  externalNumber  String?   @map("external_number")
  // Окно исправления ошибочно внесённых сведений — 30 РАБОЧИХ дней без штрафа
  // (разъяснения к ст. 98 КоАП); считается при отметке о сдаче.
  correctionUntil DateTime? @map("correction_until") @db.Date

  payload Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueAt])
  @@index([hrActionId])
  @@map("hr_esutd_submissions")
}

/// Производственный календарь РК. Машиночитаемого госисточника НЕТ — сид руками
/// из календаря МТСЗН, переносы постановлениями Правительства в течение года →
/// патч-сид новой версией кода. Расчёт срока за горизонтом засеянных лет —
/// ЧЕСТНЫЙ ОТКАЗ, а не пессимистичный счёт (недосчёт = штраф).
model WorkCalendarDay {
  id   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date DateTime @unique @db.Date
  // holiday — праздничный (Закон № 267-II; переносится при совпадении с выходным)
  // dayoff — выходной по п. 5 ст. 84 ТК (7 января, Курбан-айт; НЕ переносится)
  // transferred — нерабочий день, назначенный постановлением (перенос)
  // workday — РАБОЧАЯ суббота/воскресенье (компенсация переноса)
  // shortened — предпраздничный сокращённый (рабочий)
  kind String
  name String

  @@map("hr_work_calendar_days")
}

/// Личная запись-архив сотрудника («Мои документы»). ПЕРЕЖИВАЕТ увольнение И
/// purge организации: workspace каскадом уничтожает OrgDocument, а эта строка —
/// снимки + FileLink `personal_doc` на ТОТ ЖЕ FileObject (байты не дублируются,
/// файл получает живое место — реап сирот его не трогает). FK нет ни одного
/// намеренно. Создаётся в транзакции события «документ достиг человека».
model PersonalDocRecord {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  workspaceId   String  @map("workspace_id") @db.Uuid // снимок, БЕЗ FK
  workspaceName String  @map("workspace_name")
  orgDocumentId String? @map("org_document_id") @db.Uuid // без FK — карточка умрёт с организацией

  title       String
  number      String?
  docTypeName String? @map("doc_type_name")

  fileId        String  @map("file_id") @db.Uuid
  stampedFileId String? @map("stamped_file_id") @db.Uuid // дописывается джобом по готовности штампа
  signRequestId String? @map("sign_request_id") @db.Uuid // без FK

  kind      String // signed | acknowledged | delivered
  reachedAt DateTime @default(now()) @map("reached_at")

  @@index([userId, reachedAt])
  @@index([orgDocumentId])
  // ВНИМАНИЕ: партиальный UNIQUE (user_id, org_document_id, kind)
  // WHERE org_document_id IS NOT NULL — РУКАМИ в миграции `hr_kedo`: одно событие
  // «достиг» не пишется дважды (подпись и вручение — разные kind, обе живут).
  @@map("hr_personal_doc_records")
}

/// Кампания ознакомления (ст. 23 п. 2 пп. 6 ТК: факт ознакомления подписи НЕ
/// требует — «посредством электронной почты и иных ИКТ»). Одна заморозка
/// предмета на всю кампанию; у каждого адресата своё задание со статусом.
model DocCampaign {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  title         String
  // Заголовок собрала ПЛАТФОРМА (человек своего не задал): ключ каталога и параметры.
  // `title` — снимок в языке источника (поиск, фолбэк старых кампаний), читателю
  // заголовок собирается на его языке. Набранный человеком заголовок ключа не имеет.
  titleKey      String? @map("title_key")
  titleParams   Json?   @map("title_params")
  orgDocumentId String  @map("org_document_id") @db.Uuid // без FK: предмет заморожен своей копией

  // Заморозка предмета кампании: что видел каждый адресат (профиль sign_subject)
  subjectFileId String @map("subject_file_id") @db.Uuid
  subjectSha256 String @map("subject_sha256")

  mode    String @default("one_off") // one_off | standing (догоняет принятых позже)
  // click — фиксация: acknowledgedAt + sha256 в target + хроника (бесплатно, законно);
  // sms — SignRequest + акты ПЭП: усиленное доказательство для критичных ЛНА
  fixMode String @default("click") @map("fix_mode")
  status  String @default("active") // active | done | cancelled

  audience Json @default("[]") // принципалы [{type,id}]; 'workspace' = вся команда

  signRequestId String?   @map("sign_request_id") @db.Uuid // sms-режим: заявка refType='doc_campaign'
  dueAt         DateTime? @map("due_at") @db.Date

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets   DocCampaignTarget[]

  @@index([workspaceId, status, createdAt])
  @@map("doc_campaigns")
}

/// Задание одного адресата кампании. `sms_failed` — ОТДЕЛЬНЫЙ исход (недоставленная
/// SMS не равна «не ознакомился»). `subjectSha256` — отпечаток на момент фиксации:
/// вечный след «с чем именно ознакомился» в click-режиме.
model DocCampaignTarget {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  status         String    @default("pending") // pending | acknowledged | sms_failed
  acknowledgedAt DateTime? @map("acknowledged_at")
  subjectSha256  String?   @map("subject_sha256")
  signActId      String?   @map("sign_act_id") @db.Uuid // sms-режим: акт ПЭП
  remindedAt     DateTime? @map("reminded_at")

  createdAt DateTime @default(now()) @map("created_at")

  campaign DocCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, status])
  @@map("doc_campaign_targets")
}

/// Что из платформенной библиотеки кадровых бланков установлено в организацию.
/// Сам каталог — В КОДЕ (`hr-library.ts` в shared): сменился ТК РК — правим у
/// себя и предлагаем обновление, а не чиним у 500 клиентов.
model DocTemplateLibraryInstall {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  libraryKey  String @map("library_key")
  version     Int    @default(1)

  docTypeId  String  @map("doc_type_id") @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  processId  String? @map("process_id") @db.Uuid // опубликованный маршрут, заведённый мастером

  installedById String   @map("installed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, libraryKey])
  @@map("doc_template_library_installs")
}

// ============================================================
// ЗАМЕТКИ (modules/notes): пространства, дерево папок, заметки со своим JSON-документом
// и производными проекциями (Markdown, чистый текст, чанки), версии, ссылки, доска стикеров.
//
// Права: core/access хранит гранты на note_space / note_folder / note, наследование по
// дереву считает сервис ОДНИМ условием (folder_path && granted) — модель Диска. Чтение
// прав только через grantSetFor (EPOCH_FANOUT пустой), поэтому массивы предков
// материализованы и покрыты GIN.
// ============================================================

/// Пространство заметок: личное (user) или организации (workspace). Создаётся лениво.
model NoteSpace {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType String   @map("owner_type") // user | workspace
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  folders    NoteFolder[]
  notes      Note[]
  boardItems NoteBoardItem[]
  chunks     NoteChunk[]

  @@unique([ownerType, ownerId])
  @@map("note_spaces")
}

/// Папка заметок (дерево). ancestor_ids — предки от корня БЕЗ себя.
model NoteFolder {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  spaceId     String    @map("space_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  // NFC + нижний регистр — по нему живёт частичный unique «одно имя в папке» (руками в миграции)
  nameKey     String    @map("name_key")
  color       String?
  ancestorIds String[]  @default([]) @map("ancestor_ids") @db.Uuid
  depth       Int       @default(0)
  sortRank    Int       @default(0) @map("sort_rank")
  createdById String    @map("created_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  space    NoteSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   NoteFolder?  @relation("NoteFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteFolder[] @relation("NoteFolderTree")
  notes    Note[]

  // РУКАМИ в миграции notes (Prisma не выражает WHERE и выражения):
  //   CREATE UNIQUE INDEX note_folder_name_uniq ON note_folders (space_id, COALESCE(parent_id, ''), name_key) WHERE deleted_at IS NULL;
  @@index([spaceId, parentId])
  @@index([ancestorIds(ops: ArrayOps)], map: "note_folder_anc", type: Gin)
  @@map("note_folders")
}

/// Заметка. content — СВОЙ формат NoteDoc (единственная правда); content_md/plain_text —
/// производные проекции, которые сервер пересчитывает в той же транзакции сохранения.
model Note {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  spaceId     String    @map("space_id") @db.Uuid
  folderId    String?   @map("folder_id") @db.Uuid
  // [folder_id, ...ancestor_ids папки]: один GIN-предикат наследования грантов с папок
  folderPath  String[]  @default([]) @map("folder_path") @db.Uuid
  title       String    @default("")
  content     Json
  contentMd   String    @default("") @map("content_md")
  plainText   String    @default("") @map("plain_text")
  contentHash String    @map("content_hash")
  version     Int       @default(1)
  color       String?
  tags        String[]  @default([])
  pinnedAt    DateTime? @map("pinned_at")
  createdById String    @map("created_by_id") @db.Uuid
  updatedById String    @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  space      NoteSpace       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder     NoteFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  revisions  NoteRevision[]
  links      NoteLink[]
  boardItems NoteBoardItem[]
  chunks     NoteChunk[]

  @@index([spaceId, folderId, deletedAt])
  @@index([spaceId, updatedAt(sort: Desc)])
  @@index([folderPath(ops: ArrayOps)], map: "note_folder_path", type: Gin)
  @@index([tags(ops: ArrayOps)], map: "note_tags", type: Gin)
  // Корзина: purge-джоб идёт по deleted_at (руками в миграции — частичный:
  //   CREATE INDEX note_trash ON notes (deleted_at) WHERE deleted_at IS NOT NULL;)
  @@map("notes")
}

/// Снимок содержимого на каждое принятое сохранение (кап — NOTE_LIMITS.revisionsKeep).
model NoteRevision {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  noteId      String   @map("note_id") @db.Uuid
  version     Int
  content     Json
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
  @@map("note_revisions")
}

/// Ссылка заметки: вики-ссылка на заметку (kind=wikilink, target_type=note) или
/// привязка к бизнес-сущности (kind=related). Обратные ссылки и панель «Заметки» на
/// карточке сущности — один запрос по (target_type, target_id).
model NoteLink {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  noteId      String   @map("note_id") @db.Uuid
  targetType  String   @map("target_type") // note | task | counterparty | branch | document
  targetId    String   @map("target_id")
  kind        String // wikilink | related
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, targetType, targetId, kind])
  @@index([targetType, targetId])
  @@map("note_links")
}

/// Раскладка карточки заметки на доске зрителя (per-user): позиция в пикселях холста,
/// размер, слой, свёрнутость. Доска — вид на раздел; строка появляется при первом жесте.
model NoteBoardItem {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  folderId  String?  @map("folder_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  x         Float    @default(10) // пиксели холста доски от левого верхнего угла
  y         Float    @default(10)
  w         Int      @default(260) // пиксели
  h         Int      @default(220)
  z         Int      @default(1)
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  note  Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  space NoteSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId, spaceId, folderId])
  @@map("note_board_items")
}

/// Чанк заметки под RAG: структурная нарезка по заголовкам с контекст-префиксом.
/// Колонка embedding появится задачей pgvector (core/embeddings) — строки уже готовы.
model NoteChunk {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  noteId        String   @map("note_id") @db.Uuid
  spaceId       String   @map("space_id") @db.Uuid
  ord           Int
  headingPath   String[] @default([]) @map("heading_path")
  text          String
  contextPrefix String   @map("context_prefix")
  tokenCount    Int      @map("token_count")
  contentHash   String   @map("content_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  note  Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  space NoteSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([noteId, ord])
  @@index([spaceId])
  @@map("note_chunks")
}

// ============================================================
// core/entitlements — тариф и лимиты (19-й платформенный движок)
// ============================================================
// План — ступень (ключ в коде); значения — версиями JSONB; подписка субъекта
// (человек/организация/семья) указывает на версию; гранты и оверрайды — поверх;
// расходуемые квоты — счётчиками. Free = отсутствие живой подписки.

/// Тарифная ступень. Ключи и субъект — из `PLAN_DEFS` (@superapp/shared).
model Plan {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String   @unique
  subjectType String   @map("subject_type") // user | workspace | family
  status      String   @default("active") // active | archived
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions PlanVersion[]

  @@map("plans")
}

/// Версия значений плана. Опубликованная версия НЕИЗМЕНЯЕМА (правка = новая версия);
/// черновик правится инлайн и в продукт не попадает до публикации.
model PlanVersion {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId       String    @map("plan_id") @db.Uuid
  version      Int
  status       String    @default("draft") // draft | published | archived
  region       String    @default("KZ")
  /// `{ "<ключ реестра>": значение }` — только ключи реестра, проверяется при публикации
  entitlements Json      @default("{}")
  note         String?
  publishedAt  DateTime? @map("published_at")
  publishedBy  String?   @map("published_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  plan          Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions SubjectSubscription[]

  @@unique([planId, version])
  @@index([planId, status])
  @@map("plan_versions")
}

/// Подписка субъекта на версию плана. Полиморфный субъект без FK (`forgetSubject`
/// чистит при удалении человека / purge организации).
/// Партиальные уникумы — РУКАМИ в миграции (Prisma не выражает):
///   одна ЖИВАЯ подписка на субъект — UNIQUE (subject_type, subject_id)
///     WHERE status IN ('trialing','active','past_due');
///   один бизнес-триал на человека — UNIQUE (trial_consumed_by)
///     WHERE subject_type = 'workspace' AND trial_consumed_by IS NOT NULL.
model SubjectSubscription {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType      String    @map("subject_type") // user | workspace | family
  subjectId        String    @map("subject_id")
  planVersionId    String    @map("plan_version_id") @db.Uuid
  status           String // trialing | active | past_due | expired | cancelled
  startedAt        DateTime  @default(now()) @map("started_at")
  trialEndsAt      DateTime? @map("trial_ends_at")
  currentPeriodEnd DateTime? @map("current_period_end")
  graceUntil       DateTime? @map("grace_until")
  cancelledAt      DateTime? @map("cancelled_at")
  source           String // trial | manual | migration | payment
  /// Кто потратил свой единственный бизнес-триал (владелец организации)
  trialConsumedBy  String?   @map("trial_consumed_by")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id])

  @@index([subjectType, subjectId, status])
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@index([status, graceUntil])
  @@map("subject_subscriptions")
}

/// Единый слой грантов: подарок, триал, семья, add-on, ручной, наследный (`premiumUntil`).
/// Сливаются с планом по правилу ключа (feature=OR, limit=MAX, quota=SUM).
model EntitlementGrant {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  key            String
  value          Json
  source         String // gift | trial | family | addon | manual | legacy
  priority       Int       @default(0)
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  validUntil     DateTime? @map("valid_until")
  reason         String?
  grantedBy      String?   @map("granted_by")
  /// Идемпотентность источника (`legacy:premium:<userId>`, платёж, кампания)
  idempotencyKey String    @unique @map("idempotency_key")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([subjectType, subjectId, key])
  @@index([validUntil])
  @@map("entitlement_grants")
}

/// Индивидуальное условие на субъект по ключу — ПОСЛЕДНИЙ слой резолва.
/// Причина и срок обязательны: бессрочных ручных условий не бывает.
model EntitlementOverride {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  key         String
  mode        String // set | unlimited | deny
  value       Json?
  reason      String
  validUntil  DateTime @map("valid_until")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, key])
  @@index([validUntil])
  @@map("entitlement_overrides")
}

/// Счётчик расходуемой квоты (обобщение прежнего FileQuotaUsage на все ключи).
/// Период (day/month) — ленивый сброс тем же UPDATE; без периода — навсегда (байты Диска).
model QuotaCounter {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id")
  key         String
  used        BigInt    @default(0)
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, key])
  @@map("quota_counters")
}

// ============================================================
// core/platform — кабинет платформы (20-й платформенный движок)
// ============================================================
// Сотрудники платформы и их права живут ОТДЕЛЬНО от `user_roles` продукта:
// ошибка тенантной логики не должна эскалировать на платформу. Все мутации —
// через исполнитель команд, каждая — строкой в append-only журнале.

/// Сотрудник платформы. Суспенд отзывает все сессии кабинета.
model PlatformStaff {
  userId      String    @id @map("user_id") @db.Uuid
  status      String    @default("active") // active | suspended
  note        String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  suspendedAt DateTime? @map("suspended_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  roles PlatformStaffRole[]

  @@map("platform_staff")
}

/// Роль сотрудника (`PLATFORM_ROLES` в @superapp/shared). Scope — задел под узкие роли.
model PlatformStaffRole {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String
  scope     Json      @default("{\"kind\":\"global\"}")
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  reason    String

  staff PlatformStaff @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_staff_roles")
}

/// Сессия кабинета: токен без refresh, 8 часов, простой 20 минут (метка в Redis).
model PlatformSession {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  ip           String?
  userAgent    String?   @map("user_agent")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  // Раннер сроков: отозванные сессии Кабинета (правило revokedAt, core/lifecycle)
  @@index([revokedAt])
  @@map("platform_sessions")
}

/// Политика кабинета — одна строка JSON (`dualControlEnabled`, …). Меняется командой.
model PlatformPolicy {
  id        String   @id @default("default")
  policy    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_policy")
}

/// Заявка four-eyes: команда с `dualControl` при включённой политике ждёт второго
/// сотрудника (core/approvals, refType `platform_command`), затем исполняется той же
/// транзакцией с `approvalId` в журнале. `input` — ПОЛНЫЙ (нужен исполнению);
/// наружу отдаётся `inputRedacted`.
model PlatformCommandRequest {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  commandKey      String    @map("command_key")
  commandVersion  Int       @default(1) @map("command_version")
  input           Json
  inputRedacted   Json?     @map("input_redacted")
  targetType      String?   @map("target_type")
  targetId        String?   @map("target_id")
  actorId         String    @map("actor_id") @db.Uuid
  reason          String?
  ticketRef       String?   @map("ticket_ref")
  idempotencyKey  String    @map("idempotency_key")
  status          String    @default("pending") // pending | approved | rejected | executed | cancelled | failed
  approvalId      String?   @map("approval_id") @db.Uuid
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  decisionComment String?   @map("decision_comment")
  /// `event_id` события `platform.command.executed` исполнения (core/audit)
  executedAuditId String?   @map("executed_audit_id") @db.Uuid
  errorCode       String?   @map("error_code")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([actorId, commandKey, idempotencyKey])
  @@index([status, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("platform_command_requests")
}

// ============================================================
// core/analytics (21-й движок) — продуктовая аналитика
// ============================================================
// СЫРЬЁ живёт в схеме `analytics` (сырой SQL миграции core_analytics): таблица
// `analytics.events` партиционирована по месяцу (`PARTITION BY RANGE (ts)`), партиции
// создаёт крон, и Prisma их НЕ видит — она сравнивает только схему `public`, поэтому
// migrate не порождает DROP по партициям. `analytics.outbox` — очередь серверных
// событий, записанных в транзакции доменной мутации. Здесь — только `public`:
// склейка личности, рубильник, карантин, роллапы, отчёты и дашборды.
//
// Уникумы роллапов с NULL-измерениями — `UNIQUE NULLS NOT DISTINCT`, дописаны руками
// в миграции (Prisma не выражает): analytics_rollup_event_day_dims_key,
// analytics_rollup_actor_day_dims_key, analytics_rollup_session_day_dims_key.

/// Склейка «аноним → аккаунт»: append-only, ПЕРВАЯ привязка побеждает. Повторная
/// привязка того же anonymous_id к другому аккаунту помечает строку `contested` —
/// склейка по ней больше не применяется (общий компьютер).
model AnalyticsIdentityLink {
  anonymousId String    @id @map("anonymous_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  linkedAt    DateTime  @default(now()) @map("linked_at")
  contested   Boolean   @default(false)
  contestedAt DateTime? @map("contested_at")
  source      String // identify | login

  @@index([userId])
  // Раннер сроков: склейки старше срока (core/lifecycle)
  @@index([linkedAt])
  @@map("analytics_identity_links")
}

/// Рубильник события без деплоя: `blocked` → отбрасывается на приёме.
model AnalyticsEventOverride {
  eventKey String   @id @map("event_key")
  status   String // live | blocked
  reason   String?
  setBy    String?  @map("set_by")
  setAt    DateTime @default(now()) @map("set_at")

  @@map("analytics_event_overrides")
}

/// Карантин приёма: неизвестные ключи и нарушения схемы. Только ИМЕНА и ТИПЫ полей
/// (`sampleShape`), значений нет. TTL 30 дней (крон).
model AnalyticsQuarantine {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventKey    String   @map("event_key")
  reason      String // ANALYTICS_QUARANTINE_REASONS
  count       Int      @default(0)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  sampleShape Json     @default("{}") @map("sample_shape")

  @@unique([eventKey, reason])
  @@index([lastSeenAt])
  @@map("analytics_quarantine")
}

/// Роллап «событие × день» (день — календарный в APP_TIMEZONE). Пересчитывается
/// джобом `analytics.rollup.day` целиком за день (DELETE + INSERT в одной транзакции).
/// `users`/`workspaces` — различные в пределах строки. Живёт вечно.
model AnalyticsRollupEventDay {
  id          BigInt   @id @default(autoincrement())
  day         DateTime @db.Date
  workspaceId String?  @map("workspace_id") @db.Uuid
  service     String
  eventKey    String   @map("event_key")
  platform    String
  planKey     String?  @map("plan_key")
  /// Строки внутренних аккаунтов (сотрудники платформы, тестовые номера) — отдельным измерением
  internal    Boolean  @default(false)
  count       Int
  users       Int
  workspaces  Int

  @@index([day])
  @@index([eventKey, day])
  @@index([workspaceId, day])
  @@map("analytics_rollup_event_day")
}

/// Роллап «субъект × день × сервис»: основа DAU/WAU/MAU, удержания, adoption,
/// lifecycle. `actorKind` 0 — человек, 1 — аноним (без склейки). Ретенция = сырьё.
model AnalyticsRollupActorDay {
  id          BigInt   @id @default(autoincrement())
  day         DateTime @db.Date
  actorId     String   @map("actor_id") @db.Uuid
  actorKind   Int      @default(0) @map("actor_kind") @db.SmallInt
  workspaceId String?  @map("workspace_id") @db.Uuid
  service     String
  platform    String
  planKey     String?  @map("plan_key")
  /// Внутренний аккаунт (свойство субъекта, не измерение уникума)
  internal    Boolean  @default(false)
  events      Int
  qualifying  Boolean

  @@index([day])
  @@index([actorId, day])
  @@index([workspaceId, day])
  @@map("analytics_rollup_actor_day")
}

/// Роллап сессий по дню: число, медиана длительности, событий на сессию.
model AnalyticsRollupSessionDay {
  id               BigInt   @id @default(autoincrement())
  day              DateTime @db.Date
  workspaceId      String?  @map("workspace_id") @db.Uuid
  platform         String
  internal         Boolean  @default(false)
  sessions         Int
  durationP50S     Int      @map("duration_p50_s")
  eventsPerSession Float    @map("events_per_session") @db.Real

  @@index([day])
  @@index([workspaceId, day])
  @@map("analytics_rollup_session_day")
}

/// Сохранённый отчёт Кабинета: запрос на языке DSL (`analyticsQuerySchema`).
/// Общий по умолчанию; правит автор или `analytics.manage`; `systemKey` — засев из кода
/// (`analytics.system-dashboards.ts`), такие не редактируются.
model AnalyticsReport {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title      String?
  systemKey  String?  @unique @map("system_key")
  query      Json
  viz        String?
  visibility String   @default("shared") // shared | private
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([visibility, updatedAt])
  @@index([createdBy])
  @@map("analytics_reports")
}

/// Дашборд: УПОРЯДОЧЕННЫЙ список плиток `{ reportId, span: 4|6|12, viz? }` — порядок и
/// ширина, без координат.
model AnalyticsDashboard {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title      String?
  systemKey  String?  @unique @map("system_key")
  tiles      Json     @default("[]")
  visibility String   @default("shared") // shared | private
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([visibility, updatedAt])
  @@map("analytics_dashboards")
}

// ============================================================
// core/keys (22-й платформенный движок) — keystore и журнал ключей
// ============================================================
// Корневой ключ живёт ВНЕ БД (файл с правами / HSM); здесь — только обёрнутые
// им ключи (KEK на организацию и человека, пары подписи на аудиторию, HMAC-ключи).
// Материал версии — `wrapped_material` (AES-256-GCM под корнем, AAD = kid|purpose);
// открытый ключ Ed25519 лежит открыто (его публикует JWKS). Имена не переиспользуются,
// версии только растут; `destroyed` = материала нет, данные под ним нечитаемы
// (crypto-shredding организации/человека). См. docs/keys_engine.md.

model CryptoKey {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// platform | workspace:<id> | user:<id>
  scope            String
  /// kek | sign | mac — один ключ обслуживает ровно одно назначение
  purpose          String
  /// kek: default; sign: аудитория (product, platform, wopi, …); mac: имя (blind_index, verify_otp, …)
  name             String
  algorithm        String
  provider         String
  primaryVersionId String?  @map("primary_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  versions CryptoKeyVersion[]

  @@unique([scope, purpose, name])
  @@map("crypto_keys")
}

model CryptoKeyVersion {
  /// id версии = `kid` в артефактах (JWT header, шифротекст, слепой индекс)
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  keyId              String    @map("key_id") @db.Uuid
  version            Int
  /// pending | active | disabled | destroy_scheduled | destroyed
  state              String
  /// Материал, обёрнутый корнем; NULL после уничтожения
  wrappedMaterial    Bytes?    @map("wrapped_material")
  /// Открытый ключ (SPKI DER) у пар подписи; NULL у симметричных
  publicKey          Bytes?    @map("public_key")
  /// Отпечаток корня, которым обёрнут материал (ротация корня перешивает всё)
  rootKid            String    @map("root_kid")
  /// Слот слепого индекса (0 → `_bi`, 1 → `_bi_alt`) — только у версий mac-ключа `blind_index`
  slot               Int?
  /// Состояние ДО заморозки скоупа: разморозка возвращает ровно его; NULL — версию выключали поштучно
  frozenFrom         String?   @map("frozen_from")
  createdAt          DateTime  @default(now()) @map("created_at")
  activatedAt        DateTime? @map("activated_at")
  deactivatedAt      DateTime? @map("deactivated_at")
  destroyScheduledAt DateTime? @map("destroy_scheduled_at")
  destroyedAt        DateTime? @map("destroyed_at")
  /// Версия признана скомпрометированной: архивная проверка подписи (`verifyArchival`) отвергает её
  /// НАВСЕГДА, в каком бы состоянии она ни была. Отдельная колонка, а не `state = disabled`:
  /// `disabled` уходит в `destroy_scheduled` → `destroyed`, и без метки компрометация «отмывалась» бы.
  compromisedAt      DateTime? @map("compromised_at")

  key CryptoKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, version])
  @@index([keyId, state])
  @@index([state, destroyScheduledAt])
  @@index([rootKid])
  @@map("crypto_key_versions")
}

// ============================================================
// core/keys — боты, ключи API, журнал обращений, политика организации
// ============================================================

/// Бот — собственность организации (решение грилла №7): отвечают владелец и админы
/// (роль, не человек); именной ответственный — по желанию. `userId` — теневая строка
/// users (kind='bot') с ролью user_roles(workspace, rank): так бот — полноправный актор
/// в задачах, хронике и правах без переписывания FK. Уход создателя → `frozen`
/// (creator_left) до решения владельца; ничего не удаляется.
model Bot {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  name              String
  glyph             String?
  /// active | frozen | archived
  status            String    @default("active")
  /// creator_left | owner | platform
  frozenReason      String?   @map("frozen_reason")
  frozenAt          DateTime? @map("frozen_at")
  /// member | manager — проецируется ролью staff | manager в user_roles
  rank              String    @default("member")
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// «Для чего» — обязательное поле реестра
  purpose           String
  /// { tasks: 'write', documents: 'read', … } — сервисы из KEY_SCOPE_SERVICES
  scopes            Json      @default("{}")
  /// CIDR-список; пустой = без ограничения (кроме ключей без срока — им список обязателен)
  ipAllowlist       Json      @default("[]") @map("ip_allowlist")
  /// core/visibility R9: «Доступ к контактным данным» (класс `contact`); копируется в ключи бота
  contactAccess     Boolean   @default(false) @map("contact_access")
  createdById       String    @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  archivedAt        DateTime? @map("archived_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keys      ApiKey[]

  @@index([workspaceId, status])
  @@index([createdById])
  @@index([responsibleUserId])
  @@map("bots")
}

/// Ключ API: `sa6_<bot|pat>_<live|test>_<base62>_<crc>`, в БД — HMAC-SHA256 (pepper из
/// keystore, `hashKid`) + префикс и last4 для маски; show-once. Семейство `familyId` —
/// ротация с перекрытием (≤ 2 живых, grace старого до 7 дней). Срок обязателен, кроме
/// ключа бота, выпущенного владельцем с IP-списком. Статус вычисляется из строки.
model ApiKey {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// bot | pat
  kind            String
  botId           String?   @map("bot_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  /// null у личного ключа для собственных данных человека
  workspaceId     String?   @map("workspace_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  name            String
  purpose         String
  prefix          String
  last4           String
  hash            String    @unique
  hashKid         String    @map("hash_kid")
  scopes          Json      @default("{}")
  ipAllowlist     Json      @default("[]") @map("ip_allowlist")
  /// core/visibility R9: «Доступ к контактным данным»; у ключа бота — копия флага бота
  contactAccess   Boolean   @default(false) @map("contact_access")
  expiresAt       DateTime? @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedIp      String?   @map("last_used_ip")
  lastUsedCountry String?   @map("last_used_country")
  useCount        Int       @default(0) @map("use_count")
  revokedAt       DateTime? @map("revoked_at")
  revokedReason   String?   @map("revoked_reason")
  revokedNote     String?   @map("revoked_note")
  rotatedFromId   String?   @map("rotated_from_id") @db.Uuid
  graceUntil      DateTime? @map("grace_until")
  storedHint      String?   @map("stored_hint")
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  bot Bot? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([botId])
  @@index([userId, workspaceId])
  @@index([workspaceId, revokedAt])
  @@index([expiresAt])
  // Раннер сроков: отозванные ключи старше срока (core/lifecycle)
  @@index([revokedAt])
  @@map("api_keys")
}

/// Журнал обращений ключами — append-only, пишется батчем из Redis. Таблица
/// ПАРТИЦИОНИРОВАНА по месяцам `at` (миграция `keys_journal_partitions`, руками:
/// Prisma не выражает PARTITION BY) — отсюда составной PK `(id, at)`; партиции заводит
/// и сбрасывает по сроку функция владельца через `LifecyclePartitions` (core/lifecycle).
model ApiAccessLog {
  id     BigInt   @default(autoincrement())
  keyId  String   @map("key_id") @db.Uuid
  at     DateTime @default(now())
  method String
  route  String
  status Int
  ip     String?

  @@id([id, at])
  @@index([keyId, at])
  @@index([at], type: Brin)
  @@map("api_access_log")
}

/// Политика ключей организации — только потолки (кто создаёт — зашито: owner/admin).
// ---- core/webhooks: исходящие вебхуки организации ----
// Секреты — envelope `sa6e:` под KEK организации (реестр колонок движка ключей → rewrap).
model WebhookEndpoint {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  url            String
  /// Ключи событий реестра shared (`tasks.task.created`, …)
  events         Json      @default("[]")
  /// hmac | ed25519
  signing        String    @default("hmac")
  secretEnc      String    @map("secret_enc")
  prevSecretEnc  String?   @map("prev_secret_enc")
  prevExpiresAt  DateTime? @map("prev_expires_at")
  /// Ed25519: приватный ключ (pkcs8, envelope) и публичный (raw 32 байта, base64)
  privateKeyEnc  String?   @map("private_key_enc")
  publicKey      String?   @map("public_key")
  /// pending_verification | active | disabled
  status         String    @default("pending_verification")
  /// Подряд провалов доставки (обнуляется успехом); порог — WEBHOOK_LIMITS.failuresToDisable
  failures       Int       @default(0)
  /// Начало текущей серии провалов (null — серии нет): автоотключение = порог штук И возраст серии
  failingSince   DateTime? @map("failing_since")
  /// Последний провал либо взятая пробная доставка — таймер предохранителя мёртвого адреса
  lastFailureAt  DateTime? @map("last_failure_at")
  disabledAt     DateTime? @map("disabled_at")
  /// failures | manual | platform | verification | signature_audit
  disabledReason String?   @map("disabled_reason")
  lastDeliveryAt DateTime? @map("last_delivery_at")
  lastProbeAt    DateTime? @map("last_probe_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, status])
  @@index([status, lastProbeAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String    @default(dbgenerated("uuidv7()")) @db.Uuid
  endpointId  String    @map("endpoint_id") @db.Uuid
  eventKey    String    @map("event_key")
  /// Тело события целиком (id, type, version, occurredAt, data) — подписывается как есть
  payload     Json
  /// pending | failed (ждёт ретрая) | delivered | exhausted
  status      String    @default("pending")
  attempts    Int       @default(0)
  nextAt      DateTime? @map("next_at")
  lastStatus  Int?      @map("last_status")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  // RANGE-партиции по месяцу created_at, срок 30 дней — сброс партиции; поиск по id — с подсказкой
  // времени из UUIDv7 (lookupByIdWithTimeHint), иначе планировщик открывает все партиции
  @@id([id, createdAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([status, nextAt])
  @@index([createdAt], type: Brin)
  @@map("webhook_deliveries")
}

model WorkspaceKeyPolicy {
  workspaceId        String   @id @map("workspace_id") @db.Uuid
  maxPatDays         Int      @default(90) @map("max_pat_days")
  /// null — «бессрочно» разрешено владельцу с IP-списком
  maxBotKeyDays      Int?     @default(365) @map("max_bot_key_days")
  requireIpAllowlist Boolean  @default(false) @map("require_ip_allowlist")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_key_policies")
}

// ============================================================
// core/consents — движок согласий (24-й) + учёт действий с ПДн + журнал инцидентов
// ============================================================

/// Версия документа платформы = комплект kk + ru + en. Юридический текст — КОНТЕНТ В БД,
/// не каталог i18n: версия неизменяема и подписана платформой (аудитория `consents`).
/// Неизменяемость держит ТРИГГЕР `consent_versions_guard` (миграция `core_consents`):
/// у не-черновика меняются только статус, подпись (перезаверение), заверение ЭЦП и отметка
/// активации; DELETE разрешён только черновику. Сервис дополнительно правит строго
/// `updateMany where status = draft`.
/// Частичный уникум (руками в миграции): один черновик на документ —
/// `consent_versions_one_draft` (document_key) WHERE status = draft.
model ConsentVersion {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Ключ реестра `CONSENT_KINDS` (shared)
  documentKey              String    @map("document_key")
  version                  Int
  /// draft | published | superseded | withdrawn (отозвана до вступления в силу новой публикацией)
  status                   String    @default("draft")
  /// Полный текст {kk, ru, en} (markdown; реквизиты оператора подставлены при публикации)
  bodies                   Json
  /// «Коротко о главном» {kk, ru, en}
  summaries                Json
  /// «Что изменилось» {kk, ru, en}; у первой версии — NULL
  changeSummary            Json?     @map("change_summary")
  /// sha256 показанного текста по языкам {kk, ru, en} — с ним сверяется `ConsentAcceptance.contentHash`
  hashes                   Json?
  /// sha256 манифеста версии (ключ, номер, хэши, дата вступления, существенность, prev) — его подписывает платформа
  manifestHash             String?   @map("manifest_hash")
  /// Цепочка версий: manifestHash предыдущей опубликованной версии того же документа
  prevManifestHash         String?   @map("prev_manifest_hash")
  /// Существенная версия поднимает шлюз после даты вступления; несущественная — нет
  material                 Boolean   @default(true)
  effectiveFrom            DateTime? @map("effective_from")
  /// Срочная публикация «сегодня»: причина (обязательна)
  urgentReason             String?   @map("urgent_reason")
  /// Ed25519-подпись manifestHash (base64url) и версия ключа (`kid`) аудитории `consents`
  signature                String?
  signatureKid             String?   @map("signature_kid")
  signedAt                 DateTime? @map("signed_at")
  /// Прошлые подписи после перезаверения (компрометация ключа): [{kid, signature, signedAt, replacedAt}]
  signatureHistory         Json      @default("[]") @map("signature_history")
  /// Необязательное заверение ЭЦП руководителя оператора (заявка core/sign)
  attestationSignRequestId String?   @map("attestation_sign_request_id") @db.Uuid
  /// PDF-отпечаток версии, отданный на заверение (движок подписи замораживает СВОЮ копию)
  attestationFileId        String?   @map("attestation_file_id") @db.Uuid
  /// Момент, когда джоб активации поднял шлюз (идемпотентность джоба)
  activatedAt              DateTime? @map("activated_at")
  publishedAt              DateTime? @map("published_at")
  publishedById            String?   @map("published_by_id") @db.Uuid
  createdById              String?   @map("created_by_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  acceptances ConsentAcceptance[]

  @@unique([documentKey, version])
  @@index([documentKey, status, effectiveFrom])
  @@index([signatureKid])
  @@map("consent_versions")
}

/// Запись приёмки — доказательство согласия (ЗоПД ст. 8 п. 1, ст. 25 п. 2 пп. 5).
/// Пишется `ConsentsService.accept(tx, …)` ТОЛЬКО в транзакции вызывающего.
/// Триггер `consent_acceptances_guard`: DELETE запрещён; UPDATE — только однократный отзыв
/// (`revoked_at`/`revoked_reason` из NULL). Строка переживает удаление аккаунта: это
/// доказательство, а не ПДн профиля (ЦК ст. 41 п. 4 пп. 1) — поэтому FK на users нет.
/// Частичный уникум (руками в миграции): одна ЖИВАЯ приёмка на (субъект, версия) —
/// `consent_acceptances_live_uq` (subject_type, subject_id, version_id) WHERE revoked_at IS NULL;
/// иначе «маркетинг вкл → выкл → вкл» упирался бы в уникальность.
model ConsentAcceptance {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// user | workspace
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id")
  documentKey       String    @map("document_key")
  versionId         String    @map("version_id") @db.Uuid
  /// Язык, на котором человеку ПОКАЗАЛИ текст
  locale            String
  /// sha256 показанного текста (= hashes[locale] версии на момент приёмки)
  contentHash       String    @map("content_hash")
  /// Кто нажал «принимаю»
  actorUserId       String    @map("actor_user_id") @db.Uuid
  /// self | guardian | org_owner
  actorRole         String    @default("self") @map("actor_role")
  /// Основание полномочий принявшего (роль в организации, документ представителя)
  actorBasis        String?   @map("actor_basis")
  acceptedAt        DateTime  @default(now()) @map("accepted_at")
  /// web | mobile | api | terminal
  channel           String    @default("web")
  /// IP и User-Agent — envelope ПЛАТФОРМЕННЫМ ключом core/keys (не KEK человека:
  /// крипто-шреддинг аккаунта не должен уничтожать доказательство согласия)
  ipEnc             String?   @map("ip_enc")
  userAgentEnc      String?   @map("user_agent_enc")
  /// SMS-цепочка, до отправки которой человек принял документы (регистрация)
  verifyChallengeId String?   @map("verify_challenge_id") @db.Uuid
  bundleKey         String?   @map("bundle_key")
  revokedAt         DateTime? @map("revoked_at")
  /// user_revoked | declined | account_deleted | superseded | integration_disconnected | workspace_purged
  revokedReason     String?   @map("revoked_reason")

  version ConsentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, documentKey, acceptedAt])
  @@index([versionId, revokedAt])
  @@index([actorUserId])
  @@map("consent_acceptances")
}

/// Инцидент безопасности ПДн (ЗоПД ст. 25 п. 2 пп. 8; Правила № 179/НҚ п. 11): уведомить
/// уполномоченный орган за 1 рабочий день с момента обнаружения, затем субъектов.
/// Переходы статуса — status-guarded `updateMany`; история — `PdIncidentEvent` (append-only).
model PdIncident {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// unauthorized_access | leak | loss | alteration | availability | other
  kind                String
  /// open | authority_notified | subjects_notified | closed
  status              String    @default("open")
  scope               String
  summary             String
  affectedEstimate    Int?      @map("affected_estimate")
  detectedAt          DateTime  @map("detected_at")
  /// detectedAt + 1 рабочий день
  notifyDeadlineAt    DateTime  @map("notify_deadline_at")
  authorityNotifiedAt DateTime? @map("authority_notified_at")
  subjectsNotifiedAt  DateTime? @map("subjects_notified_at")
  closedAt            DateTime? @map("closed_at")
  /// Тревога «до дедлайна 4 часа» уже отправлена (идемпотентность джоба)
  deadlineAlertedAt   DateTime? @map("deadline_alerted_at")
  /// Сотрудник платформы, открывший инцидент
  actorUserId         String    @map("actor_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  events PdIncidentEvent[]

  @@index([status, notifyDeadlineAt])
  @@map("pd_incidents")
}

/// События инцидента — append-only (триггеры immutable + no_truncate в миграции `core_consents`).
model PdIncidentEvent {
  id          BigInt   @id @default(autoincrement())
  incidentId  String   @map("incident_id") @db.Uuid
  /// opened | authority_notified | subjects_notified | note | closed | deadline_alert
  type        String
  note        String?
  actorUserId String?  @map("actor_user_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at")

  incident PdIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([incidentId, occurredAt])
  @@map("pd_incident_events")
}

// ============================================================
// core/idempotency (25-й движок) — «входящий ящик» ровно-одного-раза
// ============================================================
// HTTP-ключ повтора живёт в СВОЕЙ схеме `idem` (партиции, сырой SQL миграции —
// Prisma их не выражает и не видит). Здесь — единственная модель движка: отметка
// «событие источника уже обработано», которую ставит `IdempotencyInboxService.once`
// В ТРАНЗАКЦИИ вызывающего. Потребители: входящие вебхуки (ТОЛЬКО после проверки
// подписи — иначе ящик травится поддельным id) и пакеты планировщика (`eventId`
// = ключ периода). Ретенция — 30 дней (> окна редоставки у всех источников).

/// Отметка «это событие источника уже обработано» (docs/idempotency_engine.md).
model IdempotencyInbox {
  id         BigInt    @id @default(autoincrement())
  /// Источник: livekit | telegram | scheduler | …
  source     String
  /// Аккаунт/канал внутри источника (id бота, id комнаты, ключ расписания)
  account    String
  /// Идентификатор события у источника (event.id, update_id, periodKey)
  eventId    String    @map("event_id")
  /// Начало обработки; у строки «в работе» — она же отсчёт аренды (`begin`)
  receivedAt DateTime  @default(now()) @map("received_at")
  /// Обработка завершена. NULL — «в работе» под арендой: истекла ⇒ редоставка забирает событие
  doneAt     DateTime? @default(now()) @map("done_at")

  @@unique([source, account, eventId])
  @@index([receivedAt])
  @@map("idempotency_inbox")
}

// ============================================================
// core/audit (26-й движок) — журнал аудита безопасности
// ============================================================
// ЕДИНЫЙ поток событий безопасности «кто / когда / откуда / что / с чем / исход» с тремя
// зрителями (человек, организация, платформа). Сюда переехали журналы ключей, Кабинета
// (команды и чтения), чтений ПДн и учёта действий с ПДн. docs/audit_engine.md.

/// Событие безопасности. МЕСЯЧНЫЕ ПАРТИЦИИ `PARTITION BY RANGE (occurred_at)` — руками в
/// миграции `core_audit` (Prisma не выражает PARTITION BY; зеркало — составной PK). Партиции
/// на три месяца вперёд создаёт `AuditPartitions` (бут + крон) через SECURITY DEFINER-функцию
/// `audit_ensure_partition` — партиции принадлежат владельцу таблицы, а не роли приложения.
/// Append-only НА УРОВНЕ БАЗЫ: триггер `security_events_guard` (ENABLE ALWAYS — не глушится
/// `session_replication_role = replica`) роняет DELETE и любой UPDATE, кроме перешивки
/// шифротекста `ip_enc`/`ua_raw_enc` после ротации платформенного KEK; TRUNCATE —
/// `security_events_no_truncate`. `xact` (xid8, `pg_current_xact_id()`) — курсор дайджестов
/// и выгрузки (видимость по снимку), в клиенте Prisma не читается (сырой SQL).
/// Индексы: B-tree ниже; ЧАСТИЧНЫЕ `WHERE col IS NOT NULL` (руками в миграции `core_audit_review`)
/// у разреженных `op`, `ip_hmac`, `request_id`, цели; `details` — сжатие lz4 (руками). Новая колонка —
/// только с NULL по умолчанию: лист Меркла v2 (`jsonb_strip_nulls`) пустую колонку не видит, а
/// непустое умолчание изменило бы лист каждой прошлой строки (проверка дайджестов и сброс архивов).
model SecurityEvent {
  id                 BigInt               @default(autoincrement())
  /// Дедупликация во внешних системах (экспорт, стрим)
  eventId            String               @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  /// `clock_timestamp()` — момент записи строки (UTC)
  occurredAt         DateTime             @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("occurred_at")
  /// `now()` — начало транзакции: склейка событий одного факта
  txAt               DateTime             @default(dbgenerated("(now() AT TIME ZONE 'UTC'::text)")) @map("tx_at")
  xact               Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))
  eventKey           String               @map("event_key")
  /// Операция: ключ команды Кабинета / действие движка ключей
  op                 String?
  /// Коды словарей shared (`AUDIT_*_CODE`)
  category           Int                  @db.SmallInt
  severity           Int                  @db.SmallInt
  outcome            Int                  @db.SmallInt
  reasonCode         String?              @map("reason_code")
  // ---- Актор (род — из аутентификации, не из тела запроса) ----
  actorKind          Int                  @map("actor_kind") @db.SmallInt
  actorId            String?              @map("actor_id") @db.Uuid
  actorSessionId     String?              @map("actor_session_id") @db.Uuid
  actorFamilyId      String?              @map("actor_family_id") @db.Uuid
  actorKeyId         String?              @map("actor_key_id") @db.Uuid
  onBehalfOfId       String?              @map("on_behalf_of_id") @db.Uuid
  /// Роли актора снимком (сотрудник платформы)
  actorRoles         Json?                @map("actor_roles")
  // ---- Субъект и цель ----
  /// Чья лента (человек). FK нет: журнал переживает удаление и анонимизацию
  subjectUserId      String?              @map("subject_user_id") @db.Uuid
  workspaceId        String?              @map("workspace_id") @db.Uuid
  targetType         String?              @map("target_type")
  targetId           String?              @map("target_id")
  /// Снимок подписи НЕ-человека (имя ключа, адрес вебхука без query)
  targetLabel        String?              @map("target_label")
  related            Json?
  // ---- Видимость (вычисляет реестр при записи) ----
  visSubject         Boolean              @map("vis_subject")
  visWorkspace       Boolean              @map("vis_workspace")
  visPlatform        Boolean              @default(true) @map("vis_platform")
  // ---- Контекст запроса ----
  /// Envelope `sa6e:` ПЛАТФОРМЕННЫМ KEK (реестр колонок → перешивка `keys.rewrap`)
  ipEnc              String?              @map("ip_enc")
  /// Псевдоним `sa6m:` ключом `audit` — поиск «все события с этого IP» без IP
  ipHmac             String?              @map("ip_hmac")
  ipNet              String?              @map("ip_net")
  country            String?              @db.Char(2)
  city               String?
  asn                Int?
  isAnonymizer       Boolean?             @map("is_anonymizer")
  /// «платформа · браузер · класс» — сырой UA только шифротекстом
  uaFamily           String?              @map("ua_family")
  uaRawEnc           String?              @map("ua_raw_enc")
  deviceId           String?              @map("device_id") @db.Uuid
  client             Int?                 @db.SmallInt
  requestId          String?              @map("request_id") @db.Uuid
  /// Шаблон маршрута, без query
  route              String?
  idempotencyKeyHash String?              @map("idempotency_key_hash")
  // ---- Содержимое ----
  /// Allow-list реестра (Zod `.strict()`)
  details            Json                 @default("{}")
  /// Доказательства (NIST AU-10): фактор, момент step-up, цепочка кода
  evidence           Json?
  refType            String?              @map("ref_type")
  refId              String?              @map("ref_id")

  @@id([id, occurredAt])
  @@unique([eventId, occurredAt])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([subjectUserId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([eventKey, occurredAt(sort: Desc)])
  // Частичные (WHERE col IS NOT NULL) — руками в миграции core_audit_review, Prisma их не видит:
  // (op, occurred_at DESC) · (ip_hmac, occurred_at DESC) · (request_id) · (target_type, target_id, occurred_at DESC)
  @@map("security_events")
}

/// Подписанный дайджест журнала (AWS CloudTrail digest-модель): каждые 5 минут — корень
/// Меркла по строкам с `xact` в [from, to) (по снимку: транзакции, видимые всем), цепочка
/// `prev_digest_hash`, подпись Ed25519 аудитории `audit` + копия вне БД. Лист = sha256
/// канонического JSON строки БЕЗ `ip_enc`/`ua_raw_enc` (их перешивают ротации).
/// Append-only (триггер): меняются только отметки выгрузки и проверки.
model SecurityDigest {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Границы по `xact` (xid8 как bigint): [xactFrom, xactTo)
  xactFrom       BigInt    @map("xact_from")
  xactTo         BigInt    @map("xact_to")
  firstAt        DateTime? @map("first_at")
  lastAt         DateTime? @map("last_at")
  count          Int
  merkleRoot     Bytes     @map("merkle_root")
  prevDigestHash Bytes?    @map("prev_digest_hash")
  signature      Bytes
  kid            String
  signedAt       DateTime  @default(now()) @map("signed_at")
  exportedAt     DateTime? @map("exported_at")
  verifiedAt     DateTime? @map("verified_at")
  verifyOk       Boolean?  @map("verify_ok")
  /// Версия формулы листа (1 — `to_jsonb`, 2 — `jsonb_strip_nulls`); подписана в строке дайджеста.
  /// Умолчание — 1 (писатель, не знающий версий, считает по v1); код пишет версию ЯВНО
  leafVersion    Int       @default(1) @map("leaf_version") @db.SmallInt

  @@unique([xactFrom])
  @@unique([xactTo])
  @@index([signedAt])
  @@map("security_digests")
}

/// Архив месячной партиции журнала: NDJSON+gzip в объектном хранилище с подписанным
/// манифестом (sha256 файла, строки, диапазон). Партиция сбрасывается ТОЛЬКО после успешной
/// выгрузки (`archivedAt` не null) — функция `audit_drop_partition` проверяет это в БД.
model SecurityPartitionArchive {
  partition   String    @id
  fromAt      DateTime  @map("from_at")
  toAt        DateTime  @map("to_at")
  rows        Int
  bytes       BigInt
  sha256      String
  objectKey   String    @map("object_key")
  manifestKey String    @map("manifest_key")
  signature   Bytes
  kid         String
  archivedAt  DateTime  @default(now()) @map("archived_at")
  droppedAt   DateTime? @map("dropped_at")
  /// Версия формулы листа корня манифеста (формат `sa6-audit-archive:v<версия>`)
  leafVersion Int       @default(1) @map("leaf_version") @db.SmallInt

  @@map("security_partition_archives")
}

/// Квитанция команды Кабинета (идемпотентность S5): уникум на партиционированном журнале
/// невозможен без ключа партиции — поэтому отдельная таблица. Реплей читает событие
/// `platform.command.executed` по `eventId` и отдаёт его `details.after`.
model PlatformCommandReceipt {
  actorId        String   @map("actor_id") @db.Uuid
  commandKey     String   @map("command_key")
  idempotencyKey String   @map("idempotency_key")
  inputHash      String?  @map("input_hash")
  eventId        String   @map("event_id") @db.Uuid
  eventAt        DateTime @map("event_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([actorId, commandKey, idempotencyKey])
  @@map("platform_command_receipts")
}

/// Устройство человека (core/audit): клиентский id из `X-Device-Id` — стабилен между
/// входами, НЕ зависит от отказа от аналитики. Новое устройство → событие + уведомление;
/// доверенным становится после подтверждения cooling (или через 24 ч). Крон: без
/// активности 365 дн → забыто (+ событие); забытые старше года — удаляются (журнал — события).
model UserDevice {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  /// «Chrome · Windows» из User-Agent (автоподпись)
  label       String
  /// Имя, которое дал человек (перебивает автоподпись)
  customLabel String?   @map("custom_label")
  platform    String?
  browser     String?
  /// desktop | mobile | tablet | other
  deviceClass String    @default("other") @map("device_class")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  lastCountry String?   @map("last_country") @db.Char(2)
  trustedAt   DateTime? @map("trusted_at")
  forgottenAt DateTime? @map("forgotten_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([lastSeenAt])
  // Частичный (forgotten_at) WHERE forgotten_at IS NOT NULL — руками в миграции core_audit_review
  // (ночная чистка забытых); Prisma частичные индексы не видит
  @@map("user_devices")
}

/// Тревога детекции (рабочая очередь безопасности платформы, не журнал): одна открытая на
/// (вид, ключ дедупликации) — партиальный уникум `security_alerts_open_uq` руками в миграции.
/// Закрытые старше года удаляются кроном (журнал — события `detect.*`).
model SecurityAlert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Ключ детекции без префикса (`password_spray`)
  kind          String
  severity      String
  /// Субъект / сеть / организация — то, по чему тревога одна
  dedupeKey     String    @map("dedupe_key")
  subjectUserId String?   @map("subject_user_id") @db.Uuid
  workspaceId   String?   @map("workspace_id") @db.Uuid
  ipHmac        String?   @map("ip_hmac")
  /// open | ack | closed
  status        String    @default("open")
  /// id событий-улик (bigint строками), последние 50
  evidence      Json      @default("[]")
  hits          Int       @default(1)
  assigneeId    String?   @map("assignee_id") @db.Uuid
  resolution    String?
  openedAt      DateTime  @default(now()) @map("opened_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  closedAt      DateTime? @map("closed_at")

  @@index([status, openedAt])
  @@index([subjectUserId])
  // Раннер сроков: закрытые тревоги (фильтр status = closed, порядок updated_at; core/lifecycle)
  @@index([status, updatedAt])
  @@map("security_alerts")
}

// ============================================================
// core/visibility — правила видимости полей (27-й движок)
// ============================================================

/// Политика видимости владельца по типу записи. Party-паттерн: владелец — организация ИЛИ
/// человек (`owner_type`), внешнего ключа нет → каскады пишет движок сам:
/// `WorkspacesService.purgeWorkspace` и `UsersService` (анонимизация аккаунта) зовут
/// `VisibilityPolicyService.purgeOwner`. Опубликованная версия неизменяема (правится только
/// статус `archived`); черновик — одна строка на (владелец, тип), `draft_token` меняется на
/// каждой правке (публикация сверяет его с диффом, который видел человек).
/// Частичные уникумы (руками в миграции `core_visibility`):
///   `visibility_policies_one_published` (owner_type, owner_id, record_type) WHERE status = 'published';
///   `visibility_policies_one_draft`     (owner_type, owner_id, record_type) WHERE status = 'draft'.
model VisibilityPolicy {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType     String    @map("owner_type")
  ownerId       String    @map("owner_id") @db.Uuid
  recordType    String    @map("record_type")
  version       Int
  /// draft | published | archived
  status        String    @default("draft")
  presetKey     String?   @map("preset_key")
  draftToken    String?   @map("draft_token")
  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by_id") @db.Uuid
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rules VisibilityRule[]

  @@unique([ownerType, ownerId, recordType, version])
  @@index([ownerType, ownerId, status])
  @@map("visibility_policies")
}

/// Правило = строка (не JSON-документ): индекс, дифф, «почему», транзакционная правка (модель
/// Twenty `fieldPermission` / Salesforce FieldPermissions). Цель — ровно одно из трёх: поле,
/// группа полей, секция (CHECK в миграции). Адресат — две колонки (`audience_kind`,
/// `audience_id`), а не jsonb: уборка исключений при разрыве связи и правил удалённой Группы
/// идёт по индексу. Ключ поля — ключ реестра; поле ушло из реестра → рантайм игнорирует
/// правило-сироту, страж `check:visibility` требует миграцию-уборку. Словарь `audience_kind` —
/// CHECK в миграции = `VISIBILITY_AUDIENCE_KINDS` целиком (новый вид адресата в реестре без
/// миграции-расширения CHECK валит `check:visibility`).
model VisibilityRule {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  policyId     String   @map("policy_id") @db.Uuid
  fieldKey     String?  @map("field_key")
  groupKey     String?  @map("group_key")
  sectionKey   String?  @map("section_key")
  audienceKind String   @map("audience_kind")
  audienceId   String?  @map("audience_id")
  /// allow | deny
  effect       String
  /// hidden | masked | full
  level        String
  mask         String?
  /// none | one | delegated
  reveal       String   @default("none")
  stage        String?
  /// { inSearch?: bool, inPickers?: bool }
  surfaces     Json?
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  policy VisibilityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([audienceKind, audienceId])
  @@map("visibility_rules")
}

/// Настройки политики организации (R18): push о раскрытии, «четыре глаза» на ослабление
/// строгих полей, делегирование раскрытия. 1:1 к организации (образец `WorkspaceKeyPolicy`),
/// правит только владелец. Нет строки — умолчания (всё выключено).
model WorkspaceVisibilitySettings {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  notifyOnReveal  Boolean  @default(false) @map("notify_on_reveal")
  dualControl     Boolean  @default(false) @map("dual_control")
  allowDelegation Boolean  @default(false) @map("allow_delegation")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_visibility_settings")
}

// ============================================================
// core/lifecycle — жизненный цикл данных (28-й движок): настройки сроков организаций, заморозки
// (legal hold), стирание субъекта и его журнал, экспорт, учёт удалений без FK (loose FK), прогоны
// принуждения, партиции под функциями владельца, отчёты резервного копирования.
// Реестр политик — packages/shared/src/lifecycle; docs/lifecycle_engine.md.
// ============================================================

/// Срок хранения класса данных, выбранный организацией в коридоре [пол закона; потолок тарифа].
/// Сокращение вступает через 30 дней (pending*), удлинение — сразу. `days = null` — вечно.
model LifecycleSetting {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  dataClass          String    @map("data_class")
  days               Int?
  /// Отложенное сокращение: новое значение и момент вступления (pendingSet — отличает «вечно» от «нет изменения»)
  pendingSet         Boolean   @default(false) @map("pending_set")
  pendingDays        Int?      @map("pending_days")
  pendingEffectiveAt DateTime? @map("pending_effective_at") @db.Timestamptz(3)
  policyVersion      Int       @default(1) @map("policy_version")
  changedById        String?   @map("changed_by_id") @db.Uuid
  changedAt          DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dataClass])
  @@map("lifecycle_settings")
}

/// Заморозка (legal hold): останавливает КАЖДЫЙ путь удаления по области. Публичный id — v4
/// (момент создания не раскрывается). Переживает организацию (без FK) — это след процесса.
/// Строка не удаляется и не меняется, кроме снятия (released_*) — триггер ENABLE ALWAYS.
model LifecycleHold {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// custodian (человек) | space (чат, диск, пространство заметок) | record (одна запись) | class (класс данных)
  scope           String
  /// null — заморозка платформы
  workspaceId     String?   @map("workspace_id") @db.Uuid
  custodianUserId String?   @map("custodian_user_id") @db.Uuid
  spaceType       String?   @map("space_type")
  spaceId         String?   @map("space_id")
  /// id политики реестра (модель) и запись
  recordType      String?   @map("record_type")
  recordId        String?   @map("record_id")
  dataClass       String?   @map("data_class")
  reasonCode      String    @map("reason_code")
  /// Обоснование администратора (≤ 500) — видят админы организации и платформа
  note            String?
  createdById     String    @map("created_by_id") @db.Uuid
  createdByKind   String    @default("user") @map("created_by_kind")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById    String?   @map("released_by_id") @db.Uuid
  releaseNote     String?   @map("release_note")

  @@index([workspaceId, releasedAt])
  @@index([custodianUserId, releasedAt])
  @@index([recordType, recordId])
  @@index([spaceType, spaceId])
  // Частичный индекс живых заморозок `(scope, data_class) WHERE released_at IS NULL` (миграция
  // lifecycle_live_holds_idx, руками): условие «строка не под заморозкой» — коррелированный
  // подзапрос на КАЖДУЮ строку-кандидат пачки; без него он читал бы всю историю заморозок
  @@map("lifecycle_holds")
}

/// Строки, извлечённые из партиции перед её сбросом, потому что их держит заморозка.
/// Содержимое — конверт под KEK владельца (keys envelope), не открытый текст.
model LifecycleHoldStore {
  id          BigInt   @id @default(autoincrement())
  holdId      String   @map("hold_id") @db.Uuid
  policyId    String   @map("policy_id")
  sourceTable String   @map("source_table")
  sourcePk    String   @map("source_pk")
  partition   String?
  rowEnc      Bytes    @map("row_enc")
  keyScope    String   @map("key_scope")
  extractedAt DateTime @default(now()) @map("extracted_at") @db.Timestamptz(3)

  @@index([holdId])
  @@index([extractedAt])
  @@map("lifecycle_hold_store")
}

/// Заявка на стирание субъекта (человек или организация): этапы, SLO, сертификат.
/// Публичный id — v4. Квитанция человеку — код, в базе только его sha256.
model LifecycleErasureRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType     String    @map("subject_type")
  subjectId       String    @map("subject_id") @db.Uuid
  /// Псевдоним субъекта (HMAC платформенного ключа) — журнал стираний без ПДн
  pseudonym       String
  /// scheduled | running | hot_purged | keys_destroyed | completed | cancelled | failed
  status          String    @default("scheduled")
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  effectiveAt     DateTime  @map("effective_at") @db.Timestamptz(3)
  hiddenAt        DateTime? @map("hidden_at") @db.Timestamptz(3)
  hotPurgedAt     DateTime? @map("hot_purged_at") @db.Timestamptz(3)
  keysDestroyedAt DateTime? @map("keys_destroyed_at") @db.Timestamptz(3)
  backupsClearAt  DateTime? @map("backups_clear_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  lastProgressAt  DateTime  @default(now()) @map("last_progress_at") @db.Timestamptz(3)
  attempts        Int       @default(0)
  errorCode       String?   @map("error_code")
  /// { eraseMessages: boolean }
  options         Json      @default("{}")
  receiptHash     String?   @unique @map("receipt_hash")
  /// Кому сообщить о завершении (владелец организации на момент архива) — только id
  notifyUserId    String?   @map("notify_user_id") @db.Uuid
  certificate     Json?
  signature       Bytes?
  kid             String?

  @@index([status, effectiveAt])
  @@index([subjectType, subjectId])
  // Раннер сроков: завершённые заявки (три статуса фильтра — порядок только по completed_at)
  @@index([completedAt])
  @@map("lifecycle_erasure_requests")
}

/// Журнал стираний (append-only): псевдоним, политики, счётчики, id ключей — без ПДн.
/// Выгружается в оба репозитория резервных копий и проигрывается после любого восстановления.
model LifecycleErasureJournal {
  id            BigInt    @id @default(autoincrement())
  requestId     String    @map("request_id") @db.Uuid
  pseudonym     String
  stage         String
  policyId      String?   @map("policy_id")
  policyVersion Int?      @map("policy_version")
  rows          Int       @default(0)
  keyIds        String[]  @default([]) @map("key_ids")
  at            DateTime  @default(now()) @db.Timestamptz(3)
  exportedAt    DateTime? @map("exported_at") @db.Timestamptz(3)

  @@index([requestId])
  @@index([at])
  @@map("lifecycle_erasure_journal")
}

/// Экспорт данных человека или организации: задание, манифест, части архива, скачивания.
model LifecycleExport {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectType   String    @map("subject_type")
  subjectId     String    @map("subject_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  /// queued | running | ready | failed | expired
  status        String    @default("queued")
  manifest      Json?
  parts         Json      @default("[]")
  bytes         BigInt    @default(0)
  downloads     Int       @default(0)
  maxDownloads  Int       @default(5) @map("max_downloads")
  errorCode     String?   @map("error_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt       DateTime? @map("ready_at") @db.Timestamptz(3)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  /// portable (человеку и организации) | restore (восстановление арендатора, только Кабинет)
  mode          String    @default("portable")
  /// Строк в архиве (известно после сборки)
  rows          Int?
  /// Ход сборки по фазам: { phase, policy, cursor, chunk, staged[], plan[], partsDone, … }
  progress      Json      @default("{}")
  /// Опции заявки (дев: injectForeign — подсадка чужой строки для стража владельца)
  options       Json      @default("{}")
  /// Момент данных источника (restore: время снимка кластера после PITR)
  snapshotAt    DateTime? @map("snapshot_at") @db.Timestamptz(3)
  /// Заходов сборки (снуз бюджета и ретраи) — дашборд видит зависшую сборку
  attempts      Int       @default(0)

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  // Частичные индексы lifecycle_exports_live_idx (status ∈ queued|running) и
  // lifecycle_exports_expires_idx (status = ready) — руками в миграции lifecycle_exports_build
  @@map("lifecycle_exports")
}

/// Учёт удалений строк без внешних ключей на них (GitLab loose FK): триггер родителя пишет,
/// воркер `lifecycle.loose-fk` добирает детей по рёбрам async_* реестра. RANGE по дню (сырой SQL).
model LifecycleDeletedRow {
  id          BigInt    @default(autoincrement())
  tableName   String    @map("table_name")
  rowId       String    @map("row_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  deletedAt   DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  /// Дети под заморозкой — строка учёта отложена до этого момента (воркер loose FK)
  retryAt     DateTime? @map("retry_at") @db.Timestamptz(3)

  @@id([id, deletedAt])
  @@index([tableName, processedAt])
  // Частичный индекс очереди воркера (миграция lifecycle_purge_runner, руками — Prisma его не выражает):
  //   lifecycle_deleted_rows_unprocessed_idx (deleted_at, id) WHERE processed_at IS NULL
  @@map("lifecycle_deleted_rows")
}

/// Прогон принуждения: purge политики, сброс/архив партиции, dry-run, удаление организации,
/// стирание, канарейка, loose FK — счётчики и отчёт (доказательство и дашборд).
model LifecycleRun {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  policyId      String?   @map("policy_id")
  kind          String
  /// running | done | stopped | failed
  status        String    @default("running")
  dryRun        Boolean   @default(false) @map("dry_run")
  subjectType   String?   @map("subject_type")
  subjectId     String?   @map("subject_id")
  rows          BigInt    @default(0)
  batches       Int       @default(0)
  expectedRows  BigInt?   @map("expected_rows")
  stoppedReason String?   @map("stopped_reason")
  report        Json?
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([policyId, startedAt(sort: Desc)])
  @@index([kind, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("lifecycle_runs")
}

/// Отчёты резервного копирования и учений (pgBackRest, авто-restore, PITR, DR): их присылают
/// скрипты эксплуатации подписанным запросом (`LIFECYCLE_OPS_TOKEN`).
model LifecycleBackupRun {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// full | incr | diff | verify | restore_drill | pitr_drill | dr_drill | wal | s3_replication
  kind       String
  repo       String
  /// ok | failed
  status     String
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  bytes      BigInt?
  details    Json      @default("{}")
  reportedAt DateTime  @default(now()) @map("reported_at") @db.Timestamptz(3)
  /// Метка прогона у источника (pgBackRest label, id учения): повтор отчёта не заводит вторую строку
  externalId String?   @map("external_id")

  @@unique([kind, repo, externalId])
  @@index([kind, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("lifecycle_backup_runs")
}

/// Суточный снимок размеров по таблицам (дашборд «Данные»: рост за 90 дней по классам, рост
/// таблицы за 7 дней, старейшая строка — отставание сроков). Пишет ночной крон движка (upsert
/// дня), удаляет раннер по сроку политики.
model LifecycleStorageDaily {
  day       DateTime  @db.Date
  tableName String    @map("table_name")
  policyId  String?   @map("policy_id")
  dataClass String    @map("data_class")
  bytes     BigInt
  rows      BigInt
  /// Старейшая строка по колонке срока (у ведомых раннером политик; null — не считалась)
  oldestAt  DateTime? @map("oldest_at") @db.Timestamptz(3)

  @@id([day, tableName])
  @@index([day, dataClass])
  @@map("lifecycle_storage_daily")
}

/// Пауза и срок политики хранения, заданные командой Кабинета (пара «пишет / одобряет»).
/// Раннер читает на каждом прогоне; строки нет — действует реестр. CHECK days > 0 — в миграции.
model LifecyclePolicyOverride {
  policyId    String   @id @map("policy_id")
  paused      Boolean  @default(false)
  days        Int?
  reason      String
  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@map("lifecycle_policy_overrides")
}

/// Правила партиционированного родителя для функций владельца `lifecycle_ensure_partition` /
/// `lifecycle_drop_partition`: пол срока и требование архива зашиты в БАЗУ, не в код приложения.
/// Пишет только миграция; роль приложения — SELECT.
model LifecyclePartitionSpec {
  /// schema.table
  parent             String   @id
  column             String   @map("column_name")
  /// day | month
  period             String
  floorDays          Int      @map("floor_days")
  requireArchive     Boolean  @default(false) @map("require_archive")
  aheadPeriods       Int      @default(3) @map("ahead_periods")
  insertScale        Float?   @map("insert_scale")
  lz4Columns         String[] @default([]) @map("lz4_columns")
  alwaysTriggers     String[] @default([]) @map("always_triggers")
  noTruncateFunction String?  @map("no_truncate_function")
  policyId           String   @map("policy_id")
  /// Класс данных политики — по нему заморозка класса держит сброс
  dataClass          String   @map("data_class")
  /// Политика hold-aware: живая заморозка держит сброс, пока строки не извлечены (`lifecycle_hold_extractions`)
  holdAware          Boolean  @default(false) @map("hold_aware")
  /// Очередь: лист с необработанной строкой (`processed_at IS NULL`) не сбрасывается
  requireProcessed   Boolean  @default(false) @map("require_processed")

  @@map("lifecycle_partition_specs")
}

/// Отметка «строки заморозки из партиции извлечены в `lifecycle_hold_store`»: без неё
/// функция владельца не сбросит партицию hold-aware политики, пока заморозка жива.
model LifecycleHoldExtraction {
  holdId      String   @map("hold_id") @db.Uuid
  /// schema.leaf
  partition   String
  rows        BigInt
  extractedAt DateTime @default(now()) @map("extracted_at") @db.Timestamptz(3)

  @@id([holdId, partition])
  @@index([extractedAt])
  @@map("lifecycle_hold_extractions")
}

/// Холодный ярус: партиция выгружена (NDJSON.gz + подписанный манифест) до сброса.
model LifecyclePartitionArchive {
  /// schema.leaf
  partition  String    @id
  parent     String
  fromAt     DateTime  @map("from_at") @db.Timestamptz(3)
  toAt       DateTime  @map("to_at") @db.Timestamptz(3)
  rows       BigInt
  bytes      BigInt
  sha256     String
  storageKey String    @map("storage_key")
  manifest   Json
  signature  Bytes
  kid        String
  archivedAt DateTime  @default(now()) @map("archived_at") @db.Timestamptz(3)
  droppedAt  DateTime? @map("dropped_at") @db.Timestamptz(3)

  @@map("lifecycle_partition_archives")
}
