# Database
DATABASE_URL="postgresql://superapp:superapp@localhost:5432/superapp6?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=3001
NODE_ENV=development
# Базовый адрес веб-приложения. Используется для редиректа после OAuth Google И как
# PostMessageOrigin движка документов: редактор в iframe шлёт хосту события
# («документ загружен», «закрыть») только на ЭТОТ origin. Пусто → откат на
# http://localhost:3000 — верно в разработке и неверно в проде, где мост postMessage
# молча перестанет работать (кнопка «Сохранить версию» останется выключенной).
WEB_URL="http://localhost:3000"

# Google Calendar (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"

# File Storage (S3-compatible; пусто → FILES_DRIVER=local)
S3_ENDPOINT=""
S3_BUCKET="superapp6"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# Голосовой движок (core/voice) — STT. Пусто → расшифровка выключена (движок инертен).
# Self-host: docker compose --profile voice up -d → VOICE_STT_URL=http://localhost:9000
# Облако тем же адаптером: VOICE_STT_URL=https://api.openai.com + VOICE_STT_API_KEY
VOICE_STT_URL=""
VOICE_STT_API_KEY=""
# Модель по умолчанию (whisper-server игнорирует и берёт свою из WHISPER_MODEL)
VOICE_STT_MODEL=""
# Отдельная модель для казахского (слот под дообученную whisper-turbo-ksc2)
VOICE_STT_MODEL_KK=""
# true → mock-драйвер без сети (CI/verify)
VOICE_STT_MOCK=""

# Движок звонков (core/calls) — LiveKit SFU. Пусто → звонки выключены (движок инертен).
# Self-host: docker compose --profile calls up -d → значения ниже
# (секрет = LIVEKIT_DEV_SECRET из docker-compose, ≥32 символов; смени в проде!)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# ws-адрес для браузера (пусто → выводится из LIVEKIT_URL заменой http→ws)
LIVEKIT_WS_URL=""
# Запись звонков (кнопка ⏺): хост-каталог, куда egress-контейнер кладёт готовые файлы
# (= bind-mount ./apps/api/storage/egress в docker-compose). Пусто → запись выключена.
# ВАЖНО: задаётся ТОЛЬКО вместе с LIVEKIT_* (валидатор запрещает egress без LiveKit),
# иначе `cp .env.example .env` уронит бут. Включаешь запись → раскомментируй значение ниже.
LIVEKIT_EGRESS_DIR=""
# LIVEKIT_EGRESS_DIR="./storage/egress"

# --- Движок документов (core/docs) — WOPI-редактор (Collabora) ---
# Пусто → документы выключены (кнопок «Открыть/Редактировать» в вебе нет).
# Дев-контейнер: docker compose --profile docs up -d → http://localhost:9980
# Можно перечислить несколько узлов через запятую — это белый список, из которого
# адрес выбирается ПО ДОКУМЕНТУ (задел под шардирование; в v1 узел один).
DOCS_EDITOR_URL=""
# Адрес НАШЕГО API, каким его видит КОНТЕЙНЕР редактора (WOPISrc резолвится изнутри
# контейнера, iframe — из браузера; в разработке это РАЗНЫЕ адреса).
# DOCS_WOPI_PUBLIC_URL="http://host.docker.internal:3001"
DOCS_WOPI_PUBLIC_URL=""
# Ключ подписи WOPI-токенов (≥32 символов). Пусто → выводится из JWT_SECRET.
DOCS_TOKEN_SECRET=""

# --- Движок подтверждений (core/verify) — SMS-OTP ---
# Драйвер SMS: kazinfoteh (боевой, покрывает всех операторов КЗ) | mock (dev: код в лог).
# Пусто = mock. В production без kazinfoteh коды никуда не уходят (громкий warn).
SMS_DRIVER=""
# Все три обязательны при SMS_DRIVER=kazinfoteh (у альфа-имени дефолта нет намеренно).
KIT_USERNAME=""
KIT_PASSWORD=""
KIT_ORIGINATOR=""
# Адрес шлюза; пусто = боевой https://kazinfoteh.org:9507/api
KIT_URL=""
# Обязательность SMS-подтверждения: пусто = secure-by-default (в production — да).
# true — форсить полный путь в dev; false — аварийный рубильник в production (warn).
VERIFY_REQUIRED=""
# Тест-карта для CI/verify-скриптов: SMS не шлётся, принимается фиксированный код
# VERIFY_TEST_PHONES="+77001234567:111111,+77012345678:111111"
VERIFY_TEST_PHONES=""
# В production тест-карта ИГНОРИРУЕТСЯ (фиксированный код = захват номера).
# Осознанный прод-смоук включается только этим флагом.
VERIFY_TEST_PHONES_ALLOW_PROD=""
# Глобальный стоп-кран SMS-бюджета, шт/час (дефолт 200)
VERIFY_SMS_HOURLY_BUDGET=""
# Домен для origin-bound строки в SMS («@domain #code» — 100% автозаполнение iOS/Android)
VERIFY_SMS_ORIGIN_DOMAIN=""

# --- Сеть ---
# Сколько прокси-хопов доверять при разборе X-Forwarded-For (за одним балансировщиком — "1";
# можно список подсетей). Пусто → XFF игнорируется, req.ip = адрес сокета. От этого зависят
# ВСЕ лимиты «по IP»: троттлер платформы и IP-эшелоны движка подтверждений.
TRUST_PROXY=""

# --- Движок электронной подписи (core/sign) ---
# Верификатор ЭЦП НУЦ РК. Пусто → mock: в разработке подпись принимается,
# в PRODUCTION — ОТВЕРГАЕТСЯ (принять непроверенную = выдать её за ЭЦП).
# Простая подпись по SMS (ПЭП) работает независимо от этой настройки.
# Сборка образа и рунбук — infra/sign-verifier/ (SDK НУЦ по заявке, не коммитится).
SIGN_VERIFY_DRIVER=""
NCANODE_URL=""
# Подписание через eGov Mobile (мост Smart Bridge, сервис NITEC-S-5096).
# Пусто → mock: QR рисуется, но ведёт на наш же одноразовый адрес.
# Точный JSON-протокол выдаётся при регистрации ИС в каталоге sb.egov.kz;
# весь его диалект изолирован в одном файле драйвера.
SIGN_QR_DRIVER=""
SMARTBRIDGE_URL=""
SMARTBRIDGE_CLIENT_ID=""
SMARTBRIDGE_CLIENT_SECRET=""
