# Database
DATABASE_URL="postgresql://superapp:superapp@localhost:5432/superapp6?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# --- Движок ключей (core/keys) — корень доверия, подпись токенов, шифрование ---
# Провайдер корня: software (файл с правами 0600) | pkcs11 (HSM/сертифицированная СКЗИ — слот).
KEYS_PROVIDER="software"
# Файл корневого ключа: церемония `node apps/api/scripts/keys-init-root.cjs` (две офлайн-копии
# у двух людей). В production ОБЯЗАТЕЛЕН; пусто в development → ./.keys/root.key создаётся при
# первом старте (громкий warn). Потеря файла = потеря всех зашифрованных данных.
KEYS_ROOT_KEY_FILE=""
# Окно ротации корня: файл СЛЕДУЮЩЕГО корня (церемония; сам не создаётся никогда). Пока задан,
# инстанс держит оба корня, команда кабинета `keys.root.rotate` перешивает версии порциями.
# После завершения — новый файл становится KEYS_ROOT_KEY_FILE, а эта переменная убирается.
KEYS_ROOT_KEY_FILE_NEXT=""
# Окно миграции с HS256: до этой даты (ISO) принимаются токены, подписанные прежним
# JWT_SECRET (теперь JWT_SECRET_LEGACY). В production при заданном legacy-секрете обязательна;
# истёкшее окно — отказ бута. Новые токены всегда EdDSA (ключи в keystore, JWKS).
KEYS_LEGACY_HS256_UNTIL=""
# Прежний мастер-секрет — ТОЛЬКО для проверки старых токенов на окне выше; пусто → HS256 выключен.
JWT_SECRET_LEGACY=""
# Режим чтения ПДн на окне dual-write: legacy (старые колонки) | encrypted (*_enc/*_bi); пусто → legacy.
KEYS_PII_READ_MODE=""
# Вебхуки на http://127.0.0.1 (только development/test — приёмник сьюта verify-webhooks.cjs)
WEBHOOKS_DEV_LOOPBACK=""
# Метрики Prometheus GET /metrics: токен скрейпера (≥16 символов). Задан → Bearer обязателен; пусто → в production 404, в dev открыт.
METRICS_TOKEN=""
# Отчёты бэкапов и учений восстановления POST /lifecycle/ops/backups/report (≥32 символов): Bearer + HMAC тела. Пусто → в production 404, в dev открыт.
LIFECYCLE_OPS_TOKEN=""
# Заделы pkcs11 (только при KEYS_PROVIDER=pkcs11).
KEYS_PKCS11_MODULE=""
KEYS_PKCS11_SLOT=""
KEYS_PKCS11_PIN=""
KEYS_PKCS11_KEY_LABEL=""
# Время жизни access/refresh-токенов (запись ms: 15m, 30d, "2 days"); пусто → 15m / 30d
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=3001
# Только development | test | production; пусто = production (fail-closed)
NODE_ENV=development
# Часовой пояс детерминированного форматирования дат (штампы подписи, производственный
# календарь КЭДО). IANA-зона; пусто → Asia/Almaty.
APP_TIMEZONE=""
# Базовый адрес веб-приложения. Используется для редиректа после OAuth Google И как
# PostMessageOrigin движка документов: редактор в iframe шлёт хосту события
# («документ загружен», «закрыть») только на ЭТОТ origin. Пусто → откат на
# http://localhost:3000 — верно в разработке и неверно в проде, где мост postMessage
# молча перестанет работать (кнопка «Сохранить версию» останется выключенной).
WEB_URL="http://localhost:3000"
# База абсолютных адресов НАШЕГО API (файловые ссылки, откат DOCS_WOPI_PUBLIC_URL,
# QR подписи, ссылки документов). Пусто → http://localhost:${PORT}.
API_PUBLIC_URL=""
# База ПУБЛИЧНЫХ адресов вебхуков процессов (…/api/processes/webhook/:token), которые
# дёргают внешние системы. Пусто → http://localhost:${PORT}; в проде = API_PUBLIC_URL.
API_URL=""

# Google Calendar (optional) — интеграция включена, только когда заданы ВСЕ три.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Тот же адрес — в консоли Google (канонический префикс /api/v1)
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/integrations/google/callback"
# Публичный HTTPS-адрес для push-уведомлений Google; пусто → поллинг (локальная разработка)
GOOGLE_WEBHOOK_URL=""

# --- Файловый движок (core/files) ---
# local (дефолт; байты на диске ОДНОГО инстанса — в production громкий warn) | s3
FILES_DRIVER="local"
# Корень локального хранилища относительно cwd процесса; пусто → ./storage
FILES_LOCAL_ROOT=""
# S3-совместимое хранилище (профиль s3 → SeaweedFS http://localhost:8333);
# все пять обязательны при FILES_DRIVER=s3
S3_ENDPOINT=""
S3_BUCKET="superapp6"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# Path-style адресация (true|false); пусто → true. false — только AWS с virtual-host
S3_FORCE_PATH_STYLE=""
# CDN/публичная база для public-файлов; пусто → выдача через API
S3_PUBLIC_BASE_URL=""
# Антивирус ClamAV: docker compose --profile scan up -d → CLAMAV_HOST=localhost.
# Пусто → скан выключен (scanStatus='none'). Порт: пусто → 3310.
CLAMAV_HOST=""
CLAMAV_PORT=""

# Голосовой движок (core/voice) — STT. Пусто → расшифровка выключена (движок инертен).
# Self-host: docker compose --profile voice up -d → VOICE_STT_URL=http://localhost:9000
# Облако тем же адаптером: VOICE_STT_URL=https://api.openai.com + VOICE_STT_API_KEY
VOICE_STT_URL=""
VOICE_STT_API_KEY=""
# Модель по умолчанию (whisper-server игнорирует и берёт свою из WHISPER_MODEL)
VOICE_STT_MODEL=""
# Отдельная модель для казахского (слот под дообученную whisper-turbo-ksc2)
VOICE_STT_MODEL_KK=""
# true → mock-драйвер без сети (CI/verify)
VOICE_STT_MOCK=""

# Движок звонков (core/calls) — LiveKit SFU. Пусто → звонки выключены (движок инертен).
# Self-host: docker compose --profile calls up -d → значения ниже
# (секрет = LIVEKIT_DEV_SECRET из docker-compose, ≥32 символов; смени в проде!)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# ws-адрес для браузера (пусто → выводится из LIVEKIT_URL заменой http→ws)
LIVEKIT_WS_URL=""
# Запись звонков (кнопка ⏺): хост-каталог, куда egress-контейнер кладёт готовые файлы
# (= bind-mount ./apps/api/storage/egress в docker-compose). Пусто → запись выключена.
# ВАЖНО: задаётся ТОЛЬКО вместе с LIVEKIT_* (валидатор запрещает egress без LiveKit),
# иначе `cp .env.example .env` уронит бут. Включаешь запись → раскомментируй значение ниже.
LIVEKIT_EGRESS_DIR=""
# LIVEKIT_EGRESS_DIR="./storage/egress"

# --- Движок документов (core/docs) — WOPI-редактор (Collabora) ---
# Пусто → документы выключены (кнопок «Открыть/Редактировать» в вебе нет).
# Дев-контейнер: docker compose --profile docs up -d → http://localhost:9980
# Можно перечислить несколько узлов через запятую — это белый список, из которого
# адрес выбирается ПО ДОКУМЕНТУ (задел под шардирование; в v1 узел один).
DOCS_EDITOR_URL=""
# Адрес НАШЕГО API, каким его видит КОНТЕЙНЕР редактора (WOPISrc резолвится изнутри
# контейнера, iframe — из браузера; в разработке это РАЗНЫЕ адреса).
# DOCS_WOPI_PUBLIC_URL="http://host.docker.internal:3001"
DOCS_WOPI_PUBLIC_URL=""
# УСТАРЕЛ: прежний HMAC-ключ WOPI-токенов, только проверка старых токенов на окне KEYS_LEGACY_HS256_UNTIL
# (новые подписывает движок ключей). После окна задан → бут падает.
DOCS_TOKEN_SECRET=""

# --- Движок гостевых ссылок (core/share-links) ---
# УСТАРЕЛ: прежний HMAC-ключ гостевых пропусков, только проверка старых на legacy-окне; после окна задан → бут падает.
# Адрес самой ссылки строится из WEB_URL (/s/<токен>).
SHARE_LINK_SECRET=""

# --- PDF-рендер блочного конструктора (core/templates) — Gotenberg ---
# Пусто → builder-документы не собираются (submit честно блокируется).
# Дев-контейнер: docker compose --profile pdf up -d → http://localhost:3030
GOTENBERG_URL=""

# --- Движок уведомлений (core/notifications): web push (VAPID) ---
# Пара генерируется один раз: `npx web-push generate-vapid-keys`. Пусто → push выключен
# (тумблер «уведомления браузера» скрыт, доставки `skipped: driver_not_configured`).
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
# Контакт для push-служб: mailto:… или https://…
WEB_PUSH_SUBJECT=""

# --- Движок подтверждений (core/verify) — SMS-OTP ---
# Драйвер SMS: kazinfoteh (боевой, покрывает всех операторов КЗ) | mock (dev: код в лог).
# Пусто = mock. В production без kazinfoteh коды никуда не уходят (громкий warn).
SMS_DRIVER=""
# Все три обязательны при SMS_DRIVER=kazinfoteh (у альфа-имени дефолта нет намеренно).
KIT_USERNAME=""
KIT_PASSWORD=""
KIT_ORIGINATOR=""
# Адрес шлюза; пусто = боевой https://kazinfoteh.org:9507/api
KIT_URL=""
# Обязательность SMS-подтверждения: пусто = secure-by-default (в production — да).
# true — форсить полный путь в dev; false — аварийный рубильник в production (warn).
VERIFY_REQUIRED=""
# core/consents: обязателен ли ЯВНЫЙ пакет согласий при создании организации. Пусто = secure-by-default
# (production → да; вне production сервер принимает действующие версии сам). Регистрация требует согласий всегда.
CONSENTS_REQUIRED=""
# Тест-карта для CI/verify-скриптов: SMS не шлётся, принимается фиксированный код
# VERIFY_TEST_PHONES="+77001234567:111111,+77012345678:111111"
VERIFY_TEST_PHONES=""
# В production тест-карта ИГНОРИРУЕТСЯ (фиксированный код = захват номера).
# Осознанный прод-смоук включается только этим флагом.
VERIFY_TEST_PHONES_ALLOW_PROD=""
# Глобальный стоп-кран SMS-бюджета, шт/час (дефолт 200)
VERIFY_SMS_HOURLY_BUDGET=""
# Домен для origin-bound строки в SMS («@domain #code» — 100% автозаполнение iOS/Android)
VERIFY_SMS_ORIGIN_DOMAIN=""

# --- Кабинет платформы (core/platform) ---
# УСТАРЕЛ: прежний HS256-секрет токена кабинета — только проверка токенов, выданных до движка ключей,
# на legacy-окне; новые токены кабинета подписывает своя пара Ed25519. После окна задан → бут падает.
PLATFORM_JWT_SECRET=
# Стоп-кран: false → все /platform/* отвечают 404 без деплоя кода (пусто/true — кабинет включён).
PLATFORM_CONSOLE_ENABLED=

# --- Продуктовая аналитика (core/analytics) ---
# Стоп-кран движка (пусто/true — включён) и консьюмер приёма на этом инстансе.
ANALYTICS_ENABLED=
ANALYTICS_CONSUMER_ENABLED=
# Ретенция сырья, дней (пусто → 400 ≈ 13 месяцев); роллапы вечны.
ANALYTICS_RAW_RETENTION_DAYS=
# Потолок stream'а приёма (пусто → 2000000).
ANALYTICS_STREAM_MAXLEN=
# Порог k-анонимности разбиений (пусто → 20).
ANALYTICS_K_ANON=
# Номера внутренних и тестовых аккаунтов — префиксы через запятую (события помечаются is_internal).
ANALYTICS_INTERNAL_PHONE_PREFIXES="+7700999,+770012,+770123,+770234"
# Реплика или роль analytics_reader для отчётов Кабинета (пусто → основной пул).
ANALYTICS_READ_DATABASE_URL=
# statement_timeout запросов по сырью, мс (пусто → 5000).
ANALYTICS_QUERY_TIMEOUT_MS=

# --- Сеть ---
# Сколько прокси-хопов доверять при разборе X-Forwarded-For (за одним балансировщиком — "1";
# можно список подсетей). Пусто → XFF игнорируется, req.ip = адрес сокета. От этого зависят
# ВСЕ лимиты «по IP»: троттлер платформы и IP-эшелоны движка подтверждений.
TRUST_PROXY=""
# Гео-заголовок страны, который ставит край сети и ЗАТИРАЕТ у клиента (за Cloudflare — cf-ipcountry).
# Страна журнала безопасности и «вход из новой страны» — только из него. Пусто → страны нет.
GEO_COUNTRY_HEADER=""

# --- Движок электронной подписи (core/sign) ---
# Верификатор ЭЦП НУЦ РК. Пусто → mock: в разработке подпись принимается,
# в PRODUCTION — ОТВЕРГАЕТСЯ (принять непроверенную = выдать её за ЭЦП).
# Простая подпись по SMS (ПЭП) работает независимо от этой настройки.
# Сборка образа и рунбук — infra/sign-verifier/ (SDK НУЦ по заявке, не коммитится).
SIGN_VERIFY_DRIVER=""
NCANODE_URL=""
# Подписание через eGov Mobile (мост Smart Bridge, сервис NITEC-S-5096).
# Пусто → mock: QR рисуется, но ведёт на наш же одноразовый адрес.
# Точный JSON-протокол выдаётся при регистрации ИС в каталоге sb.egov.kz;
# весь его диалект изолирован в одном файле драйвера.
SIGN_QR_DRIVER=""
SMARTBRIDGE_URL=""
SMARTBRIDGE_CLIENT_ID=""
SMARTBRIDGE_CLIENT_SECRET=""

# --- Движок идемпотентности повторов (core/idempotency) ---
# Режим: enforce (по умолчанию) | observe (окно выката: заявки заводятся и считаются
# метрики, отказов нет) | off (полный стоп-кран). Пусто → enforce.
IDEMPOTENCY_MODE=""
# Сколько дней живёт заявка на ключ (окно защиты от повтора). Пусто → 7.
IDEMPOTENCY_KEY_TTL_DAYS=""
# Сколько часов живёт СНИМОК тела ответа (окно реплея с телом). Пусто → 72.
IDEMPOTENCY_RESPONSE_TTL_HOURS=""
# Аренда исполнения, мс: дольше — и упавший процесс держит ключ зря. Пусто → 30000.
IDEMPOTENCY_LEASE_MS=""
# Потолок снимаемого тела, байт: больше — реплей отдаёт already_completed без тела. Пусто → 65536.
IDEMPOTENCY_MAX_RESPONSE_BYTES=""
# Метка сборки в строке заявки: помогает понять, в какой форме DTO лежит снимок
# (контракт меняется аддитивно, но 72 часа снимок живёт). Пусто → "dev".
APP_BUILD=""

# --- Журнал безопасности (core/audit) ---
# Интервал подписанных дайджестов целостности, минут (1…60). Пусто → 5.
AUDIT_DIGEST_INTERVAL_MIN=""
# Срок хранения месяца в PostgreSQL, лет (3…25; ниже 3 не даст и функция сброса в БД). Пусто → 3.
AUDIT_RETENTION_YEARS=""
# Выгрузка закрытых месяцев в хранилище (NDJSON+gzip + подписанный манифест). Пусто → включено;
# false — аварийный стоп (месяц без архива не сбрасывается никогда).
AUDIT_ARCHIVE_ENABLED=""
