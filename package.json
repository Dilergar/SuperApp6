{
  "name": "superapp6",
  "version": "0.1.0",
  "private": true,
  "description": "SuperApp6 — one app, one account, everything you need",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:guard": "turbo lint:guard",
    "check:docs": "node scripts/check-docs.cjs",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:analytics": "node scripts/check-analytics.cjs",
    "check:audit": "node scripts/check-audit.cjs",
    "check:visibility": "node scripts/check-visibility.cjs",
    "check:lifecycle": "node scripts/check-lifecycle.cjs",
    "check:migrations": "node scripts/check-migrations.cjs",
    "i18n:gen": "pnpm --filter @superapp/i18n gen",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "multer": "2.4.0",
      "socket.io-parser": "4.2.7",
      "ws@>=8.0.0 <8.21.3": "8.21.3",
      "engine.io@>=6.0.0 <6.6.11": "6.6.11",
      "lodash@<4.18.1": "4.18.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@<8.5.28": "8.5.28",
      "sharp@<0.35.4": "0.35.4",
      "qs@<6.16.0": "6.16.0",
      "body-parser@<1.20.8": "1.20.8",
      "@tiptap/core@<3.31.3": "3.31.3",
      "@tiptap/pm@<3.31.3": "3.31.3",
      "@tiptap/react@<3.31.3": "3.31.3",
      "@tiptap/extensions@<3.31.3": "3.31.3",
      "@tiptap/extension-bold@<3.31.3": "3.31.3",
      "@tiptap/extension-bubble-menu@<3.31.3": "3.31.3",
      "@tiptap/extension-code@<3.31.3": "3.31.3",
      "@tiptap/extension-floating-menu@<3.31.3": "3.31.3",
      "@tiptap/extension-italic@<3.31.3": "3.31.3",
      "@tiptap/extension-strike@<3.31.3": "3.31.3",
      "@tiptap/extension-text@<3.31.3": "3.31.3",
      "@tiptap/extension-underline@<3.31.3": "3.31.3",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "deepmerge-ts@<8.0.0": "8.0.2"
    }
  }
}
