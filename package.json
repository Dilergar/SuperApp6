{
  "name": "superapp6",
  "version": "0.1.0",
  "private": true,
  "description": "SuperApp6 — one app, one account, everything you need",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:guard": "turbo lint:guard",
    "check:docs": "node scripts/check-docs.cjs",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:analytics": "node scripts/check-analytics.cjs",
    "i18n:gen": "pnpm --filter @superapp/i18n gen",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3"
    }
  }
}
