node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.expo/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing
coverage/

# Files engine — локальное хранилище байтов (FILES_DRIVER=local)
apps/api/storage/

# Prisma
apps/api/prisma/*.db
# Миграции ТРЕКАЕМ — нужны для воспроизведения БД на свежем клоне (prisma migrate deploy)

# Mobile
*.apk
*.ipa
*.keystore

# Claude local settings (personal, not for team)
.claude/settings.local.json

# MCP config — contains tokens, never commit
.mcp.json

# Личная шпаргалка с паролями — не коммитить
acc.txt

# Верификатор подписи (core/sign): SDK KalkanCrypt и корни НУЦ РК.
# Лицензия НУЦ разрешает использование, но НЕ перераспространение бинарников —
# в репозитории лежит рецепт сборки (infra/sign-verifier/), а не чужие артефакты.
infra/sign-verifier/vendor/
infra/sign-verifier/roots/

# graphify: генерируемые артефакты графа (внутри venv и кэши) — не коммитятся
graphify-out/

# Keys engine — файл корневого ключа разработки (core/keys, KEYS_ROOT_KEY_FILE по умолчанию)
.keys/
apps/api/.keys/

# Учредительные и регистрационные документы юрлица (ФИО учредителя, БИН, адрес) —
# персональные данные, в историю git не попадают НИКОГДА. Реквизиты для текстов
# согласий живут в коде/сидах, а сами сканы и справки — вне репозитория.
Справка о государственной регистрации*.pdf
/*.pdf
