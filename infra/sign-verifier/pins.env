# Единственный источник правды о том, ИЗ ЧЕГО собран наш верификатор подписи.
# Любая правка здесь = смена того, что поедет в прод → отдельный просматриваемый коммит.
#
# Тот же приём, что у сборки редактора документов (infra/docs-editor/pins.env):
# пинимся не на «последнюю версию», а на конкретный коммит и на СОДЕРЖИМОЕ
# внешних артефактов. Верификатор подписи — не то место, где допустимо
# «пересобрали без изменений, а поведение поехало».

# --- NCANode (обвязка над SDK, MIT) ---
NCANODE_REPO=https://github.com/malikzh/NCANode
NCANODE_REF=master
# Заполнить конкретным коммитом при первой сборке (git rev-parse HEAD в чекауте).
NCANODE_COMMIT=

# --- SDK KalkanCrypt (НУЦ РК) ---
# Архив кладётся руками в infra/sign-verifier/vendor/ и в git НЕ попадает:
# лицензия разрешает использование, но не перераспространение бинарников.
# SHA256 фиксируем, чтобы «тот же файл» действительно означал тот же файл.
KALKAN_ARCHIVE=vendor/kalkancrypt.zip
KALKAN_SHA256=

# --- Корневые сертификаты НУЦ РК (pki.gov.kz) ---
# Три семейства алгоритмов сразу: ГОСТ 34.310-2004, ГОСТ-2015, RSA.
# Старые сертификаты доживают срок, и отказ от них = «ваш ключ не подходит»
# у половины страны.
ROOTS_DIR=roots

# --- Контур PKI ---
# test — тестовые OCSP/TSP (test.pki.gov.kz), на них связка проверяется ДО
# боевых ключей. production — боевой.
PKI_ENV=test
