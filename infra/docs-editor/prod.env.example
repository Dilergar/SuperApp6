# Переменные окружения редактора документов В ПРОДЕ.
#
# Конфигурация идёт именно переменными, а не файлом: ENTRYPOINT образа несёт
# --use-env-vars, и coolwsd сам читает всё нижеперечисленное (проверено по
# wsd/COOLWSD.cpp). Отдельный coolwsd.xml заводить не понадобилось — extra_params
# принимает ЛЮБОЙ --o:, то есть доступна вся схема конфига.
#
# Копировать в секреты хостинга, а НЕ в репозиторий: здесь пример, реальные значения
# (пароль админ-консоли) — только в секретах.

# --- Кому редактор доверяет как WOPI-хосту ---
# Регэксп с ЭКРАНИРОВАННЫМИ точками. Обязан совпадать с DOCS_WOPI_PUBLIC_URL нашего
# API — это две половины одной настройки. Хоста нет в списке → CheckFileInfo отклонён,
# и получается классическое «WOPI::CheckFileInfo failed».
aliasgroup1=https://api\.example\.kz

# --- TLS ---
# ssl.enable=false + ssl.termination=TRUE — именно эта пара верна за реальным
# https-прокси, и она ПРОТИВОПОЛОЖНА dev-настройке. Перепутать легко, а симптом
# неочевиден: с termination=false за прокси редактор раздаёт в discovery http-адреса
# и строит ws:// вместо wss://, и браузер режет их как mixed content.
#
# server_name обязателен: без него адреса в discovery и адрес websocket выводятся
# из заголовка Host, и за некоторыми прокси это даёт неверный адрес.
#
extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:welcome.enable=false --o:feedback.show=false --o:num_prespawn_children=4 --o:memproportion=80
server_name=docs.example.kz:443
DONT_GEN_SSL_CERT=true

# Кому разрешено встраивать редактор в iframe. Если не задать, браузер заблокирует
# фрейм — и получится ПУСТОЙ iframe при полностью зелёном healthcheck и рабочем
# discovery. Худший вид отказа: все серверные проверки проходят, а пользователь
# видит белый прямоугольник.
# Читается coolwsd напрямую как переменная окружения. Старый ключ net.frame_ancestors
# в конфиге помечен OBSOLETE — использовать именно content_security_policy.
content_security_policy=frame-ancestors https://app.example.kz;

# --- Админ-консоль ---
# Включать МОЖНО, но закрывать на прокси: открытая консоль показывает содержимое
# документов. Пустые значения = консоль недоступна вовсе (так и оставить, пока
# нет реальной нужды).
username=
password=

# ─────────────────────────────────────────────────────────────────────────────
# Что НЕ настраивается здесь, но обязано быть сделано на прокси
# ─────────────────────────────────────────────────────────────────────────────
# * websocket-upgrade на /cool/
# * длинный proxy_read_timeout: сессии правки живут часами, дефолтные 60 секунд
#   рвут соединение посреди работы
# * проброс /hosting/, /browser/, /cool/
# * /browser/dist/admin/ закрыт наружу
#
# ─────────────────────────────────────────────────────────────────────────────
# Сайзинг под ~50 одновременно правящих (числа Collabora)
# ─────────────────────────────────────────────────────────────────────────────
# CPU   : 10 пользователей на поток → 5 минимум, берём 6–8 vCPU
# RAM   : 1 ГБ база + 50 × 50 МБ = 3.5 ГБ → берём 8 ГБ с запасом
# Диск  : /tmp ≈ 4 × RAM → 16–32 ГБ быстрого ЛОКАЛЬНОГО диска.
#         Именно диск, не tmpfs: tmpfs съел бы ту самую память, которую мы только что
#         посчитали.
# Сеть  : ~100 кбит/с на пользователя → ~5 Мбит/с устойчиво
#
# Ручки на будущее (когда упрёмся): num_prespawn_children, max_concurrency (4 потока
# на документ по умолчанию), memproportion, limit_virt_mem_mb, idle_timeout_secs.
