# Единственный источник правды о том, ИЗ ЧЕГО собран наш редактор документов.
# Любая правка здесь = смена того, что поедет в прод → отдельный просматриваемый коммит.
#
# Оба внешних входа — движущиеся мишени, поэтому пинимся не на имена, а на содержимое:
#   * ветка co-26.04 — голова едет  → пиним КОММИТ;
#   * ассет движка перезаливают по ТОМУ ЖЕ URL (проверено: обновлялся 25.07.2026)
#     → пиним SHA256. Без этого «пересборка без изменений» тихо подменила бы
#     версию LibreOffice под нами.

# --- Исходники Collabora Online ---
ONLINE_REPO=https://gerrit.collaboraoffice.com/online
ONLINE_BRANCH=distro/collabora/co-26.04
ONLINE_COMMIT=52df04ea84a2fea550558e02a54ec5d89a05c080

# --- Готовый движок (LibreOffice), чтобы не собирать его часами ---
# Ассет от main (26.04.3.0); наша ветка 26.04.2.4 — та же линия 26.04.
# Бинарники берутся отсюда, а заголовки LOKit — из чекаута ветки. Если ABI
# когда-нибудь разойдётся, это вылезет на линковке online за минуты; запасной
# ход — очистить ENGINE_ASSETS_URL, тогда build.sh соберёт движок из исходников
# ТОЙ ЖЕ ветки (дольше на часы, зато гарантированно согласованно).
ENGINE_ASSETS_URL=https://github.com/CollaboraOnline/online/releases/download/for-code-assets/engine-main-assets.tar.gz
# Заполняется при первом скачивании (trust-on-first-use), дальше проверяется жёстко.
# Снято 26.07.2026 с engine-main-assets.tar.gz (433 368 863 байта).
ENGINE_ASSETS_SHA256=f13245de27f158b09382154baf3c2fe1dd6d0a1bb035b9c84c42f9537ff4a6fb

# --- Наши образы ---
# BASE_TAG меняется вместе с ONLINE_COMMIT; BRAND_REV — при каждой правке оверлея
# бренда (пересборка brand-слоя стоит секунды, base — нет).
IMAGE_BASE=superapp6/docs-editor-base
IMAGE_BRAND=superapp6/docs-editor
BASE_TAG=26.04-52df04e
BRAND_REV=1

# Приватный реестр. ВНИМАНИЕ: пакет обязан остаться ПРИВАТНЫМ — публикация образа
# это распространение исполняемой формы, и тогда MPL §3.2 требует отдавать исходники
# всех изменённых файлов Collabora. Подробности — LICENSING.md.
REGISTRY=ghcr.io/old-senpai
