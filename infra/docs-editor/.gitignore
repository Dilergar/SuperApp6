# Сборочное дерево upstream. В штатном пути его здесь не бывает — сборка идёт
# в docker-томе, — но build.sh кладёт builddir/ и instdir/ РЯДОМ с собой, и если
# кто-то запустит его напрямую на хосте, десятки гигабайт окажутся в репозитории.
# Корневой .gitignore эти имена не ловит: он знает build/, dist/ и out/, но не builddir/.
builddir/
instdir/
start-collabora-online.sh

# Скачанный движок LibreOffice (~440 МБ). Живёт в томе, но подстрахуемся.
*.tar.gz
*.tar.xz
