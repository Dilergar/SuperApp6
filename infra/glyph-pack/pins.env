# Единственный источник правды о том, ИЗ ЧЕГО собран пак значков.
# Правка здесь = смена того, что поедет в прод → отдельный просматриваемый коммит.
# Все четыре входа — движущиеся мишени, поэтому пинимся на КОММИТ и ВЕРСИИ,
# а не на «main» и «latest»: иначе «пересборка без изменений» тихо подменила бы
# половину картинок под нами.

# --- Эмодзи-пак «Свои» (Microsoft Fluent Emoji, MIT) ---
# Берём ТОЛЬКО стиль Color (цветной вектор) и только базовый тон кожи.
FLUENT_REPO=https://github.com/microsoft/fluentui-emoji.git
FLUENT_COMMIT=62ecdc0d7ca5c6df32148c169556bc8d3782fca4

# --- Предметные иконки (Phosphor, MIT) ---
# Начертание Light — то же, что у интерфейсных иконок кита.
PHOSPHOR_PKG=@phosphor-icons/core@2.1.1

# --- Русские названия и синонимы эмодзи (emojibase, MIT; данные CLDR) ---
# Отсюда берётся поиск «машина» → 🚗. Без него вкладка эмодзи не ищется.
EMOJIBASE_PKG=emojibase-data@17.0.0

# --- Эмодзи-пак «Noto» (Google Noto Color Emoji, OFL-1.1) ---
# Шрифтом, а не картинками: одним и тем же файлом рисуются и выбранные значки,
# и эмодзи внутри текста сообщений.
#
# Берём ОФИЦИАЛЬНУЮ сборку COLRv1 (вектор) и жмём в woff2 сами — 1.88 МБ одним
# файлом. Готовый пакет @fontsource/noto-color-emoji НЕ ГОДИТСЯ: его нарезанные
# по unicode-range сабсеты в Chromium рисуют ПУСТОТУ (глиф в шрифте есть,
# поэтому браузер даже не откатывается на системный — экран эмодзи пустой),
# а его цельный файл — битмапная сборка на 5.5 МБ. Проверка одна: нарисовать
# эмодзи в canvas и посчитать закрашенные пиксели.
NOTO_REPO_COMMIT=8998f5dd683424a73e2314a8c1f1e359c19e8742
NOTO_TTF_PATH=fonts/Noto-COLRv1.ttf
NOTO_TTF_SHA256=0ae57fe58645638523ba35f388d93739d292539a9acb84df5700c81b1e1a28d2

# Кодировщик woff2 (Node/WASM — чтобы сборке не требовался Python с fonttools).
WOFF2_PKG=wawoff2@2.0.1

# --- Параметры растеризации Fluent ---
# 128px хватает всем нашим размерам (самый крупный круг — 56px при DPR 2),
# а весь пак остаётся ~4 МБ вместо 38 МБ исходных SVG с градиентами.
EMOJI_PX=128
EMOJI_WEBP_QUALITY=88
